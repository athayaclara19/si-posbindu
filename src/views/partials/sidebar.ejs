            <path d="m9 11 3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
        </svg>
        Validasi Skrining
      </a>
      <a href="/bidan/rekap" onclick="closeSidebar()" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-all <%= typeof active !== 'undefined' && active === 'rekap' ? 'bg-[#2563EB] text-white font-medium' : 'text-white/60 hover:bg-white/10 hover:text-white' %>">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0">
