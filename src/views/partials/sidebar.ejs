<% 
  const currentRole = (currentUser && currentUser.role) ? currentUser.role : 'kader';
%>

<!-- OVERLAY (mobile) -->
<div id="sidebarOverlay" class="fixed inset-0 bg-black/50 z-30 hidden lg:hidden" onclick="closeSidebar()"></div>

<!-- SIDEBAR -->
<aside id="mainSidebar" class="fixed lg:static inset-y-0 left-0 z-40 w-64 bg-[#1F2937] min-h-screen flex flex-col transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out">
  
  <!-- Logo -->
  <div class="flex items-center gap-3 px-6 py-5 border-b border-white/10">
    <div class="w-10 h-10 rounded-xl bg-[#2563EB] flex items-center justify-center text-white text-lg font-bold flex-shrink-0">
      <img src="/images/logo_puskesmas.png" alt="Logo Puskesmas" class="w-8 h-8 object-contain">
    </div>
    <div class="min-w-0">
      <p class="text-white text-sm font-semibold truncate">SI-Posbindu</p>
      <p class="text-white/50 text-xs truncate">Puskesmas IV Koto Agam</p>
    </div>
    <!-- Tombol tutup sidebar (mobile only) -->
    <button onclick="closeSidebar()" class="ml-auto lg:hidden text-white/50 hover:text-white p-1">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
  </div>

  <!-- User Info -->
  <div class="px-4 py-4">
    <div class="bg-[#2563EB]/20 rounded-xl px-3 py-2 border border-[#2563EB]/30">
      <% if (currentRole === 'bidan') { %>
        <p class="text-[#93C5FD] text-[11px] font-medium uppercase tracking-wider mb-0.5">Bidan Desa</p>
        <p class="text-white text-sm font-semibold truncate"><%= currentUser ? currentUser.nama : '-' %></p>
      <% } else if (currentRole === 'pj_ptm') { %>
        <p class="text-[#93C5FD] text-[11px] font-medium uppercase tracking-wider mb-0.5">PJ Program PTM</p>
        <p class="text-white text-sm font-semibold truncate"><%= currentUser ? currentUser.nama : '-' %></p>
      <% } else if (currentRole === 'kepala_puskesmas') { %>
        <p class="text-[#93C5FD] text-[11px] font-medium uppercase tracking-wider mb-0.5">Kepala Puskesmas</p>
        <p class="text-white text-sm font-semibold truncate"><%= currentUser ? currentUser.nama : '-' %></p>
      <% } else { %>
        <p class="text-[#93C5FD] text-[11px] font-medium uppercase tracking-wider mb-0.5">Kader Posbindu</p>
        <p class="text-white text-sm font-semibold truncate"><%= currentUser ? currentUser.nama : '-' %></p>
      <% } %>
    </div>
  </div>

