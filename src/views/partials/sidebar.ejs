      <a href="/bidan/validasi" onclick="closeSidebar()" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-all <%= typeof active !== 'undefined' && active === 'validasi' ? 'bg-[#2563EB] text-white font-medium' : 'text-white/60 hover:bg-white/10 hover:text-white' %>">
