<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grafik Kunjungan & Capaian - Kepala Puskesmas</title>
    <link rel="stylesheet" href="/css/output.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .font-poppins { font-family: 'Poppins', sans-serif; }
        .font-inter { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 font-inter antialiased text-slate-800">
    
    <div class="flex min-h-screen">
    <%- include('../partials/sidebar', { active: 'grafikkunjungan', role: 'kepala' }) %>

    <div class="flex-1 flex flex-col min-w-0 lg:ml-64">
        <%- include('../partials/header', { pageTitle: 'Grafik & Rekap Capaian', role: 'kepala' }) %>

        <main class="p-8 space-y-6 w-full">
            <div>
                <h2 class="text-[#1F2937] font-poppins font-semibold text-xl">Grafik Kunjungan & Capaian Program PTM</h2>
                <p class="text-[#6B7280] text-sm mt-1">Rekap tingkat eksekutif — semua data dari pasien terverifikasi</p>
            </div>

            <!-- GRAFIK KUNJUNGAN PASIEN (Activity 34) -->
            <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
                    <div>
                        <h3 class="text-[#1F2937] font-poppins font-semibold text-lg">Grafik Kunjungan Pasien per Bulan</h3>
                        <p class="text-[#6B7280] text-sm mt-0.5">Total pasien unik &amp; total kunjungan skrining per periode</p>
                    </div>
                    <div class="flex flex-wrap items-center gap-4 text-xs font-medium">
                        <div class="flex items-center gap-2"><div class="w-3 h-3 rounded-sm bg-[#3B82F6]"></div><span class="text-[#6B7280]">Total Pasien</span></div>
                        <div class="flex items-center gap-2"><div class="w-3 h-3 rounded-sm bg-[#10B981]"></div><span class="text-[#6B7280]">Total Skrining</span></div>
                        <div class="flex items-center gap-2"><div class="w-3 h-3 rounded-sm bg-[#EF4444]"></div><span class="text-[#6B7280]">Hipertensi</span></div>
                    </div>
                </div>
                <% if (grafikData.length === 0) { %>
                <div class="text-center py-16 text-gray-400 text-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-3 text-gray-300"><line x1="18" x2="18" y1="20" y2="10"/><line x1="12" x2="12" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="14"/></svg>
                    Belum ada data kunjungan yang tersedia
                </div>
                <% } else { %>
                <div class="w-full h-[300px]">
                    <canvas id="kunjunganChart"></canvas>
                </div>
                <% } %>
            </div>

            <!-- REKAP PER PERIODE — EXEC LEVEL (Activity 29) -->
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
                <div class="px-6 py-5 border-b border-gray-100">
                    <h3 class="text-[#1F2937] font-poppins font-semibold">Rekap Data Per Periode (Tingkat Eksekutif)</h3>
                    <p class="text-[#6B7280] text-xs mt-0.5">Rekapitulasi capaian program PTM per bulan — hanya data terverifikasi</p>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead>
                            <tr class="bg-[#F8FAFC] border-b border-gray-100">
                                <th class="text-left px-6 py-4 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Periode</th>
                                <th class="text-right px-6 py-4 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Total Pasien</th>
                                <th class="text-right px-6 py-4 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Total Skrining</th>
                                <th class="text-right px-6 py-4 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Hipertensi</th>
                                <th class="text-right px-6 py-4 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Terkendali</th>
                                <th class="text-right px-6 py-4 text-xs text-[#6B7280] uppercase tracking-wider font-medium">% Capaian</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-50">
                            <% if (rekapPeriode.length === 0) { %>
                            <tr><td colspan="6" class="text-center py-12 text-gray-400 text-sm">Belum ada data rekap</td></tr>
                            <% } %>
                            <% rekapPeriode.forEach(function(r) { %>
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4 text-sm text-[#1F2937] font-medium"><%= r.nama_bulan %> <%= r.periode_tahun %></td>
                                <td class="px-6 py-4 text-sm text-[#1F2937] text-right font-medium"><%= parseInt(r.total_pasien).toLocaleString('id-ID') %></td>
                                <td class="px-6 py-4 text-sm text-[#6B7280] text-right"><%= parseInt(r.total_skrining).toLocaleString('id-ID') %></td>
                                <td class="px-6 py-4 text-sm text-[#EF4444] text-right font-medium"><%= parseInt(r.hipertensi).toLocaleString('id-ID') %></td>
                                <td class="px-6 py-4 text-sm text-[#10B981] text-right font-medium"><%= parseInt(r.terkendali).toLocaleString('id-ID') %></td>
                                <td class="px-6 py-4 text-right">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold
                                        <%= parseFloat(r.persen_capaian) >= 60 ? 'bg-green-100 text-green-700' : parseFloat(r.persen_capaian) >= 40 ? 'bg-amber-100 text-amber-700' : 'bg-red-100 text-red-700' %>">
                                        <%= r.persen_capaian %>%
                                    </span>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- CAPAIAN PER NAGARI -->
            <% if (capaianNagari.length > 0) { %>
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
                <div class="px-6 py-5 border-b border-gray-100">
                    <h3 class="text-[#1F2937] font-poppins font-semibold">Capaian per Nagari (Kumulatif)</h3>
                </div>
                <div class="p-6">
                    <div class="space-y-3">
                        <% capaianNagari.forEach(function(n) { %>
                        <% const pct = n.total_pasien > 0 ? Math.round((n.terkendali / n.total_pasien) * 100) : 0; %>
                        <div class="flex items-center gap-4">
                            <div class="w-28 text-sm text-[#1F2937] font-medium truncate flex-shrink-0"><%= n.nama_nagari %></div>
                            <div class="flex-1 bg-gray-100 rounded-full h-2.5">
                                <div class="h-2.5 rounded-full <%= pct >= 60 ? 'bg-green-500' : pct >= 40 ? 'bg-amber-400' : 'bg-red-400' %>"
                                     style="width: <%= Math.min(pct, 100) %>%"></div>
                            </div>
                            <div class="w-28 text-xs text-[#6B7280] flex-shrink-0 text-right">
                                <%= n.terkendali %>/<%= n.total_pasien %> (<%= pct %>% terkendali)
                            </div>
                        </div>
                        <% }) %>
                    </div>
                </div>
            </div>
            <% } %>
        </main>
    </div>

    <% if (grafikData.length > 0) { %>
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        Chart.defaults.font.family = "'Inter', sans-serif";
        Chart.defaults.color = '#6B7280';

        const labels = [<% grafikData.forEach(function(d,i){ %>"<%= d.label %>"<%= i < grafikData.length-1 ? ',' : '' %><% }) %>];
        const dataPasien   = [<% grafikData.forEach(function(d,i){ %><%= d.total_pasien %><%= i < grafikData.length-1 ? ',' : '' %><% }) %>];
        const dataSkrining = [<% grafikData.forEach(function(d,i){ %><%= d.total_skrining %><%= i < grafikData.length-1 ? ',' : '' %><% }) %>];
        const dataHT       = [<% grafikData.forEach(function(d,i){ %><%= d.hipertensi %><%= i < grafikData.length-1 ? ',' : '' %><% }) %>];

        new Chart(document.getElementById('kunjunganChart').getContext('2d'), {
            type: 'bar',
            data: {
                labels,
                datasets: [
                    { label: 'Total Pasien', data: dataPasien, backgroundColor: '#3B82F6', borderRadius: 3, barPercentage: 0.5, categoryPercentage: 0.6 },
                    { label: 'Total Skrining', data: dataSkrining, backgroundColor: '#10B981', borderRadius: 3, barPercentage: 0.5, categoryPercentage: 0.6 },
                    { label: 'Hipertensi', data: dataHT, backgroundColor: '#EF4444', borderRadius: 3, barPercentage: 0.5, categoryPercentage: 0.6 }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: { backgroundColor: 'white', titleColor: '#1F2937', bodyColor: '#4B5563', borderColor: '#E5E7EB', borderWidth: 1, padding: 12 }
                },
                scales: {
                    x: { grid: { display: false } },
                    y: { grid: { color: '#F3F4F6' }, min: 0 }
                },
                interaction: { mode: 'index', intersect: false }
            }
        });
    });
    </script>
    <% } %>

<%- include('../partials/profil') %>

</div>
</body>
</html>
