<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rekap Wilayah - Bidan</title>
    <link rel="stylesheet" href="/css/output.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        .font-poppins { font-family: 'Poppins', sans-serif; }
        .font-inter { font-family: 'Inter', sans-serif; }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-slate-50 font-inter antialiased text-slate-800 flex h-screen overflow-hidden">
    
    <%- include('../partials/sidebar', { active: 'rekap', role: 'bidan' }) %>

    <div class="flex-1 flex flex-col h-screen overflow-y-auto relative">
        <%- include('../partials/header', { pageTitle: 'Rekap Wilayah', role: 'bidan' }) %>

        <main class="p-8 space-y-6 w-full">
            <div>
                <h2 class="text-[#1F2937] font-poppins font-semibold text-xl">
                    Rekap Wilayah
                </h2>
                <p class="text-[#6B7280] text-sm mt-1">Kecamatan IV Koto Agam · <%= new Date().toLocaleDateString('id-ID', { month: 'long', year: 'numeric' }) %></p>
            </div>

            <% 
                // Hitung persentase untuk Cards
                let totalCards = parseInt(cards.total_pasien) || 0;
                let hipCards = parseInt(cards.hipertensi) || 0;
                let terCards = parseInt(cards.terkendali) || 0;
                let persenHip = totalCards > 0 ? Math.round((hipCards / totalCards) * 100) : 0;
                let persenTer = totalCards > 0 ? Math.round((terCards / totalCards) * 100) : 0;
            %>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 flex flex-col justify-between">
                    <div class="flex justify-between items-start mb-4">
                        <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        </div>
                        <span class="px-2 py-1 bg-blue-50 text-blue-600 text-[10px] font-semibold rounded-md">Bulan Ini</span>
                    </div>
                    <div>
                        <p class="text-3xl font-poppins font-bold text-gray-800"><%= totalCards %></p>
                        <p class="text-gray-500 text-xs font-medium mt-1">Total Pasien Diperiksa</p>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 flex flex-col justify-between">
                    <div class="flex justify-between items-start mb-4">
                        <div class="w-10 h-10 rounded-xl bg-red-100 text-red-600 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                        </div>
                    </div>
                    <div>
                        <p class="text-3xl font-poppins font-bold text-gray-800"><%= hipCards %></p>
                        <p class="text-gray-500 text-xs font-medium mt-1">Kasus Hipertensi <span class="text-gray-400 font-normal ml-1"><%= persenHip %>% dari total</span></p>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 flex flex-col justify-between">
                    <div class="flex justify-between items-start mb-4">
                        <div class="w-10 h-10 rounded-xl bg-green-100 text-green-600 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                        </div>
                    </div>
                    <div>
                        <p class="text-3xl font-poppins font-bold text-gray-800"><%= persenTer %>%</p>
                        <p class="text-gray-500 text-xs font-medium mt-1">Tekanan Terkendali</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm">
                <h3 class="text-[#1F2937] font-poppins font-semibold mb-6">Tren Kunjungan (6 Bulan Terakhir)</h3>
                <div class="w-full h-[280px]">
                    <canvas id="trendChart"></canvas>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
                
                <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm h-fit">
                    <h3 class="text-[#1F2937] font-poppins font-semibold mb-6">Capaian per Jorong</h3>
                    <div class="w-full overflow-x-auto pb-4">
                        <div id="rekapChartContainer" style="height: 350px;">
                            <canvas id="jorongBarChart"></canvas>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden h-fit">
                    <div class="px-6 py-5 border-b border-gray-100">
                        <h3 class="text-[#1F2937] font-poppins font-semibold">Rekap Detail per Jorong</h3>
                    </div>
                    <div class="max-h-[400px] overflow-y-auto">
                        <table class="w-full relative">
                            <thead class="sticky top-0 bg-[#F8FAFC] z-10 shadow-sm">
                                <tr class="border-b border-gray-100">
                                    <th class="text-left px-5 py-3 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Jorong</th>
                                    <th class="text-center px-5 py-3 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Total</th>
                                    <th class="text-center px-5 py-3 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Hipertensi</th>
                                    <th class="text-center px-5 py-3 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Terkendali</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-50">
                                <% rekapJorong.forEach(j => { %>
                                    <% 
                                        let tot = parseInt(j.total) || 0;
                                        let hip = parseInt(j.hipertensi) || 0;
                                        let ter = parseInt(j.terkendali) || 0;
                                        let persentase = tot > 0 ? Math.round((ter / tot) * 100) : 0;
                                        
                                        // Styling warna persentase
                                        let warnaBg = persentase >= 70 ? 'bg-[#D1FAE5]' : (persentase >= 50 ? 'bg-[#FEF3C7]' : 'bg-[#FEE2E2]');
                                        let warnaText = persentase >= 70 ? 'text-[#059669]' : (persentase >= 50 ? 'text-[#D97706]' : 'text-[#EF4444]');
                                    %>
                                    <tr class="hover:bg-gray-50 transition-colors">
                                        <td class="px-5 py-3.5 text-sm text-[#1F2937] font-medium"><%= j.nama_jorong %></td>
                                        <td class="px-5 py-3.5 text-sm text-center text-[#6B7280]"><%= tot %></td>
                                        <td class="px-5 py-3.5 text-sm text-center text-[#EF4444] font-medium"><%= hip %></td>
                                        <td class="px-5 py-3.5 text-center">
                                            <span class="text-xs px-2.5 py-1 rounded-full <%= warnaBg %> <%= warnaText %> font-medium"><%= persentase %>%</span>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            Chart.defaults.font.family = "'Inter', sans-serif";
            Chart.defaults.color = '#6B7280';

            // Ambil data dari Backend EJS
            const trendData = <%- JSON.stringify(trendBulanan) %>;
            const jorongData = <%- JSON.stringify(rekapJorong) %>;

            // ==========================================
            // 1. CHART TREN BULANAN (LINE CHART)
            // ==========================================
            const trendLabels = trendData.map(t => t.bulan_label);
            const trendTotal = trendData.map(t => parseInt(t.total) || 0);
            const trendTerkendali = trendData.map(t => parseInt(t.terkendali) || 0);
            const trendHipertensi = trendData.map(t => parseInt(t.hipertensi) || 0);

            const ctxTrend = document.getElementById('trendChart').getContext('2d');
            new Chart(ctxTrend, {
                type: 'line',
                data: {
                    labels: trendLabels,
                    datasets: [
                        { label: 'Total Pasien', data: trendTotal, borderColor: '#2563EB', backgroundColor: '#2563EB', borderWidth: 2, tension: 0.3, pointRadius: 4, pointBackgroundColor: '#fff', pointBorderWidth: 2 },
                        { label: 'Terkendali', data: trendTerkendali, borderColor: '#10B981', backgroundColor: '#10B981', borderWidth: 2, tension: 0.3, pointRadius: 4, pointBackgroundColor: '#fff', pointBorderWidth: 2 },
                        { label: 'Hipertensi', data: trendHipertensi, borderColor: '#EF4444', backgroundColor: '#EF4444', borderWidth: 2, tension: 0.3, pointRadius: 4, pointBackgroundColor: '#fff', pointBorderWidth: 2 }
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 8, padding: 20 } }, tooltip: { backgroundColor: 'white', titleColor: '#1F2937', bodyColor: '#4B5563', borderColor: '#E5E7EB', borderWidth: 1, padding: 10, usePointStyle: true, titleFont: { family: "'Poppins', sans-serif" } } },
                    scales: { x: { grid: { display: false, drawBorder: false } }, y: { grid: { color: '#F3F4F6', drawBorder: false, strokeDash: [3, 3] }, min: 0 } },
                    interaction: { mode: 'index', intersect: false }
                }
            });

            // ==========================================
            // 2. CHART PASIEN PER JORONG (SCROLLABLE BAR)
            // ==========================================
            const jorongLabels = jorongData.map(j => j.nama_jorong);
            const jorongTotal = jorongData.map(j => parseInt(j.total) || 0);
            const jorongHipertensi = jorongData.map(j => parseInt(j.hipertensi) || 0);

            // Hitung lebar chart agar bisa di-scroll (Trik yang sama seperti di Dashboard)
            const hitungLebar = Math.max(600, jorongLabels.length * 80);
            document.getElementById('rekapChartContainer').style.minWidth = hitungLebar + 'px';

            const ctxJorong = document.getElementById('jorongBarChart').getContext('2d');
            new Chart(ctxJorong, {
                type: 'bar',
                data: {
                    labels: jorongLabels,
                    datasets: [
                        { label: 'Total', data: jorongTotal, backgroundColor: '#2563EB', borderRadius: { topLeft: 4, topRight: 4 }, barPercentage: 0.6, categoryPercentage: 0.8 },
                        { label: 'Hipertensi', data: jorongHipertensi, backgroundColor: '#EF4444', borderRadius: { topLeft: 4, topRight: 4 }, barPercentage: 0.6, categoryPercentage: 0.8 }
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 8, padding: 15 } }, tooltip: { backgroundColor: 'white', titleColor: '#1F2937', bodyColor: '#4B5563', borderColor: '#E5E7EB', borderWidth: 1, padding: 10, usePointStyle: true, titleFont: { family: "'Poppins', sans-serif" } } },
                    scales: { x: { grid: { display: false, drawBorder: false } }, y: { beginAtZero: true, grid: { color: '#F3F4F6', drawBorder: false, strokeDash: [3, 3] } } },
                    interaction: { mode: 'index', intersect: false }
                }
            });
        });
    </script>
</body>
</html>