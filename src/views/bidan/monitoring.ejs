<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Monitoring Hipertensi - Bidan</title>
    <link rel="stylesheet" href="/css/output.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .hidden-el { display: none !important; }
    </style>
</head>
<body class="bg-slate-50 font-inter text-slate-800">
    
    <div class="flex min-h-screen">
    <%- include('../partials/sidebar', { active: 'monitoring', role: 'bidan' }) %>

    <div class="flex-1 flex flex-col min-w-0 lg:ml-64">
        <%- include('../partials/header', { pageTitle: 'Laporan Pengendalian Penyakit HT', role: 'bidan' }) %>

        <main class="p-8 space-y-6 w-full">
            <%
                // Hitung statistik dari daftarPasien
                const totalPasienMon = daftarPasien ? daftarPasien.length : 0;
                const terkendaliMon = daftarPasien ? daftarPasien.filter(p => {
                    const s = parseInt(p.sistole_terakhir);
                    const d = parseInt(p.diastole_terakhir);
                    return !isNaN(s) && !isNaN(d) && s < 140 && d < 90;
                }).length : 0;
                const persenTerkendaliMon = totalPasienMon > 0 
                    ? ((terkendaliMon / totalPasienMon) * 100).toFixed(1) : '0.0';
                const tahunMon = new Date().getFullYear();
            %>
            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex flex-col md:flex-row justify-between gap-4">
                <div class="space-y-1">
                    <p class="text-xs text-gray-500 uppercase font-bold tracking-wider">Puskesmas</p>
                    <p class="text-sm font-semibold">Puskesmas IV Koto</p>
                    <p class="text-xs text-gray-500 uppercase font-bold tracking-wider pt-2">Tahun</p>
                    <p class="text-sm font-semibold"><%= tahunMon %></p>
                </div>
                <div class="space-y-1 md:text-right">
                    <p class="text-xs text-gray-500 uppercase font-bold tracking-wider">Jumlah Terkendali</p>
                    <p class="text-lg font-bold text-green-600"><%= terkendaliMon %> Pasien</p>
                    <p class="text-xs text-gray-500 uppercase font-bold tracking-wider pt-2">Persentase Terkendali</p>
                    <p class="text-lg font-bold text-blue-600"><%= persenTerkendaliMon %>%</p>
                </div>
            </div>

            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
                <div class="px-6 py-5 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
                    <h3 class="text-[#1F2937] font-poppins font-semibold">Riwayat Kontrol Individu</h3>
                    <div class="flex items-center gap-2">
                        <input type="text" id="cariPasien" placeholder="Cari nama pasien..." 
                               class="text-sm border border-gray-200 rounded-xl px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-400 w-48">
                    </div>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-white border-b border-gray-100 text-[11px] uppercase tracking-wider font-bold text-gray-500">
                                <th class="px-6 py-4">Nama / NIK</th>
                                <th class="px-6 py-4">Jorong</th>
                                <th class="px-6 py-4">Kunjungan Terakhir</th>
                                <th class="px-6 py-4 text-center">Tensi Terakhir</th>
                                <th class="px-6 py-4">Status</th>
                                <th class="px-6 py-4">Histori</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-50" id="tabelPasien">
                            <% if (daftarPasien && daftarPasien.length > 0) { %>
                                <% daftarPasien.forEach(function(p) { %>
                                <%
                                    const sistole = parseInt(p.sistole_terakhir);
                                    const diastole = parseInt(p.diastole_terakhir);
                                    let statusLabel = 'Belum ada data';
                                    let statusCls = 'bg-gray-100 text-gray-500';
                                    if (!isNaN(sistole) && !isNaN(diastole)) {
                                        if (sistole >= 180 || diastole >= 110) {
                                            statusLabel = 'Krisis';
                                            statusCls = 'bg-red-100 text-red-700';
                                        } else if (sistole >= 160 || diastole >= 100) {
                                            statusLabel = 'HT Tingkat 2';
                                            statusCls = 'bg-red-100 text-red-700';
                                        } else if (sistole >= 140 || diastole >= 90) {
                                            statusLabel = 'HT Tingkat 1';
                                            statusCls = 'bg-orange-100 text-orange-700';
                                        } else if (sistole >= 120) {
                                            statusLabel = 'Pra-Hipertensi';
                                            statusCls = 'bg-yellow-100 text-yellow-700';
                                        } else {
                                            statusLabel = 'Terkendali';
                                            statusCls = 'bg-green-100 text-green-700';
                                        }
                                    }
                                %>
                                <tr class="hover:bg-slate-50 transition-colors baris-pasien" data-nama="<%= p.nama_pasien.toLowerCase() %>">
                                    <td class="px-6 py-4">
                                        <p class="font-semibold text-sm text-[#1F2937]"><%= p.nama_pasien %></p>
                                        <p class="text-xs text-gray-500 font-mono mt-0.5"><%= p.nik %></p>
                                    </td>
                                    <td class="px-6 py-4 text-xs text-gray-600"><%= p.nama_jorong %></td>
                                    <td class="px-6 py-4 text-xs text-gray-600">
                                        <% if (p.kunjungan_terakhir) { %>
                                            <%= new Date(p.kunjungan_terakhir).toLocaleDateString('id-ID') %>
                                        <% } else { %>
                                            <span class="text-gray-400">Belum ada</span>
                                        <% } %>
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                        <% if (!isNaN(sistole) && !isNaN(diastole)) { %>
                                            <span class="font-bold text-sm <%= sistole >= 140 || diastole >= 90 ? 'text-red-600' : 'text-green-600' %>">
                                                <%= sistole %>/<%= diastole %>
                                            </span>
                                            <p class="text-xs text-gray-400">mmHg</p>
                                        <% } else { %>
                                            <span class="text-gray-400 text-xs">—</span>
                                        <% } %>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="px-2.5 py-1 rounded-full text-xs font-semibold <%= statusCls %>"><%= statusLabel %></span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <button onclick="bukaGrafikModal('<%= p.id_pasien %>', '<%= p.nama_pasien %>')" 
                                                class="flex items-center gap-1.5 px-3 py-1.5 bg-[#DBEAFE] text-[#2563EB] rounded-lg text-xs font-semibold hover:bg-[#BFDBFE] transition-colors">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                                            Lihat Grafik
                                        </button>
                                    </td>
                                </tr>
                                <% }); %>
                            <% } else { %>
                                <tr><td colspan="6" class="text-center py-12 text-gray-400">Belum ada data pasien</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div id="modal-grafik" class="hidden-el fixed inset-0 z-50 flex items-center justify-center p-4">
                <div class="absolute inset-0 bg-gray-900/40 backdrop-blur-sm" onclick="tutupGrafikModal()"></div>
                <div class="bg-white rounded-2xl w-full max-w-2xl p-6 shadow-2xl z-10 relative">
                    <div class="flex items-center justify-between mb-2">
                        <div>
                            <h3 class="text-[#1F2937] font-poppins font-semibold text-lg flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#2563EB]"><path d="M20.2 7.8l-7.7 7.7-4-4-5.7 5.7"/><path d="M15 7h6v6"/></svg>
                                Histori Tensi: <span id="nama-pasien-modal" class="text-[#2563EB]">ASMIARTI</span>
                            </h3>
                            <p class="text-[#6B7280] text-xs mt-1">Pemantauan 6 Kunjungan Terakhir</p>
                        </div>
                        <button onclick="tutupGrafikModal()" class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center text-gray-500 hover:bg-gray-200 hover:text-gray-700 transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        </button>
                    </div>

                    <div class="w-full h-[300px] mt-6 border-b border-gray-100 pb-4">
                        <canvas id="historiTensiChart"></canvas>
                    </div>

                    <div id="box-ringkasan" class="mt-4 bg-[#EFF6FF] border border-[#BFDBFE] rounded-xl p-4 flex gap-3">
                        <div id="icon-ringkasan" class="text-[#2563EB] mt-0.5">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
                        </div>
                        <div>
                            <p class="text-[#1E40AF] text-sm font-semibold">Ringkasan Data Pengukuran</p>
                            <p id="kesimpulan-pasien" class="text-[#1E40AF] text-xs mt-1 leading-relaxed">
                                Pilih pasien untuk melihat ringkasan data pengukurannya.
                            </p>
                        </div>
                    </div>

                </div>
            </div>

        </main>
    </div>

    <script>
        // ============================================================
        // [REVISI] FUNGSI BARU: hitungNarasiDeskriptif()
        // Menggantikan teksKesimpulan hardcoded yang berisi rekomendasi klinis.
        // Fungsi ini HANYA melakukan perhitungan matematis dan menghasilkan
        // kalimat deskriptif berbasis angka — sesuai arahan dosen bimbingan.
        //
        // Parameter:
        //   - arrSistole  : array nilai sistolik (angka), dari lama ke baru
        //   - arrDiastole : array nilai diastolik (angka), dari lama ke baru
        //
        // Return: string narasi deskriptif (tanpa rekomendasi klinis)
        // ============================================================
        function hitungNarasiDeskriptif(arrSistole, arrDiastole) {

            // -- Validasi: jika data kosong
            if (!arrSistole || arrSistole.length === 0) {
                return 'Data pengukuran belum tersedia.';
            }

            const jmlData       = arrSistole.length;

            // -- Nilai terbaru (index terakhir)
            const sistolikTerbaru  = arrSistole[jmlData - 1];
            const diastolikTerbaru = arrDiastole[jmlData - 1];

            // -- Hitung rata-rata sistolik (pembulatan 1 desimal)
            const totalSistole = arrSistole.reduce((sum, v) => sum + v, 0);
            const rataSistole  = (totalSistole / jmlData).toFixed(1);

            // -- Hitung rata-rata diastolik
            const totalDiastole = arrDiastole.reduce((sum, v) => sum + v, 0);
            const rataDiastole  = (totalDiastole / jmlData).toFixed(1);

            // -- [BARU] Hitung nilai sistolik tertinggi (Max) dan terendah (Min) dari seluruh riwayat
            const sistoleMaks = Math.max(...arrSistole); // [BARU] nilai maks dari keseluruhan array
            const sistoleMin  = Math.min(...arrSistole); // [BARU] nilai min dari keseluruhan array

            // -- [BARU] Deteksi fluktuasi: cek apakah ada kenaikan DAN penurunan dalam riwayat
            // Fluktuatif = pernah naik dan pernah turun (bukan hanya satu arah saja)
            let adaKenaikan  = false; // [BARU]
            let adaPenurunan = false; // [BARU]
            if (jmlData >= 3) { // [BARU] minimal 3 titik data agar pola naik-turun bisa terdeteksi
                for (let i = 1; i < jmlData; i++) { // [BARU] bandingkan tiap elemen dengan elemen sebelumnya
                    if (arrSistole[i] > arrSistole[i - 1]) adaKenaikan  = true; // [BARU]
                    if (arrSistole[i] < arrSistole[i - 1]) adaPenurunan = true; // [BARU]
                }
            }
            const adalahFluktuatif = adaKenaikan && adaPenurunan; // [BARU] true jika kedua arah terdeteksi

            // -- [DIUBAH] Tren sistolik: bandingkan nilai terbaru vs sebelumnya
            // Menggunakan bahasa formal yang mudah dipahami bidan maupun pasien
            let narasiTren = '';
            if (jmlData >= 2) {
                const sistolikSebelumnya = arrSistole[jmlData - 2];
                const selisih = sistolikTerbaru - sistolikSebelumnya;

                if (selisih > 5) {
                    // [DIUBAH] Bahasa mudah dipahami: menyebut angka konkret
                    narasiTren = `Dibandingkan kontrol sebelumnya (${sistolikSebelumnya} mmHg), tekanan sistolik naik ${selisih} mmHg menjadi ${sistolikTerbaru} mmHg.`;
                } else if (selisih < -5) {
                    // [DIUBAH] Bahasa mudah dipahami: menyebut angka konkret
                    narasiTren = `Dibandingkan kontrol sebelumnya (${sistolikSebelumnya} mmHg), tekanan sistolik turun ${Math.abs(selisih)} mmHg menjadi ${sistolikTerbaru} mmHg.`;
                } else {
                    // [DIUBAH] Bahasa mudah dipahami: tidak ada perubahan berarti
                    narasiTren = `Tekanan sistolik tidak banyak berubah dari kontrol sebelumnya (${sistolikSebelumnya} mmHg → ${sistolikTerbaru} mmHg).`;
                }
            }

            // -- Tentukan kategori berdasarkan standar Kemenkes 2024
            // (Klasifikasi ini dipertahankan karena berbasis dokumen resmi)
            // [DIUBAH] Label kategori dibuat lebih mudah dibaca
            let kategori = '';
            if (sistolikTerbaru >= 180)      kategori = 'Krisis Hipertensi (≥180 mmHg)';
            else if (sistolikTerbaru >= 160) kategori = 'Hipertensi Tingkat 2 (160–179 mmHg)';
            else if (sistolikTerbaru >= 140) kategori = 'Hipertensi Tingkat 1 (140–159 mmHg)';
            else if (sistolikTerbaru >= 120) kategori = 'Pra-Hipertensi (120–139 mmHg)';
            else                             kategori = 'Normal (di bawah 120 mmHg)';

            // -- [DIUBAH] Susun narasi akhir dengan bahasa formal yang mudah dipahami
            // Kalimat pembuka menyebutkan hasil terbaru + kategori secara langsung.
            // Ringkasan riwayat disesuaikan: fluktuatif atau tidak.
            const kalimatTerbaru = // [DIUBAH] kalimat pertama: hasil ukur terbaru
                `Hasil pengukuran terakhir menunjukkan tekanan darah ${sistolikTerbaru}/${diastolikTerbaru} mmHg, ` +
                `yang termasuk dalam kategori ${kategori}.`;

            const narasiRingkasanRiwayat = adalahFluktuatif
                ? // [DIUBAH] narasi fluktuatif: bahasa lebih natural
                  `Selama ${jmlData} kali kontrol, tekanan darah pasien mengalami naik-turun. ` +
                  `Nilai tertinggi yang pernah tercatat adalah ${sistoleMaks} mmHg dan nilai terendahnya ${sistoleMin} mmHg. ` +
                  `Rata-rata tekanan sistolik secara keseluruhan adalah ${rataSistole} mmHg.`
                : // [DIUBAH] narasi tidak fluktuatif: langsung ke angka rata-rata
                  `Berdasarkan ${jmlData} kali kontrol, rata-rata tekanan sistolik pasien adalah ${rataSistole} mmHg ` +
                  `dan rata-rata tekanan diastolik adalah ${rataDiastole} mmHg.`;

            // Gabung semua kalimat menjadi satu narasi utuh
            const narasi = `${kalimatTerbaru} ${narasiRingkasanRiwayat} ${narasiTren}`;

            return narasi;
        }

        // ============================================================
        // [REVISI] FUNGSI bukaGrafikModal() — DIMODIFIKASI
        // Perubahan dari versi lama:
        //   1. Blok if-else per nama pasien DIHAPUS (data hardcoded klinis)
        //   2. teksKesimpulan yang berisi rekomendasi klinis DIHAPUS
        //   3. Diganti dengan pemanggilan hitungNarasiDeskriptif()
        //   4. Manipulasi warna kotak berdasarkan kondisi klinis DIHAPUS
        //      — warna kotak kini tetap biru netral (informatif, bukan judgement)
        // Struktur fungsi, nama variabel, dan render Chart TIDAK diubah.
        // ============================================================
        // Variabel global chart — hanya satu deklarasi
        let chartInst = null;

        // Cari pasien
        document.getElementById('cariPasien').addEventListener('input', function() {
            const q = this.value.toLowerCase();
            document.querySelectorAll('.baris-pasien').forEach(row => {
                row.style.display = row.dataset.nama.includes(q) ? '' : 'none';
            });
        });

        async function bukaGrafikModal(idPasien, namaPasien) {
            // 1. Tampilkan modal DULU sebelum render chart
            document.getElementById('modal-grafik').classList.remove('hidden-el');
            document.getElementById('nama-pasien-modal').innerText = namaPasien;
            document.getElementById('kesimpulan-pasien').textContent = 'Memuat data...';

            // 2. Hancurkan chart lama jika ada
            if (chartInst) {
                chartInst.destroy();
                chartInst = null;
            }

            try {
                const res = await fetch(`/bidan/monitoring/api/${idPasien}`);
                const json = await res.json();

                if (!json.success || !json.data || json.data.length === 0) {
                    document.getElementById('kesimpulan-pasien').textContent = 'Belum ada riwayat skrining terverifikasi untuk pasien ini.';
                    return;
                }

                const dataSistole  = json.data.map(r => r.sistole);
                const dataDiastole = json.data.map(r => r.diastole);
                const labels       = json.data.map(r => {
                    const d = new Date(r.tanggal_skrining);
                    return d.toLocaleDateString('id-ID', { day: '2-digit', month: 'short' });
                });

                const narasiDeskriptif = hitungNarasiDeskriptif(dataSistole, dataDiastole);
                document.getElementById('kesimpulan-pasien').textContent = narasiDeskriptif;

                // 3. Beri jeda kecil agar modal sudah benar-benar visible sebelum Chart.js hitung dimensi canvas
                setTimeout(() => {
                    Chart.defaults.font.family = "'Inter', sans-serif";
                    const ctx = document.getElementById('historiTensiChart').getContext('2d');

                    if (chartInst) { chartInst.destroy(); chartInst = null; }

                    chartInst = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels,
                            datasets: [
                                {
                                    label: 'Sistole',
                                    data: dataSistole,
                                    borderColor: '#EF4444',
                                    backgroundColor: 'rgba(239,68,68,0.1)',
                                    fill: true,
                                    tension: 0.3,
                                    borderWidth: 2,
                                    pointRadius: 4,
                                    pointBackgroundColor: '#EF4444'
                                },
                                {
                                    label: 'Diastole',
                                    data: dataDiastole,
                                    borderColor: '#3B82F6',
                                    backgroundColor: 'rgba(59,130,246,0.1)',
                                    fill: true,
                                    tension: 0.3,
                                    borderWidth: 2,
                                    pointRadius: 4,
                                    pointBackgroundColor: '#3B82F6'
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { position: 'top', labels: { usePointStyle: true, boxWidth: 8 } }
                            },
                            scales: {
                                y: { min: 60, max: 200, grid: { color: '#F3F4F6' } },
                                x: { grid: { display: false } }
                            }
                        }
                    });
                }, 50);

            } catch (err) {
                document.getElementById('kesimpulan-pasien').textContent = 'Gagal memuat data. Periksa koneksi.';
                console.error(err);
            }
        }

        function tutupGrafikModal() {
            document.getElementById('modal-grafik').classList.add('hidden-el');
        }
    </script>

<%- include('../partials/profil') %>

</div>
</body>
</html>