<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Bidan</title>
    <link rel="stylesheet" href="/css/output.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        .font-poppins { font-family: 'Poppins', sans-serif; }
        .font-inter { font-family: 'Inter', sans-serif; }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-slate-50 font-inter antialiased text-slate-800">
    
    <div class="app-shell">
    <%- include('../partials/sidebar', { active: 'dashboard_bidan', role: 'bidan' }) %>

    <div class="main-content-wrapper">
        <%- include('../partials/header', { pageTitle: 'Dashboard Bidan', role: 'bidan' }) %>

        <main class="p-4 md:p-6 lg:p-8 space-y-6 w-full">
            <div>
                <h2 class="text-[#1F2937] font-poppins font-semibold text-xl">
                    Dashboard Bidan - Kecamatan IV Koto Agam
                </h2>
                <p class="text-[#6B7280] text-sm mt-1">
                    <%= new Date().toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
                </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 flex flex-col justify-between">
                    <div class="flex justify-between items-start mb-4">
                        <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        </div>
                        <span class="px-2 py-1 bg-blue-50 text-blue-600 text-[10px] font-semibold rounded-md">Bulan ini</span>
                    </div>
                    <div>
                        <p class="text-3xl font-poppins font-bold text-gray-800"><%= totalData %></p>
                        <p class="text-gray-500 text-xs font-medium mt-1">Total Data Masuk</p>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 flex flex-col justify-between">
                    <div class="flex justify-between items-start mb-4">
                        <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        </div>
                        <span class="px-2 py-1 bg-amber-50 text-amber-600 text-[10px] font-semibold rounded-md">Perlu tindakan</span>
                    </div>
                    <div>
                        <p class="text-3xl font-poppins font-bold text-gray-800"><%= jumlahMenunggu %></p>
                        <p class="text-gray-500 text-xs font-medium mt-1">Data Belum Diverifikasi</p>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 flex flex-col justify-between">
                    <div class="flex justify-between items-start mb-4">
                        <div class="w-10 h-10 rounded-xl bg-green-100 text-green-600 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                        </div>
                    </div>
                    <div>
                        <p class="text-3xl font-poppins font-bold text-gray-800"><%= jumlahTerverifikasi %></p>
                        <p class="text-gray-500 text-xs font-medium mt-1">Data Terverifikasi</p>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 flex flex-col justify-between">
                    <div class="flex justify-between items-start mb-4">
                        <div class="w-10 h-10 rounded-xl bg-red-100 text-red-600 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                        </div>
                    </div>
                    <div>
                        <p class="text-3xl font-poppins font-bold text-gray-800"><%= jumlahDitolak %></p>
                        <p class="text-gray-500 text-xs font-medium mt-1">Perlu Perbaikan</p>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
                <div class="lg:col-span-2 bg-white rounded-2xl p-6 border border-gray-100 shadow-sm h-fit">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
                        <h3 class="text-[#1F2937] font-poppins font-semibold">Capaian per Jorong (Bulan Ini)</h3>
                        <div class="flex flex-wrap gap-1" id="ptm-chart-filters">
                            <button type="button" onclick="updateDashboardChart('all')" class="chart-filter-btn px-2 py-1 rounded-lg text-xs font-semibold border transition-all bg-blue-600 text-white border-blue-600">Semua</button>
                            <button type="button" onclick="updateDashboardChart('hipertensi')" class="chart-filter-btn px-2 py-1 rounded-lg text-xs font-semibold border transition-all bg-white text-gray-600 border-gray-200 hover:bg-gray-50">Hipertensi</button>
                            <button type="button" onclick="updateDashboardChart('dm')" class="chart-filter-btn px-2 py-1 rounded-lg text-xs font-semibold border transition-all bg-white text-gray-600 border-gray-200 hover:bg-gray-50">Diabetes</button>
                            <button type="button" onclick="updateDashboardChart('obesitas')" class="chart-filter-btn px-2 py-1 rounded-lg text-xs font-semibold border transition-all bg-white text-gray-600 border-gray-200 hover:bg-gray-50">Obesitas</button>
                            <button type="button" onclick="updateDashboardChart('ppok')" class="chart-filter-btn px-2 py-1 rounded-lg text-xs font-semibold border transition-all bg-white text-gray-600 border-gray-200 hover:bg-gray-50">PPOK</button>
                            <button type="button" onclick="updateDashboardChart('gangguan_indra')" class="chart-filter-btn px-2 py-1 rounded-lg text-xs font-semibold border transition-all bg-white text-gray-600 border-gray-200 hover:bg-gray-50">Indra</button>
                            <button type="button" onclick="updateDashboardChart('kesehatan_jiwa')" class="chart-filter-btn px-2 py-1 rounded-lg text-xs font-semibold border transition-all bg-white text-gray-600 border-gray-200 hover:bg-gray-50">Jiwa</button>
                        </div>
                    </div>
                    <div class="w-full overflow-x-auto pb-4">
                        <div id="chartContainer" style="height: 350px;">
                            <canvas id="jorongChart"></canvas>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm flex flex-col h-fit">
                    <h3 class="text-[#1F2937] font-poppins font-semibold mb-5">Sebaran Pemeriksaan PTM</h3>
                    
                    <% 
                        // Kalkulasi persentase
                        let totalPtm = parseInt(ptmStats.total) || 1;
                        let persenHipertensi = Math.round((parseInt(ptmStats.hipertensi) || 0) / totalPtm * 100);
                        let persenDm = Math.round((parseInt(ptmStats.dm) || 0) / totalPtm * 100);
                        let persenObesitas = Math.round((parseInt(ptmStats.obesitas) || 0) / totalPtm * 100);
                        let persenPpok = Math.round((parseInt(ptmStats.ppok) || 0) / totalPtm * 100);
                        let persenIndra = Math.round((parseInt(ptmStats.gangguan_indra) || 0) / totalPtm * 100);
                        let persenJiwa = Math.round((parseInt(ptmStats.kesehatan_jiwa) || 0) / totalPtm * 100);
                    %>

                    <div class="space-y-4">
                        <div>
                            <div class="flex justify-between text-xs mb-1">
                                <span class="text-[#6B7280] font-medium">Hipertensi</span>
                                <span class="text-[#1F2937] font-semibold"><%= ptmStats.hipertensi %> (<%= persenHipertensi %>%)</span>
                            </div>
                            <div class="h-2 bg-gray-100 rounded-full overflow-hidden">
                                <div class="h-full bg-blue-500 rounded-full" style="width: <%= persenHipertensi %>%;"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-xs mb-1">
                                <span class="text-[#6B7280] font-medium">Diabetes Melitus</span>
                                <span class="text-[#1F2937] font-semibold"><%= ptmStats.dm %> (<%= persenDm %>%)</span>
                            </div>
                            <div class="h-2 bg-gray-100 rounded-full overflow-hidden">
                                <div class="h-full bg-emerald-500 rounded-full" style="width: <%= persenDm %>%;"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-xs mb-1">
                                <span class="text-[#6B7280] font-medium">Obesitas</span>
                                <span class="text-[#1F2937] font-semibold"><%= ptmStats.obesitas %> (<%= persenObesitas %>%)</span>
                            </div>
                            <div class="h-2 bg-gray-100 rounded-full overflow-hidden">
                                <div class="h-full bg-amber-500 rounded-full" style="width: <%= persenObesitas %>%;"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-xs mb-1">
                                <span class="text-[#6B7280] font-medium">PPOK</span>
                                <span class="text-[#1F2937] font-semibold"><%= ptmStats.ppok %> (<%= persenPpok %>%)</span>
                            </div>
                            <div class="h-2 bg-gray-100 rounded-full overflow-hidden">
                                <div class="h-full bg-purple-500 rounded-full" style="width: <%= persenPpok %>%;"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-xs mb-1">
                                <span class="text-[#6B7280] font-medium">Gangguan Indra</span>
                                <span class="text-[#1F2937] font-semibold"><%= ptmStats.gangguan_indra %> (<%= persenIndra %>%)</span>
                            </div>
                            <div class="h-2 bg-gray-100 rounded-full overflow-hidden">
                                <div class="h-full bg-pink-500 rounded-full" style="width: <%= persenIndra %>%;"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-xs mb-1">
                                <span class="text-[#6B7280] font-medium">Kesehatan Jiwa</span>
                                <span class="text-[#1F2937] font-semibold"><%= ptmStats.kesehatan_jiwa %> (<%= persenJiwa %>%)</span>
                            </div>
                            <div class="h-2 bg-gray-100 rounded-full overflow-hidden">
                                <div class="h-full bg-teal-500 rounded-full" style="width: <%= persenJiwa %>%;"></div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-8 pt-5 border-t border-gray-100">
                        <p class="text-[#1F2937] text-xs font-semibold mb-3 uppercase tracking-wider">Belum Diverifikasi per Jorong</p>
                        <div class="space-y-2.5 max-h-[250px] overflow-y-auto pr-2">
                            <% jorongStats.forEach((j, index) => { %>
                                <% const colors = ["#2563EB", "#10B981", "#F59E0B", "#8B5CF6", "#EC4899", "#14B8A6"]; %>
                                <div class="flex items-center justify-between text-sm">
                                    <div class="flex items-center gap-2">
                                        <div class="w-2 h-2 rounded-full" style="background-color: <%= colors[index % colors.length] %>"></div>
                                        <span class="text-[#6B7280]"><%= j.nama_jorong %></span>
                                    </div>
                                    <span class="<%= j.menunggu > 0 ? 'text-[#D97706]' : 'text-[#059669]' %> font-semibold">
                                        <%= j.menunggu %> data
                                    </span>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
                <div class="flex items-center justify-between px-6 py-5 border-b border-gray-100">
                    <h3 class="text-[#1F2937] font-poppins font-semibold">Data Belum Diverifikasi (<%= jumlahMenunggu %>)</h3>
                    <a href="/bidan/validasi" class="text-sm bg-[#2563EB] text-white px-5 py-2.5 rounded-xl hover:bg-[#1D4ED8] transition-all font-medium shadow-sm">
                        Lihat Semua
                    </a>
                </div>
                <div class="divide-y divide-gray-50">
                    <% if (antreanValidasi.length > 0) { %>
                        <% antreanValidasi.forEach(item => { %>
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between px-6 py-4 hover:bg-slate-50 transition-colors gap-3">
                                <div class="flex items-center gap-3">
                                    <div class="w-9 h-9 rounded-full bg-amber-50 text-amber-600 flex items-center justify-center font-bold text-sm uppercase">
                                        <%= item.nama_pasien.charAt(0) %>
                                    </div>
                                    <div>
                                        <p class="text-[#1F2937] text-sm font-semibold"><%= item.nama_pasien %></p>
                                        <p class="text-[#6B7280] text-xs mt-0.5">
                                            <%= item.nama_jorong %> • 
                                            <%= new Date(item.tanggal_kegiatan).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) %> • 
                                            <span class="text-blue-600 font-semibold bg-blue-50 px-2 py-0.5 rounded-md"><%= item.ptm_list %></span>
                                        </p>
                                    </div>
                                </div>
                                <div class="flex items-center gap-4 justify-between sm:justify-end w-full sm:w-auto pl-12 sm:pl-0">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#FEF3C7] text-[#D97706] text-xs font-semibold">
                                        <span class="w-1.5 h-1.5 rounded-full bg-[#F59E0B]"></span>Menunggu Validasi
                                    </span>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="px-6 py-8 text-center text-[#6B7280] text-sm">
                            Hore! Tidak ada data yang menunggu untuk diverifikasi.
                        </div>
                    <% } %>
                </div>
            </div>

        </main>
    </div>

    <script>
        let myChart;

        document.addEventListener('DOMContentLoaded', function() {
            // Data dikirim langsung dari variabel EJS
            const jorongData = <%- JSON.stringify(jorongStats) %>;
            
            // Map data untuk kebutuhan chart
            const labels = jorongData.map(j => j.nama_jorong);
            const dataTotal = jorongData.map(j => parseInt(j.total_pasien) || 0);
            
            const hitungLebar = Math.max(800, labels.length * 80);
            document.getElementById('chartContainer').style.minWidth = hitungLebar + 'px';

            const ctx = document.getElementById('jorongChart').getContext('2d');
            
            // Initialize chart with all data stacked
            myChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: getDatasetsForPTM('all', jorongData)
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                usePointStyle: true,
                                boxWidth: 8,
                                font: { family: "'Inter', sans-serif", size: 12, weight: '500' },
                                color: '#4B5563'
                            }
                        },
                        tooltip: {
                            backgroundColor: 'white',
                            titleColor: '#1F2937',
                            bodyColor: '#4B5563',
                            borderColor: '#E5E7EB',
                            borderWidth: 1,
                            padding: 10,
                            boxPadding: 4,
                            usePointStyle: true,
                            titleFont: { family: "'Poppins', sans-serif", size: 13 },
                            bodyFont: { family: "'Inter', sans-serif", size: 12 }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false, drawBorder: false },
                            ticks: { 
                                font: { family: "'Inter', sans-serif", size: 11 }, 
                                color: '#6B7280' }
                        },
                        y: {
                            grid: { color: '#F3F4F6', drawBorder: false, strokeDash: [3, 3] },
                            ticks: { 
                                font: { family: "'Inter', sans-serif", size: 11 }, color: '#6B7280' }
                        }
                    },
                    interaction: { mode: 'index', intersect: false }
                }
            });

            // Expose the update function globally
            window.updateDashboardChart = function(ptmType) {
                // Update button styles
                const buttons = document.querySelectorAll('.chart-filter-btn');
                buttons.forEach(btn => {
                    if (btn.getAttribute('onclick').includes(`'${ptmType}'`)) {
                        btn.className = 'chart-filter-btn px-2.5 py-1 rounded-lg text-xs font-semibold border transition-all bg-blue-600 text-white border-blue-600';
                    } else {
                        btn.className = 'chart-filter-btn px-2.5 py-1 rounded-lg text-xs font-semibold border transition-all bg-white text-gray-600 border-gray-200 hover:bg-gray-50';
                    }
                });

                // Update chart datasets
                myChart.data.datasets = getDatasetsForPTM(ptmType, jorongData);
                myChart.update();
            };

            function getDatasetsForPTM(ptmType, data) {
                const colors = {
                    total: '#3B82F6', // Blue-500
                    hipertensi: '#EF4444', // Red-500
                    dm: '#10B981', // Emerald-500
                    obesitas: '#F59E0B', // Amber-500
                    ppok: '#8B5CF6', // Purple-500
                    gangguan_indra: '#EC4899', // Pink-500
                    kesehatan_jiwa: '#0D9488' // Teal-600
                };

                const labels = {
                    total: 'Total Pasien',
                    hipertensi: 'Hipertensi',
                    dm: 'Diabetes Melitus',
                    obesitas: 'Obesitas',
                    ppok: 'PPOK',
                    gangguan_indra: 'Gangguan Indra',
                    kesehatan_jiwa: 'Kesehatan Jiwa'
                };

                if (ptmType === 'all') {
                    // Return all datasets
                    return [
                        {
                            label: labels.total,
                            data: data.map(d => parseInt(d.total_pasien) || 0),
                            backgroundColor: colors.total,
                            borderRadius: { topLeft: 4, topRight: 4 },
                            barPercentage: 0.5,
                            categoryPercentage: 0.8
                        },
                        {
                            label: labels.hipertensi,
                            data: data.map(d => parseInt(d.hipertensi) || 0),
                            backgroundColor: colors.hipertensi,
                            borderRadius: { topLeft: 4, topRight: 4 },
                            barPercentage: 0.5,
                            categoryPercentage: 0.8
                        },
                        {
                            label: labels.dm,
                            data: data.map(d => parseInt(d.dm) || 0),
                            backgroundColor: colors.dm,
                            borderRadius: { topLeft: 4, topRight: 4 },
                            barPercentage: 0.5,
                            categoryPercentage: 0.8
                        },
                        {
                            label: labels.obesitas,
                            data: data.map(d => parseInt(d.obesitas) || 0),
                            backgroundColor: colors.obesitas,
                            borderRadius: { topLeft: 4, topRight: 4 },
                            barPercentage: 0.5,
                            categoryPercentage: 0.8
                        },
                        {
                            label: labels.ppok,
                            data: data.map(d => parseInt(d.ppok) || 0),
                            backgroundColor: colors.ppok,
                            borderRadius: { topLeft: 4, topRight: 4 },
                            barPercentage: 0.5,
                            categoryPercentage: 0.8
                        },
                        {
                            label: labels.gangguan_indra,
                            data: data.map(d => parseInt(d.gangguan_indra) || 0),
                            backgroundColor: colors.gangguan_indra,
                            borderRadius: { topLeft: 4, topRight: 4 },
                            barPercentage: 0.5,
                            categoryPercentage: 0.8
                        },
                        {
                            label: labels.kesehatan_jiwa,
                            data: data.map(d => parseInt(d.kesehatan_jiwa) || 0),
                            backgroundColor: colors.kesehatan_jiwa,
                            borderRadius: { topLeft: 4, topRight: 4 },
                            barPercentage: 0.5,
                            categoryPercentage: 0.8
                        }
                    ];
                } else {
                    // Return total patient + the specific PTM case count
                    return [
                        {
                            label: labels.total,
                            data: data.map(d => parseInt(d.total_pasien) || 0),
                            backgroundColor: colors.total,
                            borderRadius: { topLeft: 4, topRight: 4 },
                            barPercentage: 0.5,
                            categoryPercentage: 0.8
                        },
                        {
                            label: labels[ptmType],
                            data: data.map(d => parseInt(d[ptmType]) || 0),
                            backgroundColor: colors[ptmType],
                            borderRadius: { topLeft: 4, topRight: 4 },
                            barPercentage: 0.5,
                            categoryPercentage: 0.8
                        }
                    ];
                }
            }
        });
    </script>

<%- include('../partials/profil') %>

</div>
</body>
</html>