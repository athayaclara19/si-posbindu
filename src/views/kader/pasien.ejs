<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Data Pasien - SI Posbindu</title>
    <link rel="stylesheet" href="/css/output.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
</head>
<body class="bg-slate-50 font-inter antialiased text-slate-800">
    
    <div class="app-shell">
    <%- include('../partials/sidebar', { active: 'pasien' }) %>

    <div class="main-content-wrapper">
        <%- include('../partials/header', { pageTitle: 'Data Pasien' }) %>

        <main class="p-4 md:p-6 lg:p-8 space-y-6 w-full">
            
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 font-poppins">Daftar Pasien</h2>
                    <p class="text-gray-500 text-sm mt-1">Kelola data warga yang terdaftar di Posbindu</p>
                </div>
                <a href="/pasien/tambah" class="bg-[#2563EB] hover:bg-[#1D4ED8] text-white px-5 py-2.5 rounded-xl text-sm font-medium transition-all flex items-center gap-2 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Tambah Pasien Baru
                </a>
            </div>

            <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 mb-6 flex flex-col md:flex-row gap-4">
                
                <div class="w-full md:flex-1">
                    <div class="flex items-center w-full px-4 py-2.5 rounded-xl border border-gray-200 bg-gray-50 focus-within:bg-white focus-within:border-[#2563EB] transition-all shadow-sm">
                        
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400 flex-shrink-0 mr-3">
                            <circle cx="11" cy="11" r="8"/><line x1="21" x2="16.65" y1="21" y2="16.65"/>
                        </svg>
                        
                        <input type="text" id="searchPasien" placeholder="Cari Nama atau NIK Pasien..." class="w-full bg-transparent border-none outline-none p-0 text-sm text-[#1F2937] placeholder-gray-400 focus:ring-0">
                    
                    </div>
                </div>
                
                <div class="w-full md:w-56">
                    <select id="filterNagari" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-gray-50 hover:bg-white transition-all cursor-pointer shadow-sm">
                        <option value="">Semua Nagari</option>
                        <% if (typeof nagari !== 'undefined') { %>
                            <% nagari.forEach(n => { %>
                                <option value="<%= n.id_nagari %>" <%= (typeof selectedNagari !== 'undefined' && String(selectedNagari) === String(n.id_nagari)) ? 'selected' : '' %>><%= n.nama_nagari %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>

                <div class="w-full md:w-56">
                    <select id="filterJorong" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-gray-50 hover:bg-white transition-all cursor-pointer shadow-sm disabled:opacity-50 disabled:cursor-not-allowed" title="Pilih Nagari terlebih dahulu">
                        <option value="">Semua Jorong</option>
                    </select>
                </div>

            </div>

            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse min-w-max">
                        <thead>
                            <tr class="bg-gray-50 border-b border-gray-100">
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider w-10">NO</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">ID / NIK</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Nama Pasien</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Nagari</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Jorong</th>
                                <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">L/P</th>
                                <th class="px-6 py-4 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider whitespace-nowrap w-32">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="pasienTableBody">
                            <% if (typeof daftarPasien !== 'undefined' && daftarPasien.length > 0) { %>
                                <% daftarPasien.forEach((p, index) => { %>
                                    <tr class="border-b border-gray-50 hover:bg-slate-50 transition-colors baris-pasien" data-jorong="<%= p.nama_jorong %>" data-nagari="<%= p.nama_nagari || '' %>">
                                        
                                        <td class="px-6 py-4 text-sm text-[#6B7280] font-medium">
                                            <%= index + 1 %>
                                        </td>

                                        <td class="px-6 py-4">
                                            <p class="text-sm font-bold text-gray-800"><%= p.id_pasien %></p>
                                            <p class="text-xs text-gray-400"><%= p.nik %></p>
                                        </td>
                                        
                                        <td class="px-6 py-4">
                                            <p class="text-sm font-medium text-gray-800"><%= p.nama_pasien %></p>
                                        </td>

                                        <td class="p-4">
                                            <span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 rounded-lg text-xs font-medium border border-emerald-100">
                                                <%= p.nama_nagari %>
                                            </span>
                                        </td>

                                        <td class="p-4">
                                            <span class="px-2.5 py-1 bg-blue-50 text-[#2563EB] rounded-lg text-xs font-medium border border-blue-100">
                                                <%= p.nama_jorong %>
                                            </span>
                                        </td>
                                        <td class="p-4"><%= p.jenis_kelamin === 'Laki-laki' ? 'L' : 'P' %></td>
                                        <td class="px-6 py-4 text-center align-middle whitespace-nowrap">
                                            <a href="/kader/skrining/<%= p.id_pasien %>" class="text-sm font-semibold text-[#2563EB] bg-blue-50 border border-blue-100 hover:bg-[#DBEAFE] hover:text-[#1D4ED8] px-4 py-2 rounded-xl transition-all shadow-sm inline-flex items-center justify-center gap-1.5">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                                                Input Tensi
                                            </a>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="7" class="p-10 text-center text-gray-500">
                                        <div class="flex flex-col items-center justify-center">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-gray-300 mb-3"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6"/><path d="M22 11h-6"/></svg>
                                            <p>Belum ada data pasien.</p>
                                            <p class="text-xs mt-1">Silakan klik "Tambah Pasien Baru" di atas.</p>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <%# ====== PAGINATION ====== %>
                <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                <% 
                    const buildPasienUrl = (p) => {
                        const params = new URLSearchParams();
                        if (search) params.set('search', search);
                        if (typeof selectedNagari !== 'undefined' && selectedNagari) params.set('nagari', selectedNagari);
                        if (typeof selectedJorong !== 'undefined' && selectedJorong) params.set('jorong', selectedJorong);
                        params.set('page', p);
                        return '/pasien?' + params.toString();
                    };
                %>
                <div class="flex items-center justify-between mt-4 px-2">
                    <p class="text-sm text-gray-500">
                        Menampilkan halaman <%= page %> dari <%= totalPages %> 
                        (<%= totalData %> total pasien)
                    </p>
                    <div class="flex gap-2">
                        <% if (page > 1) { %>
                            <a href="<%= buildPasienUrl(page - 1) %>"
                               class="px-3 py-1.5 rounded-lg border border-gray-200 text-sm text-gray-600 hover:bg-gray-50">
                                ← Sebelumnya
                            </a>
                        <% } %>
                        <% for (let i = Math.max(1, page-2); i <= Math.min(totalPages, page+2); i++) { %>
                            <a href="<%= buildPasienUrl(i) %>"
                               class="px-3 py-1.5 rounded-lg border text-sm
                                      <%= i === page ? 'bg-blue-600 text-white border-blue-600' : 'border-gray-200 text-gray-600 hover:bg-gray-50' %>">
                                <%= i %>
                            </a>
                        <% } %>
                        <% if (page < totalPages) { %>
                            <a href="<%= buildPasienUrl(page + 1) %>"
                               class="px-3 py-1.5 rounded-lg border border-gray-200 text-sm text-gray-600 hover:bg-gray-50">
                                Berikutnya →
                            </a>
                        <% } %>
                    </div>
                </div>
                <% } %>

            </div>

        </main>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput  = document.getElementById('searchPasien');
            const filterNagari = document.getElementById('filterNagari');
            const filterJorong = document.getElementById('filterJorong');

            const urlParams      = new URLSearchParams(window.location.search);
            const currentSearch  = urlParams.get('search') || '';
            const currentNagari  = urlParams.get('nagari') || '';
            const currentJorong  = urlParams.get('jorong') || '';

            // Isi nilai search dari URL agar kotak tidak kosong setelah submit
            searchInput.value = currentSearch;
            if (currentNagari) filterNagari.value = currentNagari;

            // === DATA JORONG (untuk dropdown cascade nagari -> jorong) ===
            const jorongOptions = [];
            <%- JSON.stringify(jorong || []) %>.forEach(j => {
                jorongOptions.push({ id: String(j.id_jorong), nagariId: String(j.id_nagari), nama: j.nama_jorong });
            });

            function updateJorongDropdown(selectedJorongId) {
                const nagariTerpilih = filterNagari.value;
                filterJorong.innerHTML = '<option value="">Semua Jorong</option>';
                filterJorong.disabled  = nagariTerpilih === '';

                const daftarJorong = nagariTerpilih === ''
                    ? jorongOptions
                    : jorongOptions.filter(j => j.nagariId === nagariTerpilih);

                daftarJorong.sort((a, b) => a.nama.localeCompare(b.nama));
                daftarJorong.forEach(j => {
                    const opt = document.createElement('option');
                    opt.value       = j.id;
                    opt.textContent = j.nama;
                    if (selectedJorongId && j.id === String(selectedJorongId)) opt.selected = true;
                    filterJorong.appendChild(opt);
                });
            }

            // Render ulang dropdown jorong sesuai state awal dari URL
            updateJorongDropdown(currentJorong);

            // === NAVIGASI: kirim search + filter ke server, lalu reload halaman 1 ===
            function navigateWithFilters(overrides) {
                const params = new URLSearchParams(window.location.search);
                const state = {
                    search: params.get('search') || '',
                    nagari: params.get('nagari') || '',
                    jorong: params.get('jorong') || '',
                    page:   params.get('page')   || 1,
                };
                Object.assign(state, overrides);

                const qs = new URLSearchParams();
                if (state.search) qs.set('search', state.search);
                if (state.nagari) qs.set('nagari', state.nagari);
                if (state.jorong) qs.set('jorong', state.jorong);
                qs.set('page', state.page);
                window.location.href = '/pasien?' + qs.toString();
            }

            // Kirim pencarian ke server saat berhenti mengetik (debounce)
            let debounceTimer;
            searchInput.addEventListener('input', function() {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(function() {
                    navigateWithFilters({ search: searchInput.value.trim(), page: 1 });
                }, 500); // tunggu 500ms setelah berhenti mengetik
            });

            filterNagari.addEventListener('change', function() {
                updateJorongDropdown('');
                navigateWithFilters({ nagari: filterNagari.value, jorong: '', page: 1 });
            });

            filterJorong.addEventListener('change', function() {
                navigateWithFilters({ jorong: filterJorong.value, page: 1 });
            });
        });
    </script>

<%- include('../partials/profil') %>


</div>
</body>
</html>