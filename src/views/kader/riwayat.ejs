<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Riwayat Skrining - Kader</title>
    <link rel="stylesheet" href="/css/output.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap"
        rel="stylesheet">
    <style>
        .font-poppins {
            font-family: 'Poppins', sans-serif;
        }

        .font-inter {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>

<body class="bg-slate-50 font-inter antialiased text-slate-800">

    <div class="app-shell">
        <%- include('../partials/sidebar', { active: 'riwayat' }) %>

            <div class="main-content-wrapper">
                <%- include('../partials/header', { pageTitle: 'Riwayat Skrining' }) %>

                    <main class="p-8 space-y-5">
                        <div>
                            <h2 class="text-[#1F2937] font-poppins font-semibold text-xl">Riwayat Skrining</h2>
                            <p class="text-[#6B7280] text-sm mt-1">Semua data skrining yang pernah Anda input</p>
                        </div>

                        <div class="flex flex-col sm:flex-row gap-3">
                            <div class="relative flex-1">
                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round"
                                    class="absolute left-3 top-1/2 -translate-y-1/2 text-[#6B7280]">
                                    <circle cx="11" cy="11" r="8" />
                                    <path d="m21 21-4.3-4.3" />
                                </svg>
                                <input type="text" id="searchInput" placeholder="Cari nama atau NIK pasien..."
                                    value="<%= typeof search !== 'undefined' ? search : '' %>"
                                    class="w-full pl-9 pr-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white transition-all">
                            </div>
                            <div class="flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round" class="text-[#6B7280]">
                                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />
                                </svg>
                                <select id="statusFilter"
                                    class="px-3 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white transition-all">
                                    <option value="Semua" <%=(typeof statusQ==='undefined' || statusQ==='' ||
                                        statusQ==='Semua' ) ? 'selected' : '' %>>Semua Status</option>
                                    <option value="Menunggu Validasi" <%=(typeof statusQ !=='undefined' &&
                                        statusQ==='Menunggu Validasi' ) ? 'selected' : '' %>>Menunggu Validasi</option>
                                    <option value="Valid" <%=(typeof statusQ !=='undefined' && statusQ==='Valid' )
                                        ? 'selected' : '' %>>Valid (Diterima)</option>
                                    <option value="Perlu Revisi" <%=(typeof statusQ !=='undefined' &&
                                        statusQ==='Perlu Revisi' ) ? 'selected' : '' %>>Perlu Revisi</option>
                                </select>

                                <select id="ptmFilter"
                                    class="px-3 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white transition-all">
                                    <option value="Semua" <%=(typeof ptm==='undefined' || ptm==='' || ptm==='Semua' )
                                        ? 'selected' : '' %>>Semua Penyakit (PTM)</option>
                                    <option value="hipertensi" <%=(typeof ptm !=='undefined' && ptm==='hipertensi' )
                                        ? 'selected' : '' %>>Hipertensi</option>
                                    <option value="dm" <%=(typeof ptm !=='undefined' && ptm==='dm' ) ? 'selected' : ''
                                        %>>Diabetes Melitus</option>
                                    <option value="obesitas" <%=(typeof ptm !=='undefined' && ptm==='obesitas' )
                                        ? 'selected' : '' %>>Obesitas</option>
                                    <option value="ppok" <%=(typeof ptm !=='undefined' && ptm==='ppok' ) ? 'selected'
                                        : '' %>>PPOK</option>
                                    <option value="gangguan_indra" <%=(typeof ptm !=='undefined' &&
                                        ptm==='gangguan_indra' ) ? 'selected' : '' %>>Gangguan Indra</option>
                                    <option value="kesehatan_jiwa" <%=(typeof ptm !=='undefined' &&
                                        ptm==='kesehatan_jiwa' ) ? 'selected' : '' %>>Kesehatan Jiwa</option>
                                </select>
                            </div>
                        </div>

                        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
                            <div class="overflow-x-auto">
                                <table class="w-full" id="riwayatTable">
                                    <thead>
                                        <tr class="border-b border-gray-100 bg-[#F8FAFC]">
                                            <th
                                                class="text-left px-5 py-3 text-xs text-[#6B7280] uppercase tracking-wider font-medium">
                                                Pasien</th>
                                            <th
                                                class="text-left px-5 py-3 text-xs text-[#6B7280] uppercase tracking-wider font-medium">
                                                Tanggal</th>
                                            <th
                                                class="text-left px-5 py-3 text-xs text-[#6B7280] uppercase tracking-wider font-medium">
                                                Penyakit (PTM)</th>
                                            <th
                                                class="text-left px-5 py-3 text-xs text-[#6B7280] uppercase tracking-wider font-medium">
                                                Hasil</th>
                                            <th
                                                class="text-left px-5 py-3 text-xs text-[#6B7280] uppercase tracking-wider font-medium">
                                                Status</th>
                                            <th
                                                class="text-left px-5 py-3 text-xs text-[#6B7280] uppercase tracking-wider font-medium">
                                                Aksi</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-50">

                                        <% if (typeof riwayat !=='undefined' && riwayat.length> 0) { %>
                                            <% riwayat.forEach(r=> {
                                                let combinedStatus = 'menunggu';
                                                let pemeriksaan = r.pemeriksaan || [];
                                                let hasRevisi = pemeriksaan && Array.isArray(pemeriksaan) ?
                                                pemeriksaan.some(p => p.status_validasi === 'revisi') : false;
                                                let allValid = pemeriksaan && Array.isArray(pemeriksaan) ?
                                                pemeriksaan.every(p => p.status_validasi === 'terverifikasi') : false;

                                                if (hasRevisi) {
                                                combinedStatus = 'revisi';
                                                } else if (allValid) {
                                                combinedStatus = 'terverifikasi';
                                                }

                                                let filterStatus = 'Semua';
                                                if (combinedStatus === 'menunggu') filterStatus = 'Menunggu Validasi';
                                                if (combinedStatus === 'terverifikasi') filterStatus = 'Valid';
                                                if (combinedStatus === 'revisi') filterStatus = 'Perlu Revisi';
                                                %>
                                                <tr class="hover:bg-gray-50 transition-colors data-row cursor-default"
                                                    data-status="<%= filterStatus %>">

                                                    <!-- Kolom 1: Nama & NIK -->
                                                    <td class="px-5 py-3.5">
                                                        <p class="text-[#1F2937] text-sm font-medium search-target"><%-
                                                                r.nama_pasien %></p>
                                                        <p class="text-[#6B7280] text-xs font-mono search-target">
                                                            <%= r.nik %>
                                                        </p>
                                                    </td>

                                                    <!-- Kolom 2: Tanggal -->
                                                    <td class="px-5 py-3.5 text-sm text-[#6B7280]">
                                                        <%= new Date(r.tanggal_kegiatan).toLocaleDateString('id-ID', {
                                                            day: 'numeric' , month: 'short' , year: 'numeric' }) %>
                                                    </td>

                                                    <!-- Kolom 3: Penyakit (PTM) -->
                                                    <td class="px-5 py-3.5">
                                                        <div class="flex flex-wrap gap-1.5 max-w-[220px]">
                                                            <% (r.pemeriksaan || []).forEach(p=> {
                                                                const PTM_LABELS = {
                                                                hipertensi: 'Hipertensi', dm: 'DM', obesitas:
                                                                'Obesitas',
                                                                ppok: 'PPOK', gangguan_indra: 'Indra', kesehatan_jiwa:
                                                                'Jiwa'
                                                                };
                                                                const label = PTM_LABELS[p.id_jenis_ptm] || p.nama_ptm;
                                                                let badgeClass = "bg-blue-50 text-blue-600 border border-blue-100";
                                                                if (p.status_validasi === 'revisi') badgeClass = "bg-red-50 text-red-600 border border-red-100 font-bold";
                                                                %>
                                                                <span
                                                                    class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] <%= badgeClass %>">
                                                                    <%= label %>
                                                                        <% if (p.status_validasi==='revisi' ) { %>
                                                                            <span
                                                                                class="ml-1 w-1.5 h-1.5 rounded-full bg-red-500"></span>
                                                                            <% } %>
                                                                </span>
                                                                <% }) %>
                                                        </div>
                                                    </td>

                                                    <!-- Kolom 4: Hasil Singkat -->
                                                    <td class="px-5 py-3.5 text-xs text-[#4B5563] space-y-0.5">
                                                        <% (r.pemeriksaan || []).forEach(p=> { %>
                                                            <% if (p.id_jenis_ptm==='hipertensi' ) { %>
                                                                <div><span
                                                                        class="font-medium text-gray-500">Tensi:</span>
                                                                    <%= p.sistole %>/<%= p.diastole %> mmHg
                                                                </div>
                                                                <% } else if (p.id_jenis_ptm==='dm' && p.dm_gula_darah)
                                                                    { %>
                                                                    <div><span
                                                                            class="font-medium text-gray-500">GD:</span>
                                                                        <%= p.dm_gula_darah %> mg/dL
                                                                    </div>
                                                                    <% } else if (p.id_jenis_ptm==='obesitas' &&
                                                                        p.ob_berat_badan) { %>
                                                                        <div><span
                                                                                class="font-medium text-gray-500">BB/TB:</span>
                                                                            <%= p.ob_berat_badan %> kg/<%=
                                                                                    p.ob_tinggi_badan %> cm
                                                                        </div>
                                                                        <% } else if (p.id_jenis_ptm==='ppok' ) { %>
                                                                            <div><span
                                                                                    class="font-medium text-gray-500">PUMA:</span>
                                                                                <%= p.pp_skor_total || '0' %>
                                                                            </div>
                                                                            <% } else if
                                                                                (p.id_jenis_ptm==='gangguan_indra' ) {
                                                                                %>
                                                                                <div><span
                                                                                        class="font-medium text-gray-500">Indra:</span>
                                                                                    Mata:<%= p.gi_mata || '-' %>/Tel:<%=
                                                                                            p.gi_telinga || '-' %>
                                                                                </div>
                                                                                <% } else if
                                                                                    (p.id_jenis_ptm==='kesehatan_jiwa' )
                                                                                    { %>
                                                                                    <div><span
                                                                                            class="font-medium text-gray-500">SRQ-20:</span>
                                                                                        <%= p.kj_skor_total || '0' %>/20
                                                                                    </div>
                                                                                    <% } %>
                                                                                        <% }) %>
                                                    </td>

                                                    <!-- Kolom 5: Badge Status Validasi Gabungan -->
                                                    <td class="px-5 py-3.5">
                                                        <% if (combinedStatus==='menunggu' ) { %>
                                                            <span
                                                                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#FEF3C7] text-[#D97706] text-xs font-medium">
                                                                <span
                                                                    class="w-1.5 h-1.5 rounded-full bg-[#F59E0B]"></span>Menunggu
                                                            </span>
                                                            <% } else if (combinedStatus==='terverifikasi' ) { %>
                                                                <span
                                                                    class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#D1FAE5] text-[#059669] text-xs font-medium">
                                                                    <span
                                                                        class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span>Valid
                                                                </span>
                                                                <% } else { %>
                                                                    <span
                                                                        class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#FEE2E2] text-[#DC2626] text-xs font-bold">
                                                                        <span
                                                                            class="w-1.5 h-1.5 rounded-full bg-[#EF4444] animate-pulse"></span>Revisi
                                                                    </span>
                                                                    <% } %>
                                                    </td>

                                                    <!-- Kolom 6: Tombol Aksi -->
                                                    <td class="px-5 py-3.5">
                                                        <button
                                                            class="btn-lihat inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-slate-200 text-[#4B5563] hover:bg-[#EEF2F6] hover:text-blue-600 transition-all text-xs font-medium"
                                                            title="Lihat Detail Pemeriksaan"
                                                            data-nama="<%- r.nama_pasien %>" data-nik="<%= r.nik %>"
                                                            data-tanggal="<%= new Date(r.tanggal_kegiatan).toLocaleDateString('id-ID', {day:'numeric',month:'long',year:'numeric'}) %>"
                                                            data-pemeriksaan='<%- JSON.stringify(r.pemeriksaan || []).replace(/'/g, "&#39;") %>'
                                                            data-status="<%= combinedStatus %>"
                                                                >
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="14"
                                                                    height="14" viewBox="0 0 24 24" fill="none"
                                                                    stroke="currentColor" stroke-width="2"
                                                                    stroke-linecap="round" stroke-linejoin="round">
                                                                    <path
                                                                        d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0z" />
                                                                    <circle cx="12" cy="12" r="3" />
                                                                </svg>
                                                                Lihat
                                                        </button>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                                    <% } else { %>
                                                        <tr>
                                                            <td colspan="6"
                                                                class="px-5 py-10 text-center text-[#6B7280]">Belum ada
                                                                data skrining yang diinput.</td>
                                                        </tr>
                                                        <% } %>
                                    </tbody>
                                </table>
                            </div>

                            <div
                                class="px-5 py-3 border-t border-gray-100 flex items-center justify-between flex-wrap gap-3">
                                <p class="text-[#6B7280] text-xs">
                                    Menampilkan <%= riwayat.length %> dari <%= typeof totalData !=='undefined' ?
                                            totalData : riwayat.length %> data
                                </p>
                                <%# Pagination %>
                                    <% if (typeof totalPages !=='undefined' && totalPages> 1) { %>
                                        <div class="flex gap-1.5">
                                            <% if (page> 1) { %>
                                                <a href="/riwayat?search=<%= encodeURIComponent(search) %>&status=<%= encodeURIComponent(statusQ) %>&ptm=<%= encodeURIComponent(ptm) %>&page=<%= page - 1 %>"
                                                    class="px-3 py-1.5 rounded-lg border border-gray-200 text-xs text-gray-600 hover:bg-gray-50">←
                                                    Prev</a>
                                                <% } %>
                                                    <% for (let i=Math.max(1, page-2); i <=Math.min(totalPages, page+2);
                                                        i++) { %>
                                                        <a href="/riwayat?search=<%= encodeURIComponent(search) %>&status=<%= encodeURIComponent(statusQ) %>&ptm=<%= encodeURIComponent(ptm) %>&page=<%= i %>"
                                                            class="px-3 py-1.5 rounded-lg border text-xs
                                      <%= i === page ? 'bg-blue-600 text-white border-blue-600' : 'border-gray-200 text-gray-600 hover:bg-gray-50' %>">
                                                            <%= i %>
                                                        </a>
                                                        <% } %>
                                                            <% if (page < totalPages) { %>
                                                                <a href="/riwayat?search=<%= encodeURIComponent(search) %>&status=<%= encodeURIComponent(statusQ) %>&ptm=<%= encodeURIComponent(ptm) %>&page=<%= page + 1 %>"
                                                                    class="px-3 py-1.5 rounded-lg border border-gray-200 text-xs text-gray-600 hover:bg-gray-50">Next
                                                                    →</a>
                                                                <% } %>
                                        </div>
                                        <% } %>
                            </div>
                        </div>
                    </main>

                    <div id="detailModal" class="fixed inset-0 z-50 hidden items-center justify-center">
                        <div class="absolute inset-0 bg-gray-900/40 backdrop-blur-sm transition-opacity"
                            onclick="closeDetailModal()"></div>

                        <div
                            class="bg-white rounded-2xl shadow-xl w-full max-w-2xl z-10 overflow-hidden transform transition-all m-4 max-h-[90vh] flex flex-col">

                            <!-- Header Modal -->
                            <div
                                class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50 shrink-0">
                                <div class="flex items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                        stroke-linejoin="round" class="text-[#2563EB]">
                                        <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                                        <circle cx="12" cy="12" r="3" />
                                    </svg>
                                    <h3 class="font-poppins font-semibold text-gray-800 text-lg">Detail Skrining</h3>
                                </div>
                                <button onclick="closeDetailModal()"
                                    class="text-gray-400 hover:text-gray-600 transition-colors">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                        stroke-linejoin="round">
                                        <line x1="18" y1="6" x2="6" y2="18"></line>
                                        <line x1="6" y1="6" x2="18" y2="18"></line>
                                    </svg>
                                </button>
                            </div>

                            <!-- Body Modal (scrollable) -->
                            <div class="p-6 space-y-5 overflow-y-auto">

                                <!-- Identitas Pasien -->
                                <div class="flex items-center gap-4">
                                    <div id="modalInisial"
                                        class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-bold text-lg shrink-0">
                                        BS</div>
                                    <div>
                                        <p id="modalNama" class="font-poppins font-semibold text-gray-800 text-lg">-</p>
                                        <p id="modalNik" class="text-sm text-gray-500 font-mono">-</p>
                                    </div>
                                    <span id="modalStatusBadge"
                                        class="ml-auto shrink-0 px-3 py-1 rounded-full text-xs font-semibold">-</span>
                                </div> <!-- Seksi: Tab Bar Penyakit (PTM) -->
                                <div>
                                    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Daftar
                                        Pemeriksaan (Pilih Penyakit)</p>
                                    <div id="modalPtmTabBar"
                                        class="flex flex-wrap gap-2 pb-2 border-b border-slate-100">
                                        <!-- Diisi secara dinamis oleh JS -->
                                    </div>
                                </div>

                                <!-- Banner Peringatan Revisi (Dinamis) -->
                                <div id="modalRevisioBanner"
                                    class="hidden bg-red-50 border border-red-100 rounded-xl p-3.5 flex flex-col gap-2">
                                    <div class="flex items-center gap-2 text-red-700 text-sm font-semibold">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                            stroke-linecap="round" stroke-linejoin="round">
                                            <path
                                                d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" />
                                            <line x1="12" y1="9" x2="12" y2="13" />
                                            <line x1="12" y1="17" x2="12.01" y2="17" />
                                        </svg>
                                        Perlu Perbaikan Data
                                    </div>
                                    <p id="modalRevisiCatatan" class="text-xs text-red-600 font-medium"></p>
                                    <a id="modalRevisiLink" href="#"
                                        class="mt-1 px-3 py-2 bg-amber-500 hover:bg-amber-600 text-white rounded-xl text-center text-xs font-semibold transition-all inline-block max-w-[200px]">
                                        Perbaiki Data Sekarang
                                    </a>
                                </div>

                                <!-- Seksi: Hasil Pengukuran Spesifik (Dinamis) -->
                                <div>
                                    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Hasil
                                        Pengukuran Spesifik</p>
                                    <div id="modalHasilDinamis"
                                        class="bg-slate-50 rounded-xl p-4 border border-slate-100 space-y-2.5">
                                        <!-- Diisi oleh JS secara dinamis -->
                                    </div>
                                </div>

                                <!-- Seksi: Data Fisik Umum -->
                                <div>
                                    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Data
                                        Fisik Umum</p>
                                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                                        <div class="bg-slate-50 rounded-xl p-3 border border-slate-100">
                                            <p class="text-gray-400 text-xs mb-1">Berat Badan</p>
                                            <p id="modalBB" class="font-semibold text-gray-800 text-sm">-</p>
                                        </div>
                                        <div class="bg-slate-50 rounded-xl p-3 border border-slate-100">
                                            <p class="text-gray-400 text-xs mb-1">Tinggi Badan</p>
                                            <p id="modalTB" class="font-semibold text-gray-800 text-sm">-</p>
                                        </div>
                                        <div class="bg-slate-50 rounded-xl p-3 border border-slate-100">
                                            <p class="text-gray-400 text-xs mb-1">Gula Darah</p>
                                            <p id="modalGula" class="font-semibold text-gray-800 text-sm">-</p>
                                        </div>
                                        <div class="bg-slate-50 rounded-xl p-3 border border-slate-100">
                                            <p class="text-gray-400 text-xs mb-1">Kolesterol</p>
                                            <p id="modalKolesterol" class="font-semibold text-gray-800 text-sm">-</p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Seksi: Gaya Hidup -->
                                <div>
                                    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Gaya
                                        Hidup</p>
                                    <div class="grid grid-cols-2 gap-3">
                                        <div class="bg-slate-50 rounded-xl p-3 border border-slate-100">
                                            <p class="text-gray-400 text-xs mb-1">Merokok</p>
                                            <p id="modalMerokok" class="font-semibold text-gray-800 text-sm">-</p>
                                        </div>
                                        <div class="bg-slate-50 rounded-xl p-3 border border-slate-100">
                                            <p class="text-gray-400 text-xs mb-1">Aktivitas Fisik</p>
                                            <p id="modalAktivitas" class="font-semibold text-gray-800 text-sm">-</p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Seksi: Tindak Lanjut -->
                                <div>
                                    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Tindak
                                        Lanjut</p>
                                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                                        <div class="bg-slate-50 rounded-xl p-3 border border-slate-100">
                                            <p class="text-gray-400 text-xs mb-1">Edukasi</p>
                                            <span id="modalEdukasiStatus"
                                                class="inline-block px-2 py-0.5 rounded-md text-xs font-semibold">-</span>
                                        </div>
                                        <div class="bg-slate-50 rounded-xl p-3 border border-slate-100">
                                            <p class="text-gray-400 text-xs mb-1">Dapat Obat</p>
                                            <p id="modalObat" class="font-semibold text-gray-800 text-sm">-</p>
                                        </div>
                                        <div class="bg-slate-50 rounded-xl p-3 border border-slate-100">
                                            <p class="text-gray-400 text-xs mb-1">Dirujuk ke RS</p>
                                            <span id="modalRujukan"
                                                class="inline-block px-2 py-0.5 rounded-md text-xs font-semibold">-</span>
                                        </div>
                                    </div>
                                    <!-- Catatan Edukasi (muncul kalau ada) -->
                                    <div id="modalEdukasiBox"
                                        class="hidden mt-3 bg-blue-50 rounded-xl p-3 border border-blue-100">
                                        <p class="text-blue-400 text-xs mb-1 font-medium">Catatan Edukasi</p>
                                        <p id="modalEdukasiCatatan" class="text-blue-800 text-sm">-</p>
                                    </div>
                                </div>

                                <!-- Seksi: Validasi (muncul kalau sudah divalidasi) -->
                                <div id="seksiValidasi" class="hidden">
                                    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Hasil
                                        Validasi</p>
                                    <div class="grid grid-cols-2 gap-3">
                                        <div class="bg-slate-50 rounded-xl p-3 border border-slate-100">
                                            <p class="text-gray-400 text-xs mb-1">Tanggal Validasi</p>
                                            <p id="modalTglValidasi" class="font-semibold text-gray-800 text-sm">-</p>
                                        </div>
                                        <div class="bg-slate-50 rounded-xl p-3 border border-slate-100 col-span-1">
                                            <p class="text-gray-400 text-xs mb-1">Catatan Bidan</p>
                                            <p id="modalCatatanBidan" class="text-gray-700 text-sm">-</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Footer Modal -->
                            <div
                                class="px-6 py-4 border-t border-gray-100 flex justify-end bg-gray-50 rounded-b-2xl shrink-0">
                                <button onclick="closeDetailModal()"
                                    class="px-5 py-2.5 bg-[#2563EB] hover:bg-[#1D4ED8] text-white text-sm font-medium rounded-xl transition-all shadow-sm">
                                    Tutup
                                </button>
                            </div>
                        </div>
                    </div>

            </div>

            <script>
                // === SERVER-SIDE SEARCH & FILTER ===
                const searchInput = document.getElementById('searchInput');
                const statusFilter = document.getElementById('statusFilter');
                const ptmFilter = document.getElementById('ptmFilter');

                function goToServer() {
                    const q = searchInput.value.trim();
                    const status = statusFilter.value;
                    const ptm = ptmFilter.value;
                    window.location.href =
                        '/riwayat?search=' + encodeURIComponent(q) +
                        '&status=' + encodeURIComponent(status) +
                        '&ptm=' + encodeURIComponent(ptm) +
                        '&page=1';
                }

                // Debounce search — kirim ke server 500ms setelah berhenti mengetik
                let debounceTimer;
                searchInput.addEventListener('input', function () {
                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(goToServer, 500);
                });

                // Filter status langsung redirect
                statusFilter.addEventListener('change', goToServer);
                ptmFilter.addEventListener('change', goToServer);

                // Event listener untuk tombol lihat — baca dari data-* attribute
                document.addEventListener('click', function (e) {
                    const btn = e.target.closest('.btn-lihat');
                    if (!btn) return;
                    const nama = btn.dataset.nama;
                    const nik = btn.dataset.nik;
                    const tanggal = btn.dataset.tanggal;
                    const status = btn.dataset.status;
                    const pemeriksaan = JSON.parse(btn.dataset.pemeriksaan);

                    openDetailModal(nama, nik, tanggal, status, pemeriksaan);
                });

                let currentPemeriksaan = [];
                let activeExamIndex = 0;

                function openDetailModal(nama, nik, tanggal, status, pemeriksaan) {
                    // Simpan state global modal
                    currentPemeriksaan = pemeriksaan;

                    // Identitas
                    document.getElementById('modalNama').innerText = nama;
                    document.getElementById('modalNik').innerText = nik;
                    const words = nama.trim().split(' ');
                    document.getElementById('modalInisial').innerText =
                        (words.length >= 2 ? words[0][0] + words[1][0] : nama.substring(0, 2)).toUpperCase();

                    // Status badge (Gabungan)
                    const badge = document.getElementById('modalStatusBadge');
                    if (status === 'terverifikasi' || status === 'Valid') {
                        badge.className = 'ml-auto shrink-0 px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-700';
                        badge.innerText = 'Valid';
                    } else if (status === 'revisi' || status === 'Perlu Revisi') {
                        badge.className = 'ml-auto shrink-0 px-3 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-600';
                        badge.innerText = 'Perlu Revisi';
                    } else {
                        badge.className = 'ml-auto shrink-0 px-3 py-1 rounded-full text-xs font-semibold bg-yellow-100 text-yellow-700';
                        badge.innerText = 'Menunggu Validasi';
                    }

                    // Render Tab Bar
                    const tabBar = document.getElementById('modalPtmTabBar');
                    tabBar.innerHTML = '';

                    pemeriksaan.forEach((p, idx) => {
                        const PTM_LABELS = {
                            hipertensi: 'Hipertensi', dm: 'Diabetes Melitus', obesitas: 'Obesitas',
                            ppok: 'PPOK', gangguan_indra: 'Gangguan Indra', kesehatan_jiwa: 'Kesehatan Jiwa'
                        };
                        const label = PTM_LABELS[p.id_jenis_ptm] || p.nama_ptm;

                        const btn = document.createElement('button');
                        btn.type = 'button';
                        btn.className = 'px-3 py-1.5 rounded-xl text-xs font-medium border transition-all flex items-center gap-1';

                        // Tambah dot status di tab
                        if (p.status_validasi === 'revisi') {
                            btn.innerHTML = `${label} <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>`;
                        } else if (p.status_validasi === 'terverifikasi') {
                            btn.innerHTML = `${label} <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>`;
                        } else {
                            btn.innerHTML = `${label} <span class="w-1.5 h-1.5 rounded-full bg-yellow-500"></span>`;
                        }

                        btn.onclick = () => selectExamTab(idx);
                        btn.setAttribute('data-tab-idx', idx);
                        tabBar.appendChild(btn);
                    });

                    // Pilih tab pertama secara default
                    selectExamTab(0);

                    const modal = document.getElementById('detailModal');
                    modal.classList.remove('hidden');
                    modal.classList.add('flex');
                }

                function selectExamTab(idx) {
                    activeExamIndex = idx;
                    const p = currentPemeriksaan[idx];
                    if (!p) return;

                    // Update status keaktifan tab style
                    const tabs = document.querySelectorAll('#modalPtmTabBar button');
                    tabs.forEach((t, i) => {
                        if (i === idx) {
                            t.className = 'px-3 py-1.5 rounded-xl text-xs font-semibold border border-blue-500 bg-blue-50 text-blue-700 transition-all flex items-center gap-1';
                        } else {
                            t.className = 'px-3 py-1.5 rounded-xl text-xs font-medium border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 transition-all flex items-center gap-1';
                        }
                    });

                    // Banner Revisi
                    const banner = document.getElementById('modalRevisioBanner');
                    if (p.status_validasi === 'revisi') {
                        banner.classList.remove('hidden');
                        document.getElementById('modalRevisiCatatan').innerText = p.catatan_bidan && p.catatan_bidan.trim() !== ''
                            ? p.catatan_bidan
                            : 'Bidan meminta perbaikan data untuk pemeriksaan ini.';
                        document.getElementById('modalRevisiLink').href = `/skrining/edit/${p.id_skrining}`;
                    } else {
                        banner.classList.add('hidden');
                    }

                    // Hasil Pengukuran Spesifik (Dinamis)
                    const baris = (label, value) =>
                        `<div class="flex justify-between text-sm"><span class="text-[#6B7280]">${label}</span><span class="text-[#1F2937] font-medium">${value}</span></div>`;

                    let html = '';
                    if (p.id_jenis_ptm === 'hipertensi') {
                        let kat = p.ht_status_tekanan || p.status_tekanan, katColor = 'text-[#059669]';
                        if (kat === 'Prehipertensi') katColor = 'text-[#D97706]';
                        else if (kat === 'Hipertensi Tahap 1') katColor = 'text-[#EA580C]';
                        else if (kat && kat !== 'Normal' && kat !== 'Terkendali') katColor = 'text-[#DC2626]';
                        html += baris('Sistole / Diastole', `${p.sistole}/${p.diastole} mmHg`);
                        html += `<div class="flex justify-between text-sm items-center"><span class="text-[#6B7280]">Kategori TD</span><span class="text-sm font-semibold ${katColor}">${kat || 'Normal'}</span></div>`;
                    } else if (p.id_jenis_ptm === 'dm') {
                        html += baris('Gula Darah', `${p.dm_gula_darah || '-'} mg/dL`);
                        html += baris('Jenis Pemeriksaan', p.dm_jenis_pemeriksaan || '-');
                        html += baris('Kategori Hasil', p.dm_kategori_hasil || '-');
                    } else if (p.id_jenis_ptm === 'obesitas') {
                        html += baris('Berat / Tinggi', `${p.ob_berat_badan || '-'} kg / ${p.ob_tinggi_badan || '-'} cm`);
                        html += baris('IMT', p.ob_imt ? `${parseFloat(p.ob_imt).toFixed(1)} kg/m²` : '-');
                        html += baris('Lingkar Perut', p.ob_lingkar_perut ? `${p.ob_lingkar_perut} cm` : '-');
                        html += baris('Kategori Obesitas', p.ob_kategori_obesitas || '-');
                    } else if (p.id_jenis_ptm === 'ppok') {
                        html += baris('Rokok / Hari', `${p.pp_rokok_per_hari || '0'} batang`);
                        html += baris('Lama Merokok', `${p.pp_lama_merokok || '0'} tahun`);
                        html += baris('Sesak Napas', p.pp_sesak_napas ? 'Ya' : 'Tidak');
                        html += baris('Batuk Berdahak Kronis', p.pp_batuk_kronis ? 'Ya' : 'Tidak');
                        html += baris('Skor Total PUMA', p.pp_skor_total || '0');
                        html += baris('Kategori Risiko', p.pp_kategori_risiko || 'Rendah');
                        html += baris('Rujukan Spirometri', p.pp_rujukan_spirometri ? 'Ya' : 'Tidak');
                    } else if (p.id_jenis_ptm === 'gangguan_indra') {
                        html += baris('Hasil Pemeriksaan Mata', p.gi_mata || 'Normal');
                        html += baris('Hasil Pemeriksaan Telinga', p.gi_telinga || 'Normal');
                        html += baris('Keterangan', p.gi_keterangan || '-');
                    } else if (p.id_jenis_ptm === 'kesehatan_jiwa') {
                        html += baris('Skor SRQ-20', `${p.kj_skor_total || '0'}/20`);
                        html += baris('Kategori Hasil', p.kj_kategori_hasil || '-');
                        html += baris('Indikasi Risiko Bunuh Diri', p.kj_risiko_bunuh_diri ? 'Ya' : 'Tidak');
                    } else {
                        html += baris('Data', '-');
                    }
                    document.getElementById('modalHasilDinamis').innerHTML = html;

                    // Data Fisik Umum
                    document.getElementById('modalBB').innerText = p.berat_badan && p.berat_badan !== 'null' ? p.berat_badan + ' kg' : '-';
                    document.getElementById('modalTB').innerText = p.tinggi_badan && p.tinggi_badan !== 'null' ? p.tinggi_badan + ' cm' : '-';
                    document.getElementById('modalGula').innerText = p.gula_darah && p.gula_darah !== 'null' ? p.gula_darah + ' mg/dL' : '-';
                    document.getElementById('modalKolesterol').innerText = p.kolesterol && p.kolesterol !== 'null' ? p.kolesterol + ' mg/dL' : '-';

                    // Gaya Hidup
                    document.getElementById('modalMerokok').innerText = p.merokok ? 'Ya' : 'Tidak';
                    document.getElementById('modalAktivitas').innerText = p.aktivitas_fisik || '-';

                    // Edukasi
                    const eduStatus = document.getElementById('modalEdukasiStatus');
                    const eduBox = document.getElementById('modalEdukasiBox');
                    if (p.edukasi && p.edukasi.trim() !== '') {
                        eduStatus.innerText = 'Ada';
                        eduStatus.className = 'inline-block px-2 py-0.5 rounded-md text-xs font-semibold bg-green-100 text-green-700';
                        eduBox.classList.remove('hidden');
                        document.getElementById('modalEdukasiCatatan').innerText = p.edukasi;
                    } else {
                        eduStatus.innerText = 'Tidak';
                        eduStatus.className = 'inline-block px-2 py-0.5 rounded-md text-xs font-semibold bg-gray-100 text-gray-500';
                        eduBox.classList.add('hidden');
                    }

                    // Dapat Obat
                    const obatMap = {
                        'tidak': 'Tidak',
                        'beli_sendiri': 'Beli Sendiri',
                        'dari_puskesmas': 'Dari Puskesmas',
                        'dari_rumah_sakit': 'Dari Rumah Sakit'
                    };
                    document.getElementById('modalObat').innerText = obatMap[p.dapat_obat] || 'Tidak';

                    // Rujukan
                    const rujEl = document.getElementById('modalRujukan');
                    if (p.status_rujukan === 'iya') {
                        rujEl.innerText = 'Iya — Dirujuk ke RS';
                        rujEl.className = 'inline-block px-2 py-0.5 rounded-md text-xs font-semibold bg-orange-100 text-orange-600';
                    } else {
                        rujEl.innerText = 'Tidak';
                        rujEl.className = 'inline-block px-2 py-0.5 rounded-md text-xs font-semibold bg-gray-100 text-gray-500';
                    }

                    // Seksi Validasi (hanya muncul jika divalidasi/ditolak)
                    const seksiVal = document.getElementById('seksiValidasi');
                    if (p.status_validasi === 'terverifikasi' || p.status_validasi === 'revisi') {
                        seksiVal.classList.remove('hidden');
                        document.getElementById('modalTglValidasi').innerText = p.tanggal_validasi ? new Date(p.tanggal_validasi).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) : '-';
                        document.getElementById('modalCatatanBidan').innerText = p.catatan_bidan && p.catatan_bidan.trim() !== '' ? p.catatan_bidan : 'Tidak ada catatan';
                    } else {
                        seksiVal.classList.add('hidden');
                    }
                }

                function closeDetailModal() {
                    const modal = document.getElementById('detailModal');
                    modal.classList.add('hidden');
                    modal.classList.remove('flex');
                }
            </script>

            <%- include('../partials/profil') %>

    </div>
</body>

</html>