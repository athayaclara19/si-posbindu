<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Skrining - Kader</title>
    <link rel="stylesheet" href="/css/output.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        /* CSS Tambahan untuk menyembunyikan panah atas-bawah di input angka */
        input[type=number]::-webkit-inner-spin-button, 
        input[type=number]::-webkit-outer-spin-button { 
            -webkit-appearance: none; 
            margin: 0; 
        }
        input[type=number] {
            -moz-appearance: textfield; /* Untuk Firefox */
        }
    </style>
</head>
<body class="bg-slate-50 font-inter antialiased text-slate-800">
    
    <div class="app-shell">
    <%- include('../partials/sidebar', { active: 'riwayat' }) %>

    <div class="main-content-wrapper">
        <%- include('../partials/header', { pageTitle: 'Perbaikan Data Skrining' }) %>

        <main class="p-8 w-full max-w-3xl mx-auto">
            
            <div class="mb-6 flex items-center gap-4">
                <a href="/riwayat" class="w-10 h-10 rounded-full bg-white border border-gray-200 flex items-center justify-center text-gray-500 hover:bg-gray-50 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                </a>
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 font-poppins">Perbaikan Data Skrining</h2>
                    <p class="text-gray-500 text-sm mt-1">Pasien: <span class="font-semibold text-gray-800"><%= skrining.nama_pasien %></span> (<%= skrining.nik %>)</p>
                </div>
            </div>

            <div class="mb-6 bg-[#FEF3C7] border border-[#F59E0B] rounded-2xl p-5 flex gap-4 items-start shadow-sm">
                <div class="w-10 h-10 rounded-full bg-[#F59E0B]/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#D97706]"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                </div>
                <div>
                    <h3 class="text-[#D97706] font-bold text-sm mb-1 uppercase tracking-wider">Catatan Perbaikan dari Bidan:</h3>
                    <p class="text-gray-800 text-sm leading-relaxed"><%= skrining.catatan_bidan %></p>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8">
                <form action="/skrining/edit/<%= skrining.id_skrining %>" method="POST" class="space-y-6">
                    
                    <% if (skrining.id_jenis_ptm === 'hipertensi') { %>
                        <!-- Seksi Hipertensi -->
                        <div>
                            <h3 class="text-lg font-semibold text-gray-800 mb-4 border-b pb-2">Hasil Pemeriksaan Tensi</h3>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Tekanan Sistole <span class="text-red-500">*</span></label>
                                    <div class="flex items-center rounded-xl border border-gray-200 bg-gray-50 overflow-hidden focus-within:border-[#2563EB] focus-within:bg-white transition-all">
                                        <input type="number" name="sistole" value="<%= skrining.sistole %>" class="w-full px-4 py-2.5 bg-transparent text-sm outline-none" required>
                                        <span class="px-4 py-2.5 bg-gray-100 border-l border-gray-200 text-gray-500 text-sm whitespace-nowrap">mmHg</span>
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Tekanan Diastole <span class="text-red-500">*</span></label>
                                    <div class="flex items-center rounded-xl border border-gray-200 bg-gray-50 overflow-hidden focus-within:border-[#2563EB] focus-within:bg-white transition-all">
                                        <input type="number" name="diastole" value="<%= skrining.diastole %>" class="w-full px-4 py-2.5 bg-transparent text-sm outline-none" required>
                                        <span class="px-4 py-2.5 bg-gray-100 border-l border-gray-200 text-gray-500 text-sm whitespace-nowrap">mmHg</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } else if (skrining.id_jenis_ptm === 'dm') { %>
                        <!-- Seksi Diabetes Melitus -->
                        <div>
                            <h3 class="text-lg font-semibold text-gray-800 mb-4 border-b pb-2">Hasil Pemeriksaan Diabetes Melitus</h3>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Gula Darah <span class="text-red-500">*</span></label>
                                    <div class="flex items-center rounded-xl border border-gray-200 bg-gray-50 overflow-hidden focus-within:border-[#2563EB] focus-within:bg-white transition-all">
                                        <input type="number" name="dm_gula_darah" value="<%= skrining.dm_gula_darah || skrining.gula_darah %>" class="w-full px-4 py-2.5 bg-transparent text-sm outline-none" required>
                                        <span class="px-4 py-2.5 bg-gray-100 border-l border-gray-200 text-gray-500 text-sm whitespace-nowrap">mg/dL</span>
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Jenis Pemeriksaan</label>
                                    <select name="dm_jenis_pemeriksaan" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white transition-all">
                                        <option value="sewaktu" <%= skrining.dm_jenis_pemeriksaan === 'sewaktu' ? 'selected' : '' %>>Gula Darah Sewaktu (GDS)</option>
                                        <option value="puasa" <%= skrining.dm_jenis_pemeriksaan === 'puasa' ? 'selected' : '' %>>Gula Darah Puasa (GDP)</option>
                                        <option value="post_prandial" <%= skrining.dm_jenis_pemeriksaan === 'post_prandial' ? 'selected' : '' %>>Gula Darah 2 Jam Post Prandial (GD2PP)</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    <% } else if (skrining.id_jenis_ptm === 'obesitas') { %>
                        <!-- Seksi Obesitas -->
                        <div>
                            <h3 class="text-lg font-semibold text-gray-800 mb-4 border-b pb-2">Hasil Pemeriksaan Obesitas</h3>
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Berat Badan <span class="text-red-500">*</span></label>
                                    <div class="flex items-center rounded-xl border border-gray-200 bg-gray-50 overflow-hidden focus-within:border-[#2563EB] focus-within:bg-white transition-all">
                                        <input type="number" step="0.1" name="ob_berat_badan" value="<%= skrining.ob_berat_badan || skrining.berat_badan %>" class="w-full px-4 py-2.5 bg-transparent text-sm outline-none" required>
                                        <span class="px-4 py-2.5 bg-gray-100 border-l border-gray-200 text-gray-500 text-sm whitespace-nowrap">kg</span>
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Tinggi Badan <span class="text-red-500">*</span></label>
                                    <div class="flex items-center rounded-xl border border-gray-200 bg-gray-50 overflow-hidden focus-within:border-[#2563EB] focus-within:bg-white transition-all">
                                        <input type="number" name="ob_tinggi_badan" value="<%= skrining.ob_tinggi_badan || skrining.tinggi_badan %>" class="w-full px-4 py-2.5 bg-transparent text-sm outline-none" required>
                                        <span class="px-4 py-2.5 bg-gray-100 border-l border-gray-200 text-gray-500 text-sm whitespace-nowrap">cm</span>
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Lingkar Perut</label>
                                    <div class="flex items-center rounded-xl border border-gray-200 bg-gray-50 overflow-hidden focus-within:border-[#2563EB] focus-within:bg-white transition-all">
                                        <input type="number" step="0.1" name="ob_lingkar_perut" value="<%= skrining.ob_lingkar_perut %>" class="w-full px-4 py-2.5 bg-transparent text-sm outline-none">
                                        <span class="px-4 py-2.5 bg-gray-100 border-l border-gray-200 text-gray-500 text-sm whitespace-nowrap">cm</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } else if (skrining.id_jenis_ptm === 'ppok') { %>
                        <!-- Seksi PPOK -->
                        <div>
                            <h3 class="text-lg font-semibold text-gray-800 mb-4 border-b pb-2">Hasil Pemeriksaan PPOK</h3>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Jumlah Batang Rokok / Hari</label>
                                    <input type="number" name="pp_rokok_per_hari" value="<%= skrining.pp_rokok_per_hari || 0 %>" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white transition-all">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Lama Tahun Merokok</label>
                                    <input type="number" name="pp_lama_merokok" value="<%= skrining.pp_lama_merokok || 0 %>" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white transition-all">
                                </div>
                            </div>
                            <div class="space-y-3 mb-4">
                                <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
                                    <input type="checkbox" name="pp_sesak_napas" value="true" <%= skrining.pp_sesak_napas ? 'checked' : '' %> class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                                    <span>Sesak napas saat berjalan cepat atau mendaki sedikit</span>
                                </label>
                                <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
                                    <input type="checkbox" name="pp_batuk_kronis" value="true" <%= skrining.pp_batuk_kronis ? 'checked' : '' %> class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                                    <span>Mengalami batuk berdahak secara kronis</span>
                                </label>
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Skor Total PUMA</label>
                                    <input type="number" name="pp_skor_total" value="<%= skrining.pp_skor_total || 0 %>" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white transition-all">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Kategori Risiko</label>
                                    <select name="pp_kategori_risiko" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white transition-all">
                                        <option value="Rendah" <%= skrining.pp_kategori_risiko === 'Rendah' ? 'selected' : '' %>>Rendah</option>
                                        <option value="Tinggi" <%= skrining.pp_kategori_risiko === 'Tinggi' ? 'selected' : '' %>>Tinggi (Rujuk Spirometri)</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    <% } else if (skrining.id_jenis_ptm === 'gangguan_indra') { %>
                        <!-- Seksi Gangguan Indra -->
                        <div>
                            <h3 class="text-lg font-semibold text-gray-800 mb-4 border-b pb-2">Hasil Pemeriksaan Gangguan Indra</h3>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Pemeriksaan Mata (Tajam Penglihatan)</label>
                                    <select name="gi_mata" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white transition-all">
                                        <option value="Normal" <%= skrining.gi_mata === 'Normal' ? 'selected' : '' %>>Normal</option>
                                        <option value="Gangguan" <%= skrining.gi_mata === 'Gangguan' ? 'selected' : '' %>>Ada Gangguan</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Pemeriksaan Telinga (Tajam Pendengaran)</label>
                                    <select name="gi_telinga" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white transition-all">
                                        <option value="Normal" <%= skrining.gi_telinga === 'Normal' ? 'selected' : '' %>>Normal</option>
                                        <option value="Gangguan" <%= skrining.gi_telinga === 'Gangguan' ? 'selected' : '' %>>Ada Gangguan</option>
                                    </select>
                                </div>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5">Keterangan Tambahan</label>
                                <textarea name="gi_keterangan" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white transition-all h-20 resize-none"><%= skrining.gi_keterangan %></textarea>
                            </div>
                        </div>
                    <% } else if (skrining.id_jenis_ptm === 'kesehatan_jiwa') { %>
                        <!-- Seksi Kesehatan Jiwa -->
                        <div>
                            <h3 class="text-lg font-semibold text-gray-800 mb-4 border-b pb-2">Hasil Pemeriksaan Kesehatan Jiwa (SRQ-20)</h3>
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Skor SRQ-20 (0 - 20)</label>
                                    <input type="number" min="0" max="20" name="kj_skor_total" value="<%= skrining.kj_skor_total || 0 %>" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white transition-all" required>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Kategori Hasil</label>
                                    <select name="kj_kategori_hasil" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white transition-all">
                                        <option value="Normal" <%= skrining.kj_kategori_hasil === 'Normal' ? 'selected' : '' %>>Normal</option>
                                        <option value="Depresi / Cemas" <%= skrining.kj_kategori_hasil === 'Depresi / Cemas' ? 'selected' : '' %>>Indikasi Gangguan Mental Emosional</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Risiko Bunuh Diri</label>
                                    <select name="kj_risiko_bunuh_diri" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white transition-all">
                                        <option value="Tidak" <%= !skrining.kj_risiko_bunuh_diri ? 'selected' : '' %>>Tidak Ada</option>
                                        <option value="Ya" <%= skrining.kj_risiko_bunuh_diri ? 'selected' : '' %>>Ada Risiko</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    <% } %>

                    <!-- Seksi Data Umum (Gaya Hidup & Tindak Lanjut) -->
                    <div>
                        <h3 class="text-lg font-semibold text-gray-800 mb-4 border-b pb-2">Informasi Umum Gaya Hidup & Tindak Lanjut</h3>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-5">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5">Apakah Merokok?</label>
                                <select name="merokok" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white transition-all">
                                    <option value="Tidak" <%= !skrining.merokok ? 'selected' : '' %>>Tidak</option>
                                    <option value="Ya" <%= skrining.merokok ? 'selected' : '' %>>Ya</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5">Aktivitas Fisik</label>
                                <select name="aktivitas_fisik" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white transition-all">
                                    <option value="aktif" <%= skrining.aktivitas_fisik === 'aktif' || skrining.aktivitas_fisik === 'Aktif' ? 'selected' : '' %>>Aktif (≥ 30 menit/hari)</option>
                                    <option value="tidak_aktif" <%= skrining.aktivitas_fisik === 'tidak_aktif' || skrining.aktivitas_fisik === 'Tidak Aktif' ? 'selected' : '' %>>Tidak Aktif</option>
                                </select>
                            </div>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5">Edukasi Diberikan</label>
                                <input type="text" name="edukasi" value="<%= skrining.edukasi %>" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white transition-all" placeholder="Edukasi diet, olahraga dll...">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5">Mendapat Obat</label>
                                <select name="dapat_obat" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white transition-all">
                                    <option value="tidak" <%= skrining.dapat_obat === 'tidak' ? 'selected' : '' %>>Tidak</option>
                                    <option value="beli_sendiri" <%= skrining.dapat_obat === 'beli_sendiri' ? 'selected' : '' %>>Beli Sendiri</option>
                                    <option value="dari_puskesmas" <%= skrining.dapat_obat === 'dari_puskesmas' ? 'selected' : '' %>>Dari Puskesmas</option>
                                    <option value="dari_rumah_sakit" <%= skrining.dapat_obat === 'dari_rumah_sakit' ? 'selected' : '' %>>Dari Rumah Sakit</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5">Dirujuk ke FKTl/RS</label>
                                <select name="status_rujukan" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white transition-all">
                                    <option value="tidak" <%= skrining.status_rujukan === 'tidak' ? 'selected' : '' %>>Tidak</option>
                                    <option value="iya" <%= skrining.status_rujukan === 'iya' ? 'selected' : '' %>>Ya</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="pt-6 border-t border-gray-100 flex justify-end gap-3">
                        <a href="/riwayat" class="px-6 py-2.5 rounded-xl text-sm font-medium border border-gray-200 text-gray-600 hover:bg-gray-50 transition-all">Batal</a>
                        <button type="submit" class="px-6 py-2.5 rounded-xl text-sm font-medium bg-[#F59E0B] text-white hover:bg-[#D97706] transition-all shadow-sm flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                            Kirim Ulang ke Bidan
                        </button>
                    </div>

                </form>
            </div>

        </main>
    </div>

<%- include('../partials/profil') %>

</div>
</body>
</html>