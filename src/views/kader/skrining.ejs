<!--
  =================================================================
  CATATAN PENTING (baca dulu sebelum dipakai):
  File ini adalah VIEW baru untuk form skrining multi-PTM.
  Backend-nya (controller kaderControllers.js -> handleInputSkrining)
  BELUM disesuaikan untuk menerima payload multi-PTM ini -- itu
  pekerjaan lanjutan setelah dapat konfirmasi dari dospem.

  Untuk sekarang, file ini AMAN dipakai untuk:
  - didemokan ke dospem (render tampilannya persis, checklist + field
    dinamis + preview data jalan semua)
  - jadi acuan struktur nama field (name="...") buat nanti controller-nya
    dibuat menyesuaikan

  Kalau langsung disubmit ke /skrining sekarang, backend LAMA
  kaderControllers.js belum tau cara baca field-field baru ini
  (hipertensi[sistole], dm[gula_darah], dst) -- jadi submit beneran
  belum akan berhasil sampai controllernya diupdate.
  =================================================================
-->
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Input Skrining PTM - Kader</title>
    <link rel="stylesheet" href="/css/output.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.min.css" rel="stylesheet">
    <style>
        .font-poppins { font-family: 'Poppins', sans-serif; }
        .font-inter { font-family: 'Inter', sans-serif; }
        .hidden-step { display: none; }

        .ts-control {
            border-radius: 0.75rem !important;
            border-color: #E5E7EB !important;
            padding: 0.625rem 0.75rem 0.625rem 2.5rem !important;
            background-color: #F9FAFB !important;
            font-size: 0.875rem !important;
            min-height: 42px !important;
            display: flex !important;
            align-items: center !important;
        }
        .ts-wrapper.focus .ts-control {
            border-color: #2563EB !important;
            box-shadow: none !important;
            background-color: white !important;
        }
        .ts-dropdown {
            border-radius: 0.75rem !important;
            margin-top: 5px !important;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1) !important;
        }
        .ts-wrapper.single:not(.has-items) .ts-control input { width: 100% !important; }
        .ts-wrapper.single.has-items .ts-control input {
            width: 0 !important; opacity: 0 !important; margin: 0 !important; padding: 0 !important;
        }

        .obat-card, .rujuk-card, .yatidak-card {
            border: 2px solid #E5E7EB !important;
            background-color: #ffffff !important;
            transition: border-color 0.15s, background-color 0.15s;
        }
        .obat-card.aktif, .rujuk-card.aktif, .yatidak-card.aktif {
            border: 2px solid #2563EB !important;
            background-color: #EFF6FF !important;
        }

        .ptm-detail { display: none; }
        .ptm-detail.show { display: block; }

        .srq-row {
            display: flex; align-items: center; justify-content: space-between;
            padding: 10px 12px; border-bottom: 1px solid #F3F4F6;
        }
        .srq-row:last-child { border-bottom: none; }
        .toggle-yatidak label {
            cursor: pointer; padding: 6px 14px; border-radius: 8px; font-size: 12px;
            font-weight: 600; border: 1.5px solid #E5E7EB; color: #6B7280;
        }
        .toggle-yatidak input:checked + label { background: #2563EB; border-color: #2563EB; color: #fff; }
    </style>
</head>
<body class="bg-slate-50 font-inter antialiased text-slate-800">

    <div class="app-shell">
    <%- include('../partials/sidebar', { active: 'skrining' }) %>

    <div class="main-content-wrapper">
        <%- include('../partials/header', { pageTitle: 'Input Skrining PTM' }) %>

        <main class="p-8 w-full">
            <div class="w-full space-y-6">

                <div id="form-header">
                    <h2 class="text-[#1F2937] font-poppins font-semibold text-xl">Form Input Skrining PTM</h2>
                    <p class="text-[#6B7280] text-sm">Satu kunjungan pasien bisa langsung mencatat beberapa jenis PTM sekaligus</p>
                </div>

                <div id="stepper-container" class="bg-white rounded-2xl border border-gray-100 shadow-sm px-6 py-4">
                    <div class="flex items-center gap-2">
                        <div class="flex items-center gap-2">
                            <div id="step-circle-1" class="w-7 h-7 rounded-full flex items-center justify-center text-xs flex-shrink-0 transition-all bg-[#2563EB] text-white font-semibold">1</div>
                            <span id="step-text-1" class="text-xs hidden sm:block text-[#2563EB] font-semibold">Data Pasien</span>
                        </div>
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-300 flex-shrink-0"><polyline points="9 18 15 12 9 6"></polyline></svg>

                        <div class="flex items-center gap-2">
                            <div id="step-circle-2" class="w-7 h-7 rounded-full flex items-center justify-center text-xs flex-shrink-0 transition-all bg-gray-200 text-gray-500 font-semibold">2</div>
                            <span id="step-text-2" class="text-xs hidden sm:block text-[#6B7280]">Jenis PTM & Hasil</span>
                        </div>
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-300 flex-shrink-0"><polyline points="9 18 15 12 9 6"></polyline></svg>

                        <div class="flex items-center gap-2">
                            <div id="step-circle-3" class="w-7 h-7 rounded-full flex items-center justify-center text-xs flex-shrink-0 transition-all bg-gray-200 text-gray-500 font-semibold">3</div>
                            <span id="step-text-3" class="text-xs hidden sm:block text-[#6B7280]">Faktor Risiko & Edukasi</span>
                        </div>
                    </div>
                </div>

                <form id="skrining-form" action="/skrining" method="POST">
                    <!-- ============== STEP 1 — DATA PASIEN (sama seperti form asli) ============== -->
                    <div id="step-1" class="bg-white rounded-2xl border border-gray-100 shadow-sm">
                        <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#2563EB]"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            <h3 class="text-[#1F2937] font-poppins font-semibold">Step 1 — Data Pasien</h3>
                        </div>
                        <div class="px-6 py-5 space-y-4">
                            <div>
                                <label class="text-sm text-[#1F2937] mb-1.5 block font-medium">Pilih Pasien <span class="text-[#EF4444]">*</span></label>
                                <div class="relative">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 z-10 pointer-events-none"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                    <select id="input-pasien" name="id_pasien" placeholder="Cari Nama atau NIK Pasien..." autocomplete="off" style="display: none;">
                                        <option value=""></option>
                                        <% pasien.forEach(p => { %>
                                            <option
                                                value="<%= p.id_pasien %>"
                                                data-usia="<%= p.usia || '' %>"
                                                data-tahun-lahir="<%= p.tahun_lahir || '' %>"
                                                <%= (typeof selectedPasienId !== 'undefined' && selectedPasienId && String(p.id_pasien) === String(selectedPasienId)) ? 'selected' : '' %>>
                                                <%= p.nama_pasien %> (<%= p.nik %>)
                                            </option>
                                        <% }) %>
                                    </select>
                                </div>
                            </div>

                            <div>
                                <label class="text-sm text-[#1F2937] mb-1.5 block font-medium">Kegiatan Posbindu <span class="text-[#EF4444]">*</span></label>
                                <select id="input-kegiatan" name="id_kegiatan" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-gray-50 focus:bg-white" onchange="updateTanggal()" required>
                                    <option value=""> Pilih kegiatan </option>
                                    <% if (typeof kegiatan !== 'undefined') { %>
                                        <%
                                        const today = new Date();
                                        today.setHours(0, 0, 0, 0);
                                        kegiatan.forEach(k => {
                                            const tglKegiatan = new Date(k.tanggal_kegiatan);
                                            tglKegiatan.setHours(0, 0, 0, 0);
                                            const formattedDate = k.tanggal_kegiatan
                                                ? new Date(k.tanggal_kegiatan).toISOString().split('T')[0]
                                                : '';
                                            if (tglKegiatan >= today) {
                                        %>
                                            <option value="<%= k.id_kegiatan %>" data-tanggal="<%= formattedDate %>">
                                                <%= k.lokasi %> (<%= formattedDate %>)
                                            </option>
                                        <%
                                            }
                                        })
                                        %>
                                    <% } %>
                                </select>
                            </div>

                            <div>
                                <label class="text-sm text-[#1F2937] mb-1.5 block font-medium">Tanggal Pemeriksaan <span class="text-[#EF4444]">*</span></label>
                                <input type="date" id="input-tanggal" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-gray-50 focus:bg-white" required readonly>
                            </div>
                        </div>
                        <div class="px-6 py-4 border-t border-gray-100 flex justify-end">
                            <button type="button" onclick="goToStep(2)" class="flex items-center gap-2 bg-[#2563EB] hover:bg-[#1D4ED8] text-white px-5 py-2.5 rounded-xl text-sm font-medium transition-all">
                                Lanjut <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                            </button>
                        </div>
                    </div>

                    <!-- ============== STEP 2 — CHECKLIST 6 PTM + FIELD DINAMIS (BARU) ============== -->
                    <div id="step-2" class="bg-white rounded-2xl border border-gray-100 shadow-sm hidden-step">
                        <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#2563EB]"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                            <h3 class="text-[#1F2937] font-poppins font-semibold">Step 2 — Pilih & Isi Jenis PTM</h3>
                        </div>
                        <div class="px-6 pt-5">
                            <p class="text-xs text-gray-400">Isi hasil pemeriksaan untuk seluruh jenis PTM di bawah ini.</p>
                        </div>

                        <div id="ptm-details" class="px-6 py-4 space-y-4"></div>

                        <div class="px-6 py-4 border-t border-gray-100 flex justify-between">
                            <button type="button" onclick="goToStep(1)" class="flex items-center gap-2 border border-gray-300 text-[#1F2937] px-5 py-2.5 rounded-xl text-sm font-medium hover:bg-gray-50 transition-all">← Kembali</button>
                            <button type="button" onclick="goToStep(3)" class="flex items-center gap-2 bg-[#2563EB] hover:bg-[#1D4ED8] text-white px-5 py-2.5 rounded-xl text-sm font-medium transition-all">Lanjut <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg></button>
                        </div>
                    </div>

                    <!-- ============== STEP 3 — FAKTOR RISIKO & EDUKASI (sama seperti form asli, berlaku umum) ============== -->
                    <div id="step-3" class="bg-white rounded-2xl border border-gray-100 shadow-sm hidden-step">
                        <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#2563EB]"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                            <h3 class="text-[#1F2937] font-poppins font-semibold">Step 3 — Faktor Risiko & Edukasi</h3>
                        </div>
                        <div class="px-6 py-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="text-sm text-[#1F2937] mb-1.5 block font-medium">Merokok</label>
                                <select name="merokok" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-gray-50 focus:bg-white">
                                    <option value="">-- Pilih --</option>
                                    <option value="true">Ya</option>
                                    <option value="false">Tidak</option>
                                </select>
                                <p id="merokok-auto-note" class="hidden text-xs text-blue-500 mt-1.5">🔒 Otomatis "Ya" — sudah ada data rokok di bagian PPOK</p>
                            </div>
                            <div>
                                <label class="text-sm text-[#1F2937] mb-1.5 block font-medium">Aktivitas Fisik</label>
                                <select name="aktivitas_fisik" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-gray-50 focus:bg-white">
                                    <option value="">-- Pilih --</option>
                                    <option value="Aktif">Aktif</option>
                                    <option value="Kurang Aktif">Kurang Aktif</option>
                                </select>
                            </div>

                            <div class="sm:col-span-2 border-t border-gray-100 pt-4 mt-1">
                                <label class="text-sm text-[#1F2937] mb-1.5 block font-semibold">Edukasi</label>
                                <p class="text-xs text-gray-400 mb-3">Status edukasi otomatis <b>Ada</b> jika catatan diisi, <b>Tidak</b> jika dikosongkan.</p>
                                <textarea id="input-edukasi" name="edukasi" rows="3"
                                    placeholder="Contoh: Edukasi diet rendah garam, anjuran olahraga rutin, kontrol tekanan darah rutin..."
                                    oninput="updateEdukasiStatus()"
                                    class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-gray-50 focus:bg-white resize-none"></textarea>
                                <div id="edukasi-status" class="mt-2 hidden flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full bg-green-400"></span>
                                    <span class="text-xs text-green-600 font-medium">Status Edukasi: <b>Ada</b></span>
                                </div>
                            </div>

                            <div class="sm:col-span-2 border-t border-gray-100 pt-4">
                                <label class="text-sm text-[#1F2937] mb-1.5 block font-semibold">Dapat Obat</label>
                                <p class="text-xs text-gray-400 mb-3">Pilih sumber obat yang diperoleh pasien setelah skrining.</p>
                                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3" id="obat-options">
                                    <label id="card-tidak" onclick="pilihObat('tidak')" class="obat-card aktif cursor-pointer rounded-xl p-3 flex flex-col items-center gap-2 text-center">
                                        <input type="radio" name="dapat_obat" value="tidak" class="hidden" checked>
                                        <span class="text-xs font-medium text-gray-600">Tidak Dapat</span>
                                    </label>
                                    <label id="card-beli_sendiri" onclick="pilihObat('beli_sendiri')" class="obat-card cursor-pointer rounded-xl p-3 flex flex-col items-center gap-2 text-center">
                                        <input type="radio" name="dapat_obat" value="beli_sendiri" class="hidden">
                                        <span class="text-xs font-medium text-gray-600">Beli Sendiri</span>
                                    </label>
                                    <label id="card-dari_puskesmas" onclick="pilihObat('dari_puskesmas')" class="obat-card cursor-pointer rounded-xl p-3 flex flex-col items-center gap-2 text-center">
                                        <input type="radio" name="dapat_obat" value="dari_puskesmas" class="hidden">
                                        <span class="text-xs font-medium text-gray-600">Dari Puskesmas</span>
                                    </label>
                                    <label id="card-dari_rumah_sakit" onclick="pilihObat('dari_rumah_sakit')" class="obat-card cursor-pointer rounded-xl p-3 flex flex-col items-center gap-2 text-center">
                                        <input type="radio" name="dapat_obat" value="dari_rumah_sakit" class="hidden">
                                        <span class="text-xs font-medium text-gray-600">Dari Rumah Sakit</span>
                                    </label>
                                </div>
                            </div>

                            <div class="sm:col-span-2 border-t border-gray-100 pt-4">
                                <label class="text-sm text-[#1F2937] mb-1.5 block font-semibold">Dirujuk ke Rumah Sakit?</label>
                                <div class="flex gap-3">
                                    <label id="rujuk-tidak" onclick="pilihRujukan('tidak')" class="rujuk-card aktif cursor-pointer flex-1 rounded-xl px-4 py-3 flex items-center gap-3">
                                        <input type="radio" name="status_rujukan" value="tidak" class="hidden" checked>
                                        <div><p class="text-sm font-medium text-gray-700">Tidak Dirujuk</p></div>
                                    </label>
                                    <label id="rujuk-iya" onclick="pilihRujukan('iya')" class="rujuk-card cursor-pointer flex-1 rounded-xl px-4 py-3 flex items-center gap-3">
                                        <input type="radio" name="status_rujukan" value="iya" class="hidden">
                                        <div><p class="text-sm font-medium text-orange-700">Dirujuk ke RS</p></div>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="px-6 py-4 border-t border-gray-100 flex justify-between">
                            <button type="button" onclick="goToStep(2)" class="flex items-center gap-2 border border-gray-300 text-[#1F2937] px-5 py-2.5 rounded-xl text-sm font-medium hover:bg-gray-50 transition-all">← Kembali</button>
                            <button type="button" onclick="submitData()" class="flex items-center gap-2 bg-[#2563EB] hover:bg-[#1D4ED8] text-white px-5 py-2.5 rounded-xl text-sm font-medium transition-all">
                                Kirim Data
                            </button>
                        </div>
                    </div>
                </form>

                <div id="step-success" class="hidden-step flex-col items-center justify-center min-h-[50vh] space-y-4 pt-10">
                    <div class="w-16 h-16 bg-[#D1FAE5] rounded-full flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#10B981]"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    </div>
                    <h2 class="text-[#1F2937] font-poppins font-semibold text-xl">Mengirim Data...</h2>
                    <p class="text-[#6B7280] text-sm text-center max-w-sm">Mohon tunggu sebentar.</p>
                </div>
            </div>
        </main>
    </div>

    <script>
        // ============== SETUP DASAR (sama seperti form asli) ==============
        function updateTanggal() {
            const selectKegiatan = document.getElementById('input-kegiatan');
            const inputTanggal = document.getElementById('input-tanggal');
            const selectedOption = selectKegiatan.options[selectKegiatan.selectedIndex];
            if (selectedOption && selectedOption.getAttribute('data-tanggal')) {
                inputTanggal.value = selectedOption.getAttribute('data-tanggal');
            } else {
                inputTanggal.value = '';
            }
        }

        const steps = [document.getElementById('step-1'), document.getElementById('step-2'), document.getElementById('step-3')];
        const indicators = [document.getElementById('step-circle-1'), document.getElementById('step-circle-2'), document.getElementById('step-circle-3')];
        const labels = [document.getElementById('step-text-1'), document.getElementById('step-text-2'), document.getElementById('step-text-3')];

        function showStep(stepIndex) {
            steps.forEach((step, index) => {
                if (index === stepIndex) {
                    step.classList.remove('hidden-step');
                    indicators[index].classList.remove('bg-gray-200', 'text-gray-500');
                    indicators[index].classList.add('bg-[#2563EB]', 'text-white', 'ring-4', 'ring-blue-100');
                    labels[index].classList.remove('text-gray-400');
                    labels[index].classList.add('text-[#2563EB]', 'font-bold');
                } else {
                    step.classList.add('hidden-step');
                    indicators[index].classList.add('bg-gray-200', 'text-gray-500');
                    indicators[index].classList.remove('bg-[#2563EB]', 'text-white', 'ring-4', 'ring-blue-100');
                    labels[index].classList.add('text-gray-400');
                    labels[index].classList.remove('text-[#2563EB]', 'font-bold');
                }
            });
        }

        function goToStep(step) {
            if (step === 2) {
                const p = document.getElementById('input-pasien').value;
                const k = document.getElementById('input-kegiatan').value;
                if (!p || !k) {
                    Swal.fire({ icon: 'warning', title: 'Data Belum Lengkap!', text: 'Pilih pasien dan kegiatan terlebih dahulu sebelum lanjut.', confirmButtonColor: '#2563EB', customClass: { popup: 'rounded-2xl font-inter' } });
                    return;
                }
            }
            showStep(step - 1);
        }

        function submitData() {
            document.getElementById('form-header').classList.add('hidden-step');
            document.getElementById('stepper-container').classList.add('hidden-step');
            document.getElementById('skrining-form').classList.add('hidden-step');
            document.getElementById('step-success').classList.remove('hidden-step');
            document.getElementById('step-success').classList.add('flex');
            setTimeout(() => { document.getElementById('skrining-form').submit(); }, 500);
        }

        function updateEdukasiStatus() {
            const val = document.getElementById("input-edukasi").value.trim();
            const status = document.getElementById("edukasi-status");
            if (val.length > 0) { status.classList.remove("hidden"); } else { status.classList.add("hidden"); }
        }

        const nilaiObat = ['tidak', 'beli_sendiri', 'dari_puskesmas', 'dari_rumah_sakit'];
        function pilihObat(nilai) {
            document.querySelector('input[name="dapat_obat"][value="' + nilai + '"]').checked = true;
            nilaiObat.forEach(function(v) { document.getElementById('card-' + v).classList.remove('aktif'); });
            document.getElementById('card-' + nilai).classList.add('aktif');
        }

        function pilihRujukan(nilai) {
            document.querySelector('input[name="status_rujukan"][value="' + nilai + '"]').checked = true;
            document.getElementById('rujuk-tidak').classList.remove('aktif');
            document.getElementById('rujuk-iya').classList.remove('aktif');
            document.getElementById('rujuk-' + nilai).classList.add('aktif');
        }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>
    <script>
        new TomSelect("#input-pasien", {
            create: false,
            sortField: { field: "text", direction: "asc" },
            render: {
                option: function(data, escape) {
                    return '<div class="py-2 px-3"> <div class="font-medium">' + escape(data.text) + '</div> </div>';
                }
            }
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- ============== BAGIAN BARU: CHECKLIST 6 PTM + FIELD DINAMIS ============== -->
    <script>
        const PTM_LIST = [
            { id: 'hipertensi', label: 'Hipertensi', icon: '❤️' },
            { id: 'dm', label: 'Diabetes Melitus', icon: '🩸' },
            { id: 'obesitas', label: 'Obesitas', icon: '⚖️' },
            { id: 'ppok', label: 'PPOK', icon: '🫁' },
            { id: 'gangguan_indra', label: 'Gangguan Indra', icon: '👁️' },
            { id: 'kesehatan_jiwa', label: 'Kesehatan Jiwa', icon: '🧠' },
        ];

        const detailsEl = document.getElementById('ptm-details');

        // Semua jenis PTM selalu diperiksa, jadi kirim semuanya sebagai hidden input
        PTM_LIST.forEach(ptm => {
            const hidden = document.createElement('input');
            hidden.type = 'hidden';
            hidden.name = 'jenis_ptm[]';
            hidden.value = ptm.id;
            detailsEl.appendChild(hidden);
        });

        function detailWrapper(id, title, innerHTML) {
            const div = document.createElement('div');
            div.id = 'detail-' + id;
            div.className = 'ptm-detail show bg-[#F9FAFB] rounded-2xl border border-gray-100 mt-2';
            div.innerHTML =
                '<div class="px-5 py-3 border-b border-gray-100"><h4 class="text-[#1F2937] font-poppins font-semibold text-sm">' + title + '</h4></div>' +
                '<div class="px-5 py-4 space-y-4">' + innerHTML + '</div>';
            detailsEl.appendChild(div);
        }

        // -- HIPERTENSI --
        detailWrapper('hipertensi', 'Detail Hipertensi', `
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="text-sm text-[#1F2937] mb-1.5 block font-medium">Sistole (mmHg)</label>
                    <input type="number" id="ht-sistole" name="hipertensi[sistole]" placeholder="120" oninput="checkBP()" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white">
                </div>
                <div>
                    <label class="text-sm text-[#1F2937] mb-1.5 block font-medium">Diastole (mmHg)</label>
                    <input type="number" id="ht-diastole" name="hipertensi[diastole]" placeholder="80" oninput="checkBP()" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white">
                </div>
            </div>
            <div id="ht-badge-mode" class="hidden mb-2"></div>
            <div id="ht-badge" class="hidden rounded-xl border-2 p-3 text-sm font-semibold"></div>
        `);

        // =====================================================================
        // Fungsi klasifikasi tekanan darah sesuai Pedoman Kemenkes 2024
        // Dewasa (≥18 th): 7 kategori (Tabel 2.1 ESC/ESH via Kemenkes)
        // Anak (<18 th): 4 kategori (Tabel 2.2 AAP 2017 via Kemenkes)
        // Diporting dari form skrining lama supaya pengkategoriannya konsisten.
        // =====================================================================
        function getUsiaFromPasien() {
            const select = document.getElementById('input-pasien');
            const selectedOption = select.options[select.selectedIndex];
            if (!selectedOption || !selectedOption.value) return null;

            const usia = parseInt(selectedOption.getAttribute('data-usia'));
            if (!isNaN(usia) && usia > 0) return usia;

            const tahunLahir = parseInt(selectedOption.getAttribute('data-tahun-lahir'));
            if (!isNaN(tahunLahir) && tahunLahir > 0) {
                return new Date().getFullYear() - tahunLahir;
            }
            return null; // tidak diketahui -> asumsikan dewasa
        }

        // Peta ikon, warna badge, dan warna wrapper per kategori (persis dari form lama)
        const KATEGORI_IKON = {
            'Optimal': '&#128994;', 'Normal': '&#128309;',
            'Prehipertensi (Normal Tinggi)': '&#128993;',
            'Hipertensi Derajat 1': '&#128992;', 'Hipertensi Derajat 2': '&#128308;',
            'Hipertensi Derajat 3': '&#128721;', 'Hipertensi Sistolik Terisolasi': '&#128310;',
            'Tekanan Darah Normal': '&#128994;', 'Pre Hipertensi': '&#128993;',
            'Hipertensi Tingkat 1': '&#128992;', 'Hipertensi Tingkat 2': '&#128308;',
        };
        const KATEGORI_WARNA = {
            'Optimal':                        { bg:'#ECFDF5', color:'#065F46', border:'#6EE7B7' },
            'Normal':                         { bg:'#EFF6FF', color:'#1E40AF', border:'#93C5FD' },
            'Prehipertensi (Normal Tinggi)':  { bg:'#FFFBEB', color:'#92400E', border:'#FCD34D' },
            'Hipertensi Derajat 1':           { bg:'#FFF7ED', color:'#9A3412', border:'#FDBA74' },
            'Hipertensi Derajat 2':           { bg:'#FEF2F2', color:'#991B1B', border:'#FCA5A5' },
            'Hipertensi Derajat 3':           { bg:'#FEE2E2', color:'#7F1D1D', border:'#F87171' },
            'Hipertensi Sistolik Terisolasi': { bg:'#F5F3FF', color:'#5B21B6', border:'#C4B5FD' },
            'Tekanan Darah Normal':           { bg:'#ECFDF5', color:'#065F46', border:'#6EE7B7' },
            'Pre Hipertensi':                 { bg:'#FFFBEB', color:'#92400E', border:'#FCD34D' },
            'Hipertensi Tingkat 1':           { bg:'#FFF7ED', color:'#9A3412', border:'#FDBA74' },
            'Hipertensi Tingkat 2':           { bg:'#FEF2F2', color:'#991B1B', border:'#FCA5A5' },
        };

        function checkBP() {
            const sysVal = document.getElementById('ht-sistole').value;
            const diaVal = document.getElementById('ht-diastole').value;
            const sys = parseInt(sysVal);
            const dia = parseInt(diaVal);
            const badge = document.getElementById('ht-badge');
            const modeBadge = document.getElementById('ht-badge-mode');

            if (!sysVal || !diaVal || isNaN(sys) || isNaN(dia)) {
                badge.classList.add('hidden');
                modeBadge.classList.add('hidden');
                return;
            }

            const usia = getUsiaFromPasien();
            const isAnak = (usia !== null && usia < 18);

            let kategori = '', pesan = '';

            if (isAnak) {
                // -- ANAK (< 18 tahun) -- Tabel 2.2 Kemenkes 2024 (AAP 2017)
                modeBadge.textContent = `Anak (${usia} th)`;
                modeBadge.className = 'inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-purple-100 text-purple-600 border border-purple-200';

                if (usia >= 13) {
                    if (sys >= 140 || dia >= 90) {
                        kategori = 'Hipertensi Tingkat 2';
                        pesan = `Anak ≥13 th: Sistolik ≥140 atau Diastolik ≥90 mmHg. Rujuk ke FKRTL.`;
                    } else if ((sys >= 130 && sys <= 139) || (dia >= 80 && dia <= 89)) {
                        kategori = 'Hipertensi Tingkat 1';
                        pesan = `Anak ≥13 th: Sistolik 130–138 atau Diastolik 80–89 mmHg. Perlu tatalaksana dan monitoring.`;
                    } else if ((sys >= 120 && sys < 130) || (dia >= 80 && dia < 80)) {
                        kategori = 'Pre Hipertensi';
                        pesan = `Anak ≥13 th: Sistolik 120–129 / Diastolik <80 mmHg. Perlu edukasi perubahan gaya hidup.`;
                    } else if (sys < 120 && dia < 80) {
                        kategori = 'Tekanan Darah Normal';
                        pesan = `Anak ≥13 th: Tekanan darah <120/80 mmHg. Pertahankan gaya hidup sehat.`;
                    } else {
                        kategori = 'Pre Hipertensi';
                        pesan = `Anak ≥13 th: Perlu monitoring lebih lanjut.`;
                    }
                } else {
                    if (sys >= 130 || dia >= 80) {
                        kategori = 'Hipertensi Tingkat 2';
                        pesan = `Anak 1–12 th: Sistolik/Diastolik ≥persentil 95+12 mmHg. Rujuk ke FKRTL segera.`;
                    } else if (sys >= 120 || dia >= 70) {
                        kategori = 'Hipertensi Tingkat 1';
                        pesan = `Anak 1–12 th: Nilai antara persentil 95 dan 95+12 mmHg. Perlu pemeriksaan lebih lanjut.`;
                    } else if (sys >= 100 || dia >= 65) {
                        kategori = 'Pre Hipertensi';
                        pesan = `Anak 1–12 th: Antara persentil 90 dan <persentil 95. Perlu edukasi dan monitoring.`;
                    } else {
                        kategori = 'Tekanan Darah Normal';
                        pesan = `Anak 1–12 th: Sistolik dan Diastolik <persentil 90. Tekanan darah normal untuk usia ini.`;
                    }
                }
            } else {
                // -- DEWASA (>=18 tahun atau usia tidak diketahui) -- 7 kategori Kemenkes 2024
                modeBadge.textContent = usia ? `Dewasa (${usia} th)` : 'Dewasa';
                modeBadge.className = 'inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-slate-100 text-slate-500 border border-slate-200';

                if (sys >= 180 || dia >= 110) {
                    kategori = 'Hipertensi Derajat 3';
                    pesan = `Sistolik ≥180 dan/atau Diastolik ≥110 mmHg. KRISIS — Segera rujuk ke FKRTL!`;
                } else if ((sys >= 160 && sys <= 179) || (dia >= 100 && dia <= 109)) {
                    kategori = 'Hipertensi Derajat 2';
                    pesan = `Sistolik 160–179 dan/atau Diastolik 100–109 mmHg. Perlu pengobatan segera dan monitor ketat.`;
                } else if ((sys >= 140 && sys <= 159) || (dia >= 90 && dia <= 99)) {
                    kategori = 'Hipertensi Derajat 1';
                    pesan = `Sistolik 140–159 dan/atau Diastolik 90–99 mmHg. Perlu tatalaksana farmakologi dan non-farmakologi.`;
                } else if ((sys >= 130 && sys <= 139) || (dia >= 85 && dia <= 89)) {
                    kategori = 'Prehipertensi (Normal Tinggi)';
                    pesan = `Sistolik 130–139 dan/atau Diastolik 85–89 mmHg. Perlu pengawasan dan modifikasi gaya hidup.`;
                } else if ((sys >= 120 && sys <= 129) && (dia >= 80 && dia <= 84)) {
                    kategori = 'Normal';
                    pesan = `Sistolik 120–129 dan Diastolik 80–84 mmHg. Pertahankan pola hidup sehat.`;
                } else if (sys < 120 && dia < 80) {
                    kategori = 'Optimal';
                    pesan = `Sistolik <120 dan Diastolik <80 mmHg. Tekanan darah sangat baik!`;
                } else if (sys >= 140 && dia < 90) {
                    kategori = 'Hipertensi Sistolik Terisolasi';
                    pesan = `Sistolik ≥140 dan Diastolik <90 mmHg. Perlu tatalaksana dan pemantauan.`;
                } else {
                    kategori = 'Prehipertensi (Normal Tinggi)';
                    pesan = `Tekanan darah di batas atas normal. Perlu monitoring rutin.`;
                }
            }

            const ikon = KATEGORI_IKON[kategori] || '&#9679;';
            const warna = KATEGORI_WARNA[kategori] || { bg:'#F9FAFB', color:'#374151', border:'#E5E7EB' };

            badge.className = 'rounded-xl border-2 p-3 text-sm font-semibold';
            badge.style.backgroundColor = warna.bg;
            badge.style.color = warna.color;
            badge.style.borderColor = warna.border;
            badge.innerHTML = '<span style="margin-right:6px">' + ikon + '</span>' + kategori + '<div class="text-xs font-normal mt-1 opacity-90">' + pesan + '</div>';
            badge.classList.remove('hidden');
            modeBadge.classList.remove('hidden');
        }

        // Hitung ulang kategori saat pasien diganti (usia bisa beda -> dewasa vs anak)
        document.getElementById('input-pasien').addEventListener('change', checkBP);

        // -- DM --
        detailWrapper('dm', 'Detail Diabetes Melitus', `
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="text-sm text-[#1F2937] mb-1.5 block font-medium">Gula Darah (mg/dL)</label>
                    <input type="number" name="dm[gula_darah]" placeholder="110" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white">
                </div>
                <div>
                    <label class="text-sm text-[#1F2937] mb-1.5 block font-medium">Jenis Pemeriksaan</label>
                    <select name="dm[jenis_pemeriksaan]" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white">
                        <option value="sewaktu">Gula Darah Sewaktu</option>
                        <option value="puasa">Gula Darah Puasa</option>
                    </select>
                </div>
            </div>
        `);

        // -- OBESITAS --
        detailWrapper('obesitas', 'Detail Obesitas', `
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="text-sm text-[#1F2937] mb-1.5 block font-medium">Berat Badan (kg)</label>
                    <input type="number" step="0.1" id="ob-bb" name="obesitas[berat_badan]" oninput="checkIMTObesitas()" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white">
                </div>
                <div>
                    <label class="text-sm text-[#1F2937] mb-1.5 block font-medium">Tinggi Badan (cm)</label>
                    <input type="number" id="ob-tb" name="obesitas[tinggi_badan]" oninput="checkIMTObesitas()" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white">
                </div>
            </div>
            <div>
                <label class="text-sm text-[#1F2937] mb-1.5 block font-medium">Lingkar Perut (cm)</label>
                <input type="number" name="obesitas[lingkar_perut]" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white">
            </div>
            <div id="ob-imt" class="hidden text-sm font-semibold rounded-xl bg-blue-50 border border-blue-200 p-3 text-blue-700"></div>
        `);
        function checkIMTObesitas() {
            const bbVal = document.getElementById('ob-bb').value;
            const tbVal = document.getElementById('ob-tb').value;
            const bb = parseFloat(bbVal);
            const tb = parseFloat(tbVal);
            const box = document.getElementById('ob-imt');

            // Sinkronkan ke field tersembunyi PPOK, supaya BB/TB nggak perlu diinput 2x
            // tapi tetap tersimpan ke skrining_obesitas DAN skrining_ppok.
            const ppokBBHidden = document.getElementById('ppok-bb-hidden');
            const ppokTBHidden = document.getElementById('ppok-tb-hidden');
            if (ppokBBHidden) ppokBBHidden.value = bbVal;
            if (ppokTBHidden) ppokTBHidden.value = tbVal;

            if (!bb || !tb) { box.classList.add('hidden'); return; }
            const imt = (bb / Math.pow(tb/100, 2)).toFixed(1);
            const kat = imt < 18.5 ? 'Kurus' : imt < 25 ? 'Normal' : imt < 30 ? 'Berlebih' : 'Obesitas';
            box.textContent = 'IMT: ' + imt + ' kg/m² (' + kat + ') — dihitung otomatis';
            box.classList.remove('hidden');
        }

        // -- PPOK (Form PUMA) --
        detailWrapper('ppok', 'Detail PPOK (mengikuti Form PUMA)', `
            <div class="rounded-xl bg-blue-50 border border-blue-100 px-4 py-3 text-xs text-blue-600 flex items-center gap-2">
                <span>ℹ️</span>
                <span>Berat &amp; Tinggi Badan otomatis memakai data dari bagian <b>Obesitas</b> di atas — nggak perlu diisi ulang.</span>
            </div>
            <input type="hidden" id="ppok-bb-hidden" name="ppok[berat_badan]">
            <input type="hidden" id="ppok-tb-hidden" name="ppok[tinggi_badan]">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="text-sm text-[#1F2937] mb-1.5 block font-medium">Rata-rata Rokok/hari (batang)</label>
                    <input type="number" id="pk-rokok-hari" name="ppok[jumlah_batang_rokok_per_hari]" placeholder="0" oninput="syncMerokokFromPPOK()" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white">
                </div>
                <div>
                    <label class="text-sm text-[#1F2937] mb-1.5 block font-medium">Lama Merokok (tahun)</label>
                    <input type="number" id="pk-lama-rokok" name="ppok[lama_tahun_merokok]" placeholder="0" oninput="syncMerokokFromPPOK()" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white">
                </div>
            </div>
            <div class="flex items-center justify-between py-2 border-t border-gray-100">
                <span class="text-sm font-medium text-gray-700">Sesak napas saat jalan cepat / menanjak?</span>
                <div class="toggle-yatidak flex gap-2">
                    <span><input type="radio" name="ppok[sesak_napas]" value="false" id="pk-sesak-tidak" class="hidden" onchange="hitungSkorPUMA()"><label for="pk-sesak-tidak">Tidak</label></span>
                    <span><input type="radio" name="ppok[sesak_napas]" value="true" id="pk-sesak-ya" class="hidden" onchange="hitungSkorPUMA()"><label for="pk-sesak-ya">Ya</label></span>
                </div>
            </div>
            <div class="flex items-center justify-between py-2 border-t border-gray-100">
                <span class="text-sm font-medium text-gray-700">Batuk berdahak kronis (≥3 bulan/tahun)?</span>
                <div class="toggle-yatidak flex gap-2">
                    <span><input type="radio" name="ppok[batuk_berdahak_kronis]" value="false" id="pk-batuk-tidak" class="hidden" onchange="hitungSkorPUMA()"><label for="pk-batuk-tidak">Tidak</label></span>
                    <span><input type="radio" name="ppok[batuk_berdahak_kronis]" value="true" id="pk-batuk-ya" class="hidden" onchange="hitungSkorPUMA()"><label for="pk-batuk-ya">Ya</label></span>
                </div>
            </div>
            <div id="ppok-skor-box" class="hidden rounded-xl border-2 p-3 text-sm font-semibold mt-2"></div>
            <input type="hidden" id="ppok-skor-hidden" name="ppok[skor_total]">
            <input type="hidden" id="ppok-kategori-hidden" name="ppok[kategori_risiko]">
            <input type="hidden" id="ppok-rujukan-hidden" name="ppok[rujukan_spirometri]">
            <p class="text-xs text-gray-400">Skor total PUMA dihitung dari usia pasien + faktor merokok + gejala di atas. Skor ≥6 → risiko tinggi, disarankan rujuk pemeriksaan spirometri.</p>
        `);

        // Set kondisi awal Step 3 "Merokok" mengikuti isian PPOK saat form pertama kali dimuat
        // (default kosong -> otomatis "Tidak" & terkunci).
        syncMerokokFromPPOK();

        // Kalau di PPOK ada data rokok/hari atau lama merokok terisi (>0),
        // otomatis set "Merokok" di Step 3 = Ya dan kunci (nggak bisa diklik manual).
        // Kalau PPOK dikosongkan (rokok/hari = 0 dan lama merokok = 0),
        // otomatis set "Merokok" = Tidak dan tetap dikunci, karena datanya
        // sudah bisa disimpulkan langsung dari isian PPOK.
        function syncMerokokFromPPOK() {
            const rokokHariEl = document.getElementById('pk-rokok-hari');
            const lamaRokokEl = document.getElementById('pk-lama-rokok');
            if (!rokokHariEl || !lamaRokokEl) return;

            const rokokHari = parseFloat(rokokHariEl.value) || 0;
            const lamaRokok = parseFloat(lamaRokokEl.value) || 0;
            const merokokSelect = document.querySelector('select[name="merokok"]');
            const note = document.getElementById('merokok-auto-note');
            if (!merokokSelect) return;

            merokokSelect.classList.add('pointer-events-none', 'opacity-60');
            merokokSelect.setAttribute('data-auto-locked', 'true');

            if (rokokHari > 0 || lamaRokok > 0) {
                merokokSelect.value = 'true';
                if (note) {
                    note.textContent = 'Otomatis "Ya" karena sudah ada data rokok di bagian PPOK';
                    note.classList.remove('hidden');
                }
            } else {
                merokokSelect.value = 'false';
                if (note) {
                    note.textContent = 'Otomatis "Tidak" karena bagian rokok di PPOK dikosongkan';
                    note.classList.remove('hidden');
                }
            }

            hitungSkorPUMA();
        }

        // =====================================================================
        // Skor PUMA (Predictive Model for COPD in Primary Care) — mengikuti
        // Kuesioner PUMA versi PDPI (pulmo.id/puma):
        //   - Usia:        <40 th = 0, 40-60 th = 1, >60 th = 2
        //   - Pack Years:  (lama merokok tahun x rata-rata rokok/hari) / 20
        //                  <20 = 0, 20-30 = 1, >30 = 2
        //   - Sesak napas: Ya = 1, Tidak = 0
        //   - Batuk berdahak kronis: Ya = 1, Tidak = 0
        //   Total maksimal = 6. Skor >= 6 -> Risiko Tinggi, disarankan spirometri.
        // Catatan: kuesioner PUMA resmi juga memasukkan jenis kelamin sebagai
        // salah satu faktor skor. Field itu belum ada di form/tabel skrining_ppok
        // kamu sekarang, jadi belum dihitung -- gampang ditambah nanti kalau perlu.
        // =====================================================================
        function hitungSkorPUMA() {
            const box = document.getElementById('ppok-skor-box');
            const rokokHariEl = document.getElementById('pk-rokok-hari');
            const lamaRokokEl = document.getElementById('pk-lama-rokok');
            if (!box || !rokokHariEl || !lamaRokokEl) return;

            const usia = getUsiaFromPasien();
            const rokokHari = parseFloat(rokokHariEl.value) || 0;
            const lamaRokok = parseFloat(lamaRokokEl.value) || 0;
            const sesakEl = document.querySelector('input[name="ppok[sesak_napas]"]:checked');
            const batukEl = document.querySelector('input[name="ppok[batuk_berdahak_kronis]"]:checked');

            // Kalau belum ada input sama sekali, jangan tampilkan skor dulu
            if (usia === null && !rokokHari && !lamaRokok && !sesakEl && !batukEl) {
                box.classList.add('hidden');
                return;
            }

            // -- Skor usia --
            let skorUsia = 0;
            if (usia !== null) {
                if (usia > 60) skorUsia = 2;
                else if (usia >= 40) skorUsia = 1;
                else skorUsia = 0;
            }

            // -- Skor pack years --
            const packYears = (lamaRokok * rokokHari) / 20;
            let skorPack = 0;
            if (packYears > 30) skorPack = 2;
            else if (packYears >= 20) skorPack = 1;
            else skorPack = 0;

            // -- Skor gejala --
            const skorSesak = (sesakEl && sesakEl.value === 'true') ? 1 : 0;
            const skorBatuk = (batukEl && batukEl.value === 'true') ? 1 : 0;

            const skorTotal = skorUsia + skorPack + skorSesak + skorBatuk;
            const risikoTinggi = skorTotal >= 6;
            const kategoriRisiko = risikoTinggi ? 'Tinggi' : 'Rendah';

            // Simpan ke hidden input biar ikut kekirim pas submit
            document.getElementById('ppok-skor-hidden').value = skorTotal;
            document.getElementById('ppok-kategori-hidden').value = kategoriRisiko;
            document.getElementById('ppok-rujukan-hidden').value = risikoTinggi ? 'true' : 'false';

            box.classList.remove('hidden');
            if (risikoTinggi) {
                box.style.backgroundColor = '#FEF2F2';
                box.style.borderColor = '#FCA5A5';
                box.style.color = '#991B1B';
                box.innerHTML = 'Skor PUMA: ' + skorTotal + ' — <b>Risiko Tinggi PPOK</b>' +
                    '<div class="text-xs font-normal mt-1 opacity-90">Skor ≥6, disarankan rujuk pemeriksaan spirometri dengan tes bronkodilator.</div>';
            } else {
                box.style.backgroundColor = '#ECFDF5';
                box.style.borderColor = '#6EE7B7';
                box.style.color = '#065F46';
                box.innerHTML = 'Skor PUMA: ' + skorTotal + ' — <b>Risiko Rendah PPOK</b>' +
                    '<div class="text-xs font-normal mt-1 opacity-90">Evaluasi berkala pada kelompok berisiko.</div>';
            }
        }

        // Hitung ulang skor PUMA saat pasien diganti (usia bisa beda)
        document.getElementById('input-pasien').addEventListener('change', hitungSkorPUMA);

        // -- GANGGUAN INDRA --
        detailWrapper('gangguan_indra', 'Detail Gangguan Indra', `
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="text-sm text-[#1F2937] mb-1.5 block font-medium">Hasil Pemeriksaan Mata</label>
                    <select name="gangguan_indra[hasil_mata]" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white">
                        <option>Normal</option><option>Ada Gangguan</option>
                    </select>
                </div>
                <div>
                    <label class="text-sm text-[#1F2937] mb-1.5 block font-medium">Hasil Pemeriksaan Telinga</label>
                    <select name="gangguan_indra[hasil_telinga]" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white">
                        <option>Normal</option><option>Ada Gangguan</option>
                    </select>
                </div>
            </div>
            <div>
                <label class="text-sm text-[#1F2937] mb-1.5 block font-medium">Keterangan Tambahan</label>
                <textarea name="gangguan_indra[keterangan]" rows="2" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white"></textarea>
            </div>
        `);

        // -- KESEHATAN JIWA (SRQ-20) --
        let srqHTML = '<p class="text-xs text-gray-400 mb-2">Jawab 20 pertanyaan berikut (selama 30 hari terakhir):</p><div class="rounded-xl border border-gray-200 divide-y bg-white">';
        const srqPertanyaan = [
            "Sering menderita sakit kepala?", "Tidak nafsu makan?", "Sulit tidur?", "Mudah takut?",
            "Merasa tegang, cemas, khawatir?", "Tangan gemetar?", "Pencernaan terganggu/buruk?",
            "Sulit berpikir jernih?", "Merasa tidak bahagia?", "Menangis lebih sering?",
            "Sulit menikmati kegiatan sehari-hari?", "Sulit mengambil keputusan?",
            "Pekerjaan sehari-hari terganggu?", "Tidak mampu melakukan hal bermanfaat?",
            "Kehilangan minat pada berbagai hal?", "Merasa tidak berharga?",
            "Punya pikiran mengakhiri hidup?", "Merasa lelah sepanjang waktu?",
            "Rasa tidak enak di perut?", "Mudah lelah?"
        ];
        srqPertanyaan.forEach((q, i) => {
            const n = i + 1;
            const highlight = n === 17 ? 'bg-red-50' : '';
            srqHTML += '<div class="srq-row ' + highlight + '">' +
                '<span class="text-xs text-gray-700 pr-3">' + n + '. ' + q + (n===17 ? ' ⚠️' : '') + '</span>' +
                '<div class="toggle-yatidak flex gap-2 flex-shrink-0">' +
                '<span><input type="radio" name="kesehatan_jiwa[j' + n + ']" value="false" id="srq-' + n + '-t" class="hidden" checked><label for="srq-' + n + '-t">Tidak</label></span>' +
                '<span><input type="radio" name="kesehatan_jiwa[j' + n + ']" value="true" id="srq-' + n + '-y" class="hidden"><label for="srq-' + n + '-y">Ya</label></span>' +
                '</div></div>';
        });
        srqHTML += '</div><p class="text-xs text-red-500 mt-2">⚠️ No.17 butuh perhatian khusus dari bidan/nakes, bukan sekadar dihitung skor.</p>';
        detailWrapper('kesehatan_jiwa', ' Detail Kesehatan Jiwa (SRQ-20)', srqHTML);
    </script>

<%- include('../partials/profil') %>

</div>
</body>
</html>
