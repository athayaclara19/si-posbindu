<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tambah Pasien - SI Posbindu</title>
    <link rel="stylesheet" href="/css/output.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
</head>
<body class="bg-slate-50 font-inter antialiased text-slate-800">
    
    <div class="flex min-h-screen">
    <%- include('../partials/sidebar', { active: 'pasien' }) %>

    <div class="flex-1 flex flex-col min-w-0 lg:ml-64">
        <%- include('../partials/header', { pageTitle: 'Tambah Pasien Baru' }) %>

        <main class="p-8 space-y-6 w-full">
            
            <div class="mb-6 flex items-center gap-4">
                <a href="/pasien" class="w-10 h-10 rounded-full bg-white border border-gray-200 flex items-center justify-center text-gray-500 hover:bg-gray-50 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                </a>
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 font-poppins">Registrasi Pasien</h2>
                    <p class="text-gray-500 text-sm mt-1">Masukkan data warga baru dengan lengkap dan benar</p>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8">
                <form action="/pasien/tambah" method="POST" class="space-y-5">
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">NIK (16 Digit) <span class="text-red-500">*</span></label>
                        <input type="text" name="nik" maxlength="16" pattern="[0-9]{16}" placeholder="Contoh: 1306012345670001" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-gray-50 focus:bg-white transition-all" required>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Nama Lengkap <span class="text-red-500">*</span></label>
                        <input type="text" name="nama_pasien" placeholder="Masukkan nama lengkap sesuai KTP" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-gray-50 focus:bg-white transition-all" required>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1.5">Nagari <span class="text-red-500">*</span></label>
                            <select id="select-nagari" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-gray-50 focus:bg-white transition-all" required>
                                <option value="">-- Pilih Nagari --</option>
                                <% if (typeof nagari !== 'undefined') { %>
                                    <% nagari.forEach(n => { %>
                                        <option value="<%= n.id_nagari %>"><%= n.nama_nagari %></option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1.5">Jorong / Wilayah <span class="text-red-500">*</span></label>
                            <select id="select-jorong" name="id_jorong" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-gray-200 cursor-not-allowed transition-all" required disabled>
                                <option value="">-- Pilih Nagari Dahulu --</option>
                            </select>
                        </div>
                    </div>
                

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div class="w-full">
                            <label class="text-sm text-[#1F2937] font-medium mb-1.5 block">Usia (Tahun)</label>
                            <div class="relative">
                                <input type="number" name="usia" min="1" max="150" required placeholder="Contoh: 45" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-gray-50 hover:bg-white transition-colors">
                                <span class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 text-sm">Tahun</span>
                            </div>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1.5">Jenis Kelamin <span class="text-red-500">*</span></label>
                            <select name="jenis_kelamin" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-gray-50 focus:bg-white transition-all" required>
                                <option value="">-- Pilih --</option>
                                <option value="Laki-laki">Laki-laki</option>
                                <option value="Perempuan">Perempuan</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1.5">Nomor HP / WA</label>
                            <input type="text" name="no_hp" placeholder="Contoh: 08123456789" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-gray-50 focus:bg-white transition-all">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1.5">Pekerjaan</label>
                            <input type="text" name="pekerjaan" placeholder="Contoh: Petani / IRT" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-gray-50 focus:bg-white transition-all">
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Alamat Lengkap</label>
                        <textarea name="alamat" rows="3" placeholder="Masukkan detail alamat (jalan, RT/RW)" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-gray-50 focus:bg-white transition-all resize-none"></textarea>
                    </div>

                    <div class="pt-4 border-t border-gray-100 flex justify-end gap-3">
                        <a href="/pasien" class="px-6 py-2.5 rounded-xl text-sm font-medium border border-gray-200 text-gray-600 hover:bg-gray-50 transition-all">Batal</a>
                        <button type="submit" class="px-6 py-2.5 rounded-xl text-sm font-medium bg-[#2563EB] text-white hover:bg-[#1D4ED8] transition-all shadow-sm">
                            Simpan Data Pasien
                        </button>
                    </div>

                </form>
            </div>

        </main>
    </div>

    <script>
        // 1. Ambil data 'jorong' dari Node.js dan ubah jadi array JavaScript
        const dataJorong = <%- JSON.stringify(jorong || []) %>;
        
        // 2. Tangkap elemen select Nagari dan Jorong
        const selectNagari = document.getElementById('select-nagari');
        const selectJorong = document.getElementById('select-jorong');

        // 3. Pasang pendeteksi perubahan (event listener) pada dropdown Nagari
        selectNagari.addEventListener('change', function() {
            const idNagariTerpilih = this.value;
            
            // Bersihkan dropdown jorong setiap kali nagari diganti
            selectJorong.innerHTML = '<option value="">-- Pilih Jorong --</option>';

            if (idNagariTerpilih) {
                // Jika Nagari dipilih: Buka kunci dropdown jorong (enable)
                selectJorong.disabled = false;
                selectJorong.classList.remove('bg-gray-200', 'cursor-not-allowed');
                selectJorong.classList.add('bg-gray-50', 'focus:bg-white');

                // Filter jorong yang id_nagari-nya cocok dengan nagari yang dipilih
                const jorongFiltered = dataJorong.filter(j => j.id_nagari == idNagariTerpilih);

                // Masukkan hasil filter ke dalam dropdown jorong
                jorongFiltered.forEach(j => {
                    const option = document.createElement('option');
                    option.value = j.id_jorong;
                    option.textContent = j.nama_jorong;
                    selectJorong.appendChild(option);
                });
            } else {
                // Jika Nagari di-reset (kosong): Kunci kembali dropdown jorong
                selectJorong.disabled = true;
                selectJorong.innerHTML = '<option value="">-- Pilih Nagari Dahulu --</option>';
                selectJorong.classList.add('bg-gray-200', 'cursor-not-allowed');
                selectJorong.classList.remove('bg-gray-50', 'focus:bg-white');
            }
        });
    </script>

<%- include('../partials/profil') %>


</div>
</body>
</html>