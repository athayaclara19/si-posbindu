<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bukti Skrining - <%= pasien.nama_pasien %></title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Times New Roman', Times, serif;
            font-size: 11pt;
            color: #000;
            background: #fff;
            line-height: 1.4;
        }

        /* ── Tombol Cetak (hanya tampil di layar, hilang saat print) ── */
        .print-toolbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            background: #1e40af;
            color: #fff;
            padding: 10px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            z-index: 999;
            font-family: Arial, sans-serif;
            font-size: 13px;
        }

        .print-toolbar .toolbar-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .btn-print {
            background: #fff;
            color: #1e40af;
            border: none;
            padding: 7px 18px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .btn-print:hover {
            background: #dbeafe;
        }

        .btn-back {
            background: transparent;
            color: #bfdbfe;
            border: 1px solid #bfdbfe;
            padding: 6px 14px;
            border-radius: 6px;
            font-size: 12px;
            cursor: pointer;
            text-decoration: none;
        }

        .btn-back:hover {
            color: #fff;
            border-color: #fff;
        }

        /* ── Area konten dokumen ── */
        .dokumen {
            max-width: 210mm;
            margin: 60px auto 40px auto;
            padding: 20mm 20mm 20mm 25mm;
            background: #fff;
        }

        /* ── Header Kop ── */
        .kop {
            text-align: center;
            border-bottom: 3px double #000;
            padding-bottom: 10px;
            margin-bottom: 16px;
        }

        .kop h1 {
            font-size: 14pt;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .kop h2 {
            font-size: 12pt;
            font-weight: bold;
            text-transform: uppercase;
        }

        .kop p {
            font-size: 10pt;
            margin-top: 2px;
        }

        /* ── Judul Dokumen ── */
        .judul-dokumen {
            text-align: center;
            margin: 16px 0 20px;
        }

        .judul-dokumen h3 {
            font-size: 13pt;
            font-weight: bold;
            text-transform: uppercase;
            text-decoration: underline;
        }

        .judul-dokumen p {
            font-size: 11pt;
            margin-top: 4px;
        }

        /* ── Rincian Info ── */
        .info-table {
            width: 100%;
            margin-bottom: 20px;
            font-size: 11pt;
        }

        .info-table td {
            border: none;
            padding: 4px 0;
        }

        .info-table td.label {
            width: 150px;
            color: #444;
        }

        .info-table td.separator {
            width: 15px;
            text-align: center;
        }

        .info-table td.value {
            font-weight: bold;
        }

        /* ── Tabel Hasil Medis ── */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
            font-size: 10pt;
        }

        th,
        td {
            border: 1px solid #000;
            padding: 6px 8px;
            vertical-align: middle;
        }

        th {
            background: #f3f4f6;
            color: #000;
            text-align: center;
            font-weight: bold;
        }

        td.center {
            text-align: center;
        }

        /* ── Tanda Tangan ── */
        .ttd-section {
            margin-top: 40px;
            display: flex;
            justify-content: space-between;
            page-break-inside: avoid;
        }

        .ttd-box {
            text-align: center;
            width: 220px;
        }

        .ttd-box .ttd-label {
            font-size: 10pt;
            margin-bottom: 70px;
        }

        .ttd-box .ttd-nama {
            font-size: 10pt;
            font-weight: bold;
            border-top: 1px solid #000;
            padding-top: 4px;
        }

        .ttd-box .ttd-jabatan {
            font-size: 9pt;
        }

        /* ── Print mode ── */
        @media print {
            .print-toolbar {
                display: none !important;
            }

            .dokumen {
                margin: 0;
                padding: 15mm 15mm 15mm 20mm;
                max-width: 100%;
            }

            body {
                print-color-adjust: exact;
                -webkit-print-color-adjust: exact;
            }
        }

        @page {
            size: A4 portrait;
            margin: 0;
        }
    </style>
</head>

<body>

    <!-- Toolbar (hilang saat print) -->
    <div class="print-toolbar">
        <div class="toolbar-left">
            <button onclick="window.close()" class="btn-back">← Tutup</button>
            <span>Pratinjau Cetak — Bukti Skrining Kesehatan</span>
        </div>
        <button class="btn-print" onclick="window.print()">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 6 2 18 2 18 9" />
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
                <rect x="6" y="14" width="12" height="8" />
            </svg>
            Cetak / Simpan PDF
        </button>
    </div>

    <!-- Dokumen -->
    <div class="dokumen">

        <!-- Kop Surat -->
        <div class="kop">
            <h1>Puskesmas IV Koto</h1>
            <h2>Program Pengendalian Penyakit Tidak Menular (PTM)</h2>
            <p>Kecamatan IV Koto, Kabupaten Agam, Sumatera Barat</p>
        </div>

        <!-- Judul -->
        <div class="judul-dokumen">
            <h3>Bukti Pemeriksaan Skrining Kesehatan</h3>
            <p>Tanggal Pemeriksaan: <strong><%= new Date(kegiatan.tanggal_kegiatan).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></strong></p>
        </div>

        <!-- Rincian Identitas & Kegiatan -->
        <table class="info-table">
            <tr>
                <td class="label">Nama Pasien</td>
                <td class="separator">:</td>
                <td class="value"><%= pasien.nama_pasien %></td>
                <td class="label" style="padding-left: 30px;">Nama Kegiatan</td>
                <td class="separator">:</td>
                <td><%= kegiatan.nama_kegiatan %></td>
            </tr>
            <tr>
                <td class="label">NIK / ID</td>
                <td class="separator">:</td>
                <td style="font-family: monospace;"><%= pasien.nik %></td>
                <td class="label" style="padding-left: 30px;">Lokasi Kegiatan</td>
                <td class="separator">:</td>
                <td><%= kegiatan.tempat %></td>
            </tr>
            <tr>
                <td class="label">Usia / Kelamin</td>
                <td class="separator">:</td>
                <td><%= pasien.usia %> Tahun / <%= pasien.jenis_kelamin === 'L' ? 'Laki-laki' : 'Perempuan' %></td>
                <td class="label" style="padding-left: 30px;">Penanggung Jawab</td>
                <td class="separator">:</td>
                <td class="value"><%= kegiatan.nama_validator || kegiatan.nama_pj || 'Bidan Desa' %></td>
            </tr>
            <tr>
                <td class="label">Alamat / Jorong</td>
                <td class="separator">:</td>
                <td colspan="4"><%= pasien.alamat || '-' %>, Jorong <%= pasien.nama_jorong %>, Nagari <%= pasien.nama_nagari %></td>
            </tr>
        </table>

        <!-- Tabel Hasil Pemeriksaan Spesifik -->
        <h4 style="font-size: 11pt; font-weight: bold; margin-bottom: 8px; text-transform: uppercase; border-bottom: 1px solid #000; padding-bottom: 3px;">I. Hasil Skrining Penyakit Tidak Menular (PTM)</h4>
        <table>
            <thead>
                <tr>
                    <th style="width: 5%">No</th>
                    <th style="width: 25%">Jenis Penyakit PTM</th>
                    <th style="width: 50%">Hasil Pengukuran / Pemeriksaan Klinis</th>
                    <th style="width: 20%">Status Validasi</th>
                </tr>
            </thead>
            <tbody>
                <% skriningList.forEach((p, index) => { %>
                    <tr>
                        <td class="center font-bold"><%= index + 1 %></td>
                        <td><strong><%= p.nama_ptm %></strong></td>
                        <td>
                            <% if (p.id_jenis_ptm === 'hipertensi') { %>
                                Sistole / Diastole: <strong><%= p.sistole %> / <%= p.diastole %> mmHg</strong><br>
                                Kategori Tekanan Darah: <strong><%= p.ht_status_tekanan || p.status_tekanan || 'Normal' %></strong>
                            <% } else if (p.id_jenis_ptm === 'dm') { %>
                                Kadar Gula Darah: <strong><%= p.dm_gula_darah || '-' %> mg/dL</strong> (Pemeriksaan: <%= p.dm_jenis_pemeriksaan || '-' %>)<br>
                                Kategori Hasil: <strong><%= p.dm_kategori_hasil || '-' %></strong>
                            <% } else if (p.id_jenis_ptm === 'obesitas') { %>
                                Berat Badan: <strong><%= p.ob_berat_badan || '-' %> kg</strong>, Tinggi Badan: <strong><%= p.ob_tinggi_badan || '-' %> cm</strong><br>
                                Indeks Massa Tubuh (IMT): <strong><%= p.ob_imt ? parseFloat(p.ob_imt).toFixed(1) : '-' %> kg/m²</strong> (Kategori: <strong><%= p.ob_kategori_obesitas || '-' %></strong>)<br>
                                Lingkar Perut: <%= p.ob_lingkar_perut ? p.ob_lingkar_perut + ' cm' : '-' %>
                            <% } else if (p.id_jenis_ptm === 'ppok') { %>
                                Kebiasaan: <%= p.pp_rokok_per_hari || '0' %> batang rokok/hari (Lama: <%= p.pp_lama_merokok || '0' %> tahun)<br>
                                Gejala Medis: Sesak Napas (<%= p.pp_sesak_napas ? 'Ya' : 'Tidak' %>), Batuk Kronis (<%= p.pp_batuk_kronis ? 'Ya' : 'Tidak' %>)<br>
                                Skor Total PUMA: <strong><%= p.pp_skor_total || '0' %></strong> (Risiko: <strong><%= p.pp_kategori_risiko || 'Rendah' %></strong>)<br>
                                Rujukan Spirometri: <strong><%= p.pp_rujukan_spirometri ? 'Ya' : 'Tidak' %></strong>
                            <% } else if (p.id_jenis_ptm === 'gangguan_indra') { %>
                                Hasil Pemeriksaan Mata: <strong><%= p.gi_mata || 'Normal' %></strong><br>
                                Hasil Pemeriksaan Telinga: <strong><%= p.gi_telinga || 'Normal' %></strong><br>
                                Keterangan Tambahan: <%= p.gi_keterangan || '-' %>
                            <% } else if (p.id_jenis_ptm === 'kesehatan_jiwa') { %>
                                Skor SRQ-20: <strong><%= p.kj_skor_total || '0' %> / 20</strong> (Hasil: <strong><%= p.kj_kategori_hasil || 'Normal' %></strong>)<br>
                                Risiko Bunuh Diri: <strong><%= p.kj_risiko_bunuh_diri ? 'Ya (Rujuk Segera)' : 'Tidak' %></strong>
                            <% } %>
                        </td>
                        <td class="center">
                            <% if (p.status_validasi === 'terverifikasi') { %>
                                <span style="color: green; font-weight: bold;">VALID</span>
                            <% } else if (p.status_validasi === 'revisi') { %>
                                <span style="color: red; font-weight: bold;">REVISI</span>
                                <% if (p.catatan_bidan) { %>
                                    <div style="font-size: 8pt; color: #7f1d1d; margin-top: 2px;">Ket: <%= p.catatan_bidan %></div>
                                <% } %>
                            <% } else { %>
                                <span style="color: #d97706; font-weight: bold;">MENUNGGU</span>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>

        <!-- Parameter Umum & Gaya Hidup -->
        <h4 style="font-size: 11pt; font-weight: bold; margin-bottom: 8px; text-transform: uppercase; border-bottom: 1px solid #000; padding-bottom: 3px; margin-top: 24px;">II. Data Kesehatan Umum &amp; Gaya Hidup</h4>
        <% const main = skriningList[0] || {}; %>
        <table style="margin-bottom: 24px;">
            <tbody>
                <tr>
                    <td style="width: 25%">Berat / Tinggi Badan</td>
                    <td style="width: 25%"><strong><%= main.berat_badan || '-' %> kg / <%= main.tinggi_badan || '-' %> cm</strong></td>
                    <td style="width: 25%">Kebiasaan Merokok</td>
                    <td style="width: 25%"><strong><%= main.merokok ? 'Ya' : 'Tidak' %></strong></td>
                </tr>
                <tr>
                    <td>Gula Darah / Kolesterol</td>
                    <td><strong><%= main.gula_darah || '-' %> mg/dL / <%= main.kolesterol || '-' %> mg/dL</strong></td>
                    <td>Aktivitas Fisik</td>
                    <td><strong><%= main.aktivitas_fisik || '-' %></strong></td>
                </tr>
                <tr>
                    <td>Menerima Obat</td>
                    <td>
                        <% 
                            const obatMap = {
                                'tidak': 'Tidak',
                                'beli_sendiri': 'Beli Sendiri',
                                'dari_puskesmas': 'Dari Puskesmas',
                                'dari_rumah_sakit': 'Dari Rumah Sakit'
                            };
                        %>
                        <strong><%= obatMap[main.dapat_obat] || 'Tidak' %></strong>
                    </td>
                    <td>Rujukan Medis ke RS</td>
                    <td><strong><%= main.status_rujukan === 'iya' ? 'Ya (Dirujuk)' : 'Tidak' %></strong></td>
                </tr>
                <% if (main.edukasi && main.edukasi.trim() !== '') { %>
                    <tr>
                        <td>Edukasi Kesehatan</td>
                        <td colspan="3" style="color: #1e3a8a; font-style: italic;">"<%= main.edukasi %>"</td>
                    </tr>
                <% } %>
            </tbody>
        </table>

        <!-- Tanda Tangan -->
        <div class="ttd-section">
            <div class="ttd-box">
                <div class="ttd-label">
                    Pemeriksa / Staf,<br>
                    Posbindu IV Koto,
                </div>
                <div class="ttd-nama">Ani Kader Guguak</div>
                <div class="ttd-jabatan">Kader Posbindu</div>
            </div>
            <div class="ttd-box">
                <div class="ttd-label">
                    Kab. Agam, <%= new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %><br>
                    Penanggung Jawab Kegiatan,
                </div>
                <div class="ttd-nama"><%= kegiatan.nama_validator || kegiatan.nama_pj || 'Bidan Desa' %></div>
                <div class="ttd-jabatan">NIP/NRP. .............................</div>
            </div>
        </div>

    </div>

    <script>
        // Otomatis cetak saat halaman dibuka
        window.addEventListener('DOMContentLoaded', () => {
            setTimeout(() => {
                window.print();
            }, 500);
        });
    </script>

</body>

</html>
