<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Jadwal - PJ PTM</title>
    <link rel="stylesheet" href="/css/output.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .font-poppins { font-family: 'Poppins', sans-serif; }
        .font-inter   { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 font-inter antialiased text-slate-800">

    <div class="app-shell">
    <%- include('../partials/sidebar', { active: 'jadwal', role: 'ptm' }) %>

    <div class="main-content-wrapper">
        <%- include('../partials/header', { pageTitle: 'Edit Jadwal', role: 'ptm' }) %>

        <main class="p-8 max-w-2xl space-y-6">

            <!-- Breadcrumb -->
            <div class="flex items-center gap-2 text-sm text-gray-400">
                <a href="/ptm/jadwal" class="hover:text-[#2563EB] transition-colors">Jadwal</a>
                <span>/</span>
                <span class="text-gray-700 font-medium">Edit Jadwal</span>
            </div>

            <div>
                <h2 class="text-[#1F2937] font-poppins font-semibold text-xl">Edit Jadwal Kegiatan</h2>
                <p class="text-[#6B7280] text-sm mt-1">Ubah detail jadwal kegiatan Posbindu.</p>
            </div>

            <!-- WARNING: Kalau sudah ada skrining, tanggal tidak bisa diubah -->
            <% if (sudahAdaSkrining) { %>
            <div class="flex items-start gap-3 bg-amber-50 border border-amber-200 rounded-2xl p-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 mt-0.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                <div>
                    <p class="text-amber-800 font-semibold text-sm">Tanggal Tidak Bisa Diubah</p>
                    <p class="text-amber-700 text-sm mt-0.5 leading-relaxed">
                        Jadwal ini sudah memiliki data skrining yang terinput oleh kader.
                        Anda hanya bisa mengubah <strong>lokasi</strong> dan <strong>jorong</strong>.
                        Tanggal dikunci untuk menjaga konsistensi data.
                    </p>
                </div>
            </div>
            <% } %>

            <!-- Form Edit -->
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
                <form action="/ptm/jadwal/edit/<%= kegiatan.id_kegiatan %>" method="POST" class="space-y-5">

                    <!-- Tanggal: dikunci jika sudah ada skrining -->
                    <div>
                        <label class="text-sm text-[#1F2937] font-medium mb-1.5 block">
                            Tanggal Kegiatan
                            <% if (sudahAdaSkrining) { %>
                            <span class="ml-1 text-xs text-amber-600 font-normal">(terkunci)</span>
                            <% } %>
                        </label>
                        <%
                            const tglObj = new Date(kegiatan.tanggal_kegiatan);
                            const tglVal = tglObj.toISOString().split('T')[0];
                        %>
                        <input type="date" name="tanggal_kegiatan"
                               value="<%= tglVal %>"
                               onchange="validasiTanggal(this)"
                               <%= sudahAdaSkrining ? 'readonly' : 'required' %>
                               class="w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-colors
                                      <%= sudahAdaSkrining ? 'bg-gray-100 border-gray-200 cursor-not-allowed text-gray-400' : 'border-gray-200 bg-gray-50 hover:bg-white focus:border-[#2563EB]' %>">
                    </div>

                    <!-- Lokasi -->
                    <div>
                        <label class="text-sm text-[#1F2937] font-medium mb-1.5 block">Lokasi (Tempat)</label>
                        <input type="text" name="lokasi" required
                               value="<%= kegiatan.lokasi %>"
                               placeholder="Contoh: Posyandu Melati 1"
                               class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-gray-50 hover:bg-white transition-colors">
                    </div>

                    <!-- Nagari (untuk filter jorong) -->
                    <div>
                        <label class="text-sm text-[#1F2937] font-medium mb-1.5 block">Nagari</label>
                        <select id="select-nagari-edit" onchange="filterJorongEdit()" required
                                class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-gray-50 hover:bg-white transition-colors cursor-pointer">
                            <option value="">-- Pilih Nagari --</option>
                            <% if (typeof nagari !== 'undefined') { %>
                                <% nagari.forEach(n => { %>
                                    <option value="<%= n.id_nagari %>"
                                            <%= n.id_nagari == kegiatan.id_nagari ? 'selected' : '' %>>
                                        <%= n.nama_nagari %>
                                    </option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>

                    <!-- Jorong -->
                    <div>
                        <label class="text-sm text-[#1F2937] font-medium mb-1.5 block">Jorong</label>
                        <select id="select-jorong-edit" name="id_jorong" required
                                class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-gray-50 hover:bg-white transition-colors cursor-pointer">
                            <option value="">-- Pilih Jorong --</option>
                            <% if (typeof jorong !== 'undefined') { %>
                                <% jorong.forEach(j => { %>
                                    <% if (j.id_nagari == kegiatan.id_nagari) { %>
                                        <option value="<%= j.id_jorong %>"
                                                data-nagari="<%= j.id_nagari %>"
                                                <%= j.id_jorong == kegiatan.id_jorong ? 'selected' : '' %>>
                                            <%= j.nama_jorong %>
                                        </option>
                                    <% } %>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>

                    <!-- Tombol -->
                    <div class="flex gap-3 pt-2">
                        <a href="/ptm/jadwal"
                           class="flex-1 text-center bg-gray-100 hover:bg-gray-200 text-gray-600 font-medium py-2.5 rounded-xl text-sm transition-colors">
                            Batal
                        </a>
                        <button type="submit"
                                class="flex-1 bg-[#2563EB] hover:bg-[#1D4ED8] text-white font-medium py-2.5 rounded-xl text-sm transition-colors shadow-sm">
                            Simpan Perubahan
                        </button>
                    </div>
                </form>
            </div>
        </main>
    </div>

    <script>
        // Validasi hari Minggu
        function validasiTanggal(input) {
            if (!input.value) return;
            const d = new Date(input.value);
            if (d.getDay() === 0) {
                Swal.fire({ icon: 'error', title: 'Tidak Bisa Hari Minggu!', text: 'Jadwal hanya bisa Senin–Sabtu.', confirmButtonColor: '#2563EB' });
                input.value = '';
            }
        }

        // Filter jorong berdasarkan nagari yang dipilih
        const allJorongOpts = <%- JSON.stringify((jorong || []).map(j => ({ id_jorong: j.id_jorong, nama_jorong: j.nama_jorong, id_nagari: j.id_nagari }))) %>;

        function filterJorongEdit() {
            const nagariId = document.getElementById('select-nagari-edit').value;
            const jorongSelect = document.getElementById('select-jorong-edit');
            const currentJorong = '<%= kegiatan.id_jorong %>';
            jorongSelect.innerHTML = '<option value="">-- Pilih Jorong --</option>';
            if (nagariId) {
                allJorongOpts
                    .filter(j => String(j.id_nagari) === nagariId)
                    .forEach(j => {
                        const opt = document.createElement('option');
                        opt.value = j.id_jorong;
                        opt.textContent = j.nama_jorong;
                        if (String(j.id_jorong) === currentJorong) opt.selected = true;
                        jorongSelect.appendChild(opt);
                    });
            }
        }
    </script>

<%- include('../partials/profil') %>

</div>
</body>
</html>
