<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kelola Data Pasien - SI Posbindu</title>
    <link rel="stylesheet" href="/css/output.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
</head>
<body class="bg-slate-50 font-inter antialiased text-slate-800">
    
    <div class="app-shell">
    <%- include('../partials/sidebar', { active: 'pasien' }) %>

    <div class="main-content-wrapper">
        <%- include('../partials/header', { pageTitle: 'Kelola Data Pasien' }) %>

        <main class="p-4 md:p-6 lg:p-8 space-y-6 w-full">
            
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 font-poppins">Kelola Data Pasien</h2>
                    <p class="text-gray-500 text-sm mt-1">Halaman khusus PJ PTM untuk mengedit dan menghapus data master warga.</p>
                </div>
            </div>

            <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 mb-6">
                <div class="flex flex-wrap items-end gap-3">
                    <!-- Cari nama/NIK -->
                    <div class="flex-1 min-w-[200px]">
                        <label class="block text-xs font-semibold text-gray-500 mb-1">Cari Nama / NIK</label>
                        <div class="flex items-center px-3 py-2 rounded-xl border border-gray-200 bg-gray-50 focus-within:bg-white focus-within:border-[#2563EB] transition-all">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400 mr-2 flex-shrink-0"><circle cx="11" cy="11" r="8"/><line x1="21" x2="16.65" y1="21" y2="16.65"/></svg>
                            <input type="text" id="searchPasien" placeholder="Ketik nama atau NIK..." class="w-full bg-transparent border-none outline-none text-sm text-[#1F2937] placeholder-gray-400 focus:ring-0">
                        </div>
                    </div>
                    <!-- Filter Nagari -->
                    <div>
                        <label class="block text-xs font-semibold text-gray-500 mb-1">Nagari</label>
                        <select id="filterNagari" class="border border-gray-200 rounded-xl px-3 py-2 text-sm bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-400 min-w-[160px]">
                            <option value="">Semua Nagari</option>
                            <% if (typeof nagari !== 'undefined') { nagari.forEach(n => { %>
                                <option value="<%= n.id_nagari %>" <%= (typeof selectedNagari !== 'undefined' && String(selectedNagari) === String(n.id_nagari)) ? 'selected' : '' %>><%= n.nama_nagari %></option>
                            <% }); } %>
                        </select>
                    </div>
                    <!-- Filter Jorong (dinamis) -->
                    <div>
                        <label class="block text-xs font-semibold text-gray-500 mb-1">Jorong</label>
                        <select id="filterJorong" class="border border-gray-200 rounded-xl px-3 py-2 text-sm bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-400 min-w-[160px]" disabled>
                            <option value="">Pilih nagari dulu</option>
                        </select>
                    </div>
                    <!-- Tombol reset -->
                    <button id="btnResetFilter" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-600 text-sm font-semibold rounded-xl transition-colors">
                        Reset
                    </button>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-gray-50 border-b border-gray-100">
                                <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">No</th>
                                <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">NIK & Nama</th>
                                <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Usia / L/P</th>
                                <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Nagari</th>
                                <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Jorong</th>
                                <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Alamat</th>
                                <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-right">Aksi</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            <% if (typeof pasien !== 'undefined' && pasien.length > 0) { %>
                                <% pasien.forEach((item, index) => { %>
                                    <tr class="border-b border-gray-50 hover:bg-slate-50 transition-colors baris-pasien" data-nagari="<%= item.id_nagari || '' %>" data-jorong="<%= item.id_jorong %>">
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                                            <%= index + 1 %>
                                        </td>
                                        
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <div class="font-medium text-gray-900"><%= item.nama_pasien %></div>
                                            <div class="text-xs text-gray-500 mt-0.5"><%= item.nik || '-' %></div>
                                        </td>
                                        
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <div class="text-sm text-gray-700"><%= item.usia || '-' %> Tahun</div>
                                            <div class="text-xs text-gray-500 mt-0.5"><%= item.jenis_kelamin || '-' %></div>
                                        </td>
                                        
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                                            <%= item.nama_nagari || '-' %>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                                            <%= item.nama_jorong %>
                                        </td>
                                        
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                                            <%= item.alamat || '-' %>
                                        </td>
                                        
                                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                            <div class="flex items-center justify-end gap-2">
                                                
                                                <a href="/ptm/pasien/detail/<%= item.id_pasien %>" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-blue-600 hover:bg-blue-50 transition-all text-xs font-semibold border border-transparent hover:border-blue-100">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                                                    Detail
                                                </a>
                                                
                                                <a href="/ptm/pasien/edit/<%= item.id_pasien %>" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[#10B981] hover:bg-[#D1FAE5] transition-all text-xs font-semibold border border-transparent hover:border-[#A7F3D0]">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                                                    Edit
                                                </a>
                                                
                                                <form id="form-delete-<%= item.id_pasien %>" action="/ptm/pasien/delete/<%= item.id_pasien %>" method="POST" class="m-0">
                                                    <button type="button" onclick="konfirmasiHapus('<%= item.id_pasien %>')" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-red-600 hover:bg-red-50 transition-all text-xs font-semibold border border-transparent hover:border-red-100">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
                                                        Hapus
                                                    </button>
                                                </form>

                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="7" class="p-10 text-center text-gray-500">
                                        <div class="flex flex-col items-center justify-center">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-gray-300 mb-3"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6"/><path d="M22 11h-6"/></svg>
                                            <p>Belum ada data pasien di database.</p>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <%# ====== PAGINATION ====== %>
                <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                <%
                    const buildPtmPasienUrl = (p) => {
                        const params = new URLSearchParams();
                        if (search) params.set('search', search);
                        if (typeof selectedNagari !== 'undefined' && selectedNagari) params.set('nagari', selectedNagari);
                        if (typeof selectedJorong !== 'undefined' && selectedJorong) params.set('jorong', selectedJorong);
                        params.set('page', p);
                        return '/ptm/pasien?' + params.toString();
                    };
                %>
                <div class="flex items-center justify-between mt-4 px-6 py-4 border-t border-gray-100">
                    <p class="text-sm text-gray-500">
                        Menampilkan halaman <%= page %> dari <%= totalPages %>
                        (<%= totalData %> total pasien)
                    </p>
                    <div class="flex gap-2">
                        <% if (page > 1) { %>
                            <a href="<%= buildPtmPasienUrl(page - 1) %>"
                               class="px-3 py-1.5 rounded-lg border border-gray-200 text-sm text-gray-600 hover:bg-gray-50">
                                ← Sebelumnya
                            </a>
                        <% } %>
                        <% for (let i = Math.max(1, page-2); i <= Math.min(totalPages, page+2); i++) { %>
                            <a href="<%= buildPtmPasienUrl(i) %>"
                               class="px-3 py-1.5 rounded-lg border text-sm
                                      <%= i === page ? 'bg-blue-600 text-white border-blue-600' : 'border-gray-200 text-gray-600 hover:bg-gray-50' %>">
                                <%= i %>
                            </a>
                        <% } %>
                        <% if (page < totalPages) { %>
                            <a href="<%= buildPtmPasienUrl(page + 1) %>"
                               class="px-3 py-1.5 rounded-lg border border-gray-200 text-sm text-gray-600 hover:bg-gray-50">
                                Berikutnya →
                            </a>
                        <% } %>
                    </div>
                </div>
                <% } %>

            </div>

        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // [BARU] Fungsi Pop-up Konfirmasi Hapus
        function konfirmasiHapus(idPasien) {
            Swal.fire({
                title: 'Yakin ingin menghapus?',
                text: "Data pasien ini akan dihapus secara permanen!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#EF4444', // Merah Tailwind
                cancelButtonColor: '#6B7280', // Abu-abu Tailwind
                confirmButtonText: 'Ya, Hapus!',
                cancelButtonText: 'Batal',
                reverseButtons: true, // Biar tombol 'Batal' ada di kiri
                customClass: {
                    title: 'font-poppins font-semibold text-gray-800',
                    popup: 'rounded-2xl'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    // Jika user klik "Ya", submit form secara manual
                    document.getElementById('form-delete-' + idPasien).submit();
                }
            })
        }

        // [BARU] Memunculkan Pop-up otomatis jika ada pesan dari server
        document.addEventListener('DOMContentLoaded', function() {
            // Cek apakah ada pesan sukses dari backend
            <% if (typeof successMessage !== 'undefined' && successMessage) { %>
                Swal.fire({
                    icon: 'success',
                    title: 'Berhasil!',
                    text: '<%= successMessage %>',
                    timer: 3000, // Otomatis hilang dalam 3 detik
                    showConfirmButton: false,
                    customClass: { popup: 'rounded-2xl font-inter' }
                });
            <% } %>

            // Cek apakah ada pesan error dari backend
            <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
                Swal.fire({
                    icon: 'error',
                    title: 'Gagal Dihapus!',
                    text: '<%= errorMessage %>',
                    confirmButtonColor: '#2563EB', // Biru Tailwind
                    customClass: { popup: 'rounded-2xl font-inter' }
                });
            <% } %>
        });
    </script>

    <script>
        // Data jorong per nagari (dari server) - untuk dropdown cascade
        const semuaJorong = <%- JSON.stringify(typeof jorong !== 'undefined' ? jorong : []) %>;

        document.addEventListener('DOMContentLoaded', function() {
            const searchInput  = document.getElementById('searchPasien');
            const filterNagari = document.getElementById('filterNagari');
            const filterJorong = document.getElementById('filterJorong');
            const btnReset      = document.getElementById('btnResetFilter');

            const urlParams      = new URLSearchParams(window.location.search);
            const currentSearch  = urlParams.get('search') || '';
            const currentNagari  = urlParams.get('nagari') || '';
            const currentJorong  = urlParams.get('jorong') || '';

            searchInput.value = currentSearch;
            if (currentNagari) filterNagari.value = currentNagari;

            // Bangun ulang dropdown jorong sesuai nagari yang aktif di URL
            function populateJorong(idNagari, selectedJorongId) {
                filterJorong.innerHTML = '<option value="">Semua Jorong</option>';
                if (idNagari) {
                    filterJorong.disabled = false;
                    const jorongFiltered = semuaJorong.filter(j => String(j.id_nagari) === String(idNagari));
                    jorongFiltered.forEach(j => {
                        const opt = document.createElement('option');
                        opt.value = j.id_jorong;
                        opt.textContent = j.nama_jorong;
                        if (selectedJorongId && String(j.id_jorong) === String(selectedJorongId)) opt.selected = true;
                        filterJorong.appendChild(opt);
                    });
                } else {
                    filterJorong.disabled = true;
                    filterJorong.innerHTML = '<option value="">Pilih nagari dulu</option>';
                }
            }
            populateJorong(currentNagari, currentJorong);

            // Kirim search/filter ke server (reset ke halaman 1), agar konsisten dengan pagination
            function navigate(overrides) {
                const params = new URLSearchParams(window.location.search);
                const state = {
                    search: params.get('search') || '',
                    nagari: params.get('nagari') || '',
                    jorong: params.get('jorong') || '',
                    page:   params.get('page')   || 1,
                };
                Object.assign(state, overrides);

                const qs = new URLSearchParams();
                if (state.search) qs.set('search', state.search);
                if (state.nagari) qs.set('nagari', state.nagari);
                if (state.jorong) qs.set('jorong', state.jorong);
                qs.set('page', state.page);
                window.location.href = '/ptm/pasien?' + qs.toString();
            }

            let debounceTimer;
            searchInput.addEventListener('input', function() {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(function() {
                    navigate({ search: searchInput.value.trim(), page: 1 });
                }, 500);
            });

            filterNagari.addEventListener('change', function() {
                navigate({ nagari: filterNagari.value, jorong: '', page: 1 });
            });

            filterJorong.addEventListener('change', function() {
                navigate({ jorong: filterJorong.value, page: 1 });
            });

            btnReset.addEventListener('click', function() {
                window.location.href = '/ptm/pasien';
            });
        });
    </script>

<%- include('../partials/profil') %>

</div>
</body>
</html>