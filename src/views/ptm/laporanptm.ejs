                                <div class="bg-[#F8FAFC] rounded-xl p-4 text-center border border-gray-50"><p class="text-2xl font-poppins font-bold text-[#EF4444]">628</p><p class="text-[#6B7280] text-xs mt-1.5 font-medium">Kasus Hipertensi</p></div>
                                <div class="bg-[#F8FAFC] rounded-xl p-4 text-center border border-gray-50"><p class="text-2xl font-poppins font-bold text-[#10B981]">71.8%</p><p class="text-[#6B7280] text-xs mt-1.5 font-medium">Tekanan Terkendali</p></div>
                                <div class="bg-[#F8FAFC] rounded-xl p-4 text-center border border-gray-50"><p class="text-2xl font-poppins font-bold text-[#F59E0B]">80.7%</p><p class="text-[#6B7280] text-xs mt-1.5 font-medium">Capaian Target</p></div>
                            </div>

                            <div class="mt-5 bg-[#F0F9FF] border border-[#BAE6FD] rounded-xl p-4 flex gap-3">
                                <div class="text-[#0284C7] mt-0.5 flex-shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
                                </div>
                                <div>
                                    <p class="text-[#0C4A6E] text-xs font-semibold mb-1">Narasi Laporan (Otomatis)</p>
                                    <p id="narasi-preview" class="text-[#0C4A6E] text-xs leading-relaxed">
                                        Narasi belum tersedia.
                                    </p>
                                </div>
                            </div>
                            </div>

                        <div class="px-8 py-6 border-b border-gray-100">
                            <h4 class="text-[#1F2937] mb-5 font-poppins font-semibold">Distribusi per Nagari</h4>
                            <div class="w-full h-[250px]">
                                <canvas id="previewChart"></canvas>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
                        <div class="flex items-center gap-3">
                            <div id="badge-step-3" class="w-7 h-7 rounded-full flex items-center justify-center text-xs bg-[#2563EB] text-white font-bold transition-colors">3</div>
                            <span class="text-[#1F2937] font-poppins font-semibold">Simpan & Ajukan Laporan</span>
                        </div>
                        
                        <div class="flex flex-wrap items-center gap-3 w-full sm:w-auto">
                            <button onclick="alert('Mencetak...')" class="flex-1 sm:flex-none flex items-center justify-center gap-2 border border-gray-200 text-[#6B7280] px-4 py-2.5 rounded-xl text-sm hover:bg-gray-50 transition-all font-medium">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect width="12" height="8" x="6" y="14"/></svg>
                            </button>
                            <button onclick="alert('Mengunduh PDF...')" class="flex-1 sm:flex-none flex items-center justify-center gap-2 border border-gray-200 text-[#6B7280] px-4 py-2.5 rounded-xl text-sm hover:bg-gray-50 transition-all font-medium">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                            </button>
                            
                            <button id="btn-simpan" onclick="simpanLaporan()" class="flex-1 sm:flex-none flex items-center justify-center gap-2 bg-[#10B981] hover:bg-[#059669] text-white px-6 py-2.5 rounded-xl text-sm transition-all font-medium shadow-sm">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                                Simpan Draft
                            </button>
                            <button id="btn-ajukan" onclick="ajukanLaporan()" class="hidden-el flex-1 sm:flex-none flex items-center justify-center gap-2 bg-[#F59E0B] hover:bg-[#D97706] text-white px-6 py-2.5 rounded-xl text-sm transition-all font-medium shadow-sm">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" x2="11" y1="2" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                                Ajukan ke Kepala
                            </button>
                            
                            <div id="msg-success" class="hidden-el flex items-center gap-2 text-[#10B981] text-sm font-semibold bg-[#D1FAE5] px-4 py-2.5 rounded-xl">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                                Laporan Diajukan!
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <script>
        // Logika Tab Navigasi
        function switchTab(tab) {
            const btnList = document.getElementById('tab-list');
            const btnBuat = document.getElementById('tab-buat');
            const secList = document.getElementById('section-list');
            const secBuat = document.getElementById('section-buat');
            const headBtn = document.getElementById('headerActionBtn');
            const detContainer = document.getElementById('detail-container');
            const tableContainer = document.getElementById('list-table-container');

            if (tab === 'list') {
                btnList.className = "px-5 py-2 rounded-lg text-sm transition-all bg-white text-[#2563EB] shadow-sm font-semibold flex items-center gap-2";
                btnBuat.className = "px-5 py-2 rounded-lg text-sm transition-all text-[#6B7280] hover:text-[#1F2937] flex items-center gap-2";
                secList.classList.remove('hidden-el');
                secBuat.classList.add('hidden-el');
                headBtn.innerHTML = `<button onclick="switchTab('buat')" class="flex items-center gap-2 bg-[#2563EB] hover:bg-[#1D4ED8] text-white px-5 py-2.5 rounded-xl text-sm transition-all font-medium shadow-sm"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg> Buat Laporan</button>`;
                // Pastikan kembali ke table view jika sedang di detail
                detContainer.classList.add('hidden-el');
                tableContainer.classList.remove('hidden-el');
            } else {
                btnBuat.className = "px-5 py-2 rounded-lg text-sm transition-all bg-white text-[#2563EB] shadow-sm font-semibold flex items-center gap-2";
                btnList.className = "px-5 py-2 rounded-lg text-sm transition-all text-[#6B7280] hover:text-[#1F2937] flex items-center gap-2";
                secBuat.classList.remove('hidden-el');
                secList.classList.add('hidden-el');
                headBtn.innerHTML = `<button onclick="switchTab('list')" class="flex items-center gap-2 border border-gray-200 text-[#6B7280] px-5 py-2.5 rounded-xl text-sm hover:bg-gray-50 transition-all font-medium"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg> Kembali ke List</button>`;
            }
        }

        // Logika Detail List
        // [BARU] Variabel global untuk menyimpan ID laporan yang sedang dilihat
        let idLaporanTerpilih = null;

        function showDetail(periode) {
            document.getElementById('list-table-container').classList.add('hidden-el');
            document.getElementById('detail-container').classList.remove('hidden-el');
            document.getElementById('detail-title').innerText = `Laporan Monitoring Hipertensi — ${periode}`;
            document.getElementById('det-periode').innerText = periode;
            
            // Mencari data laporan dari list
            const laporan = daftarLaporan.find(l => {
                const labelPeriode = NAMA_BULAN[l.periode_bulan - 1] + ' ' + l.periode_tahun;
                return labelPeriode === periode;
            });

            const narasiEl = document.getElementById('narasi-detail');
            
            if (laporan) {
                // [BARU] Simpan ID ke variabel global agar bisa dipakai fungsi unduhExcel
                idLaporanTerpilih = laporan.id_laporan;
                narasiEl.textContent = laporan.narasi_laporan || 'Narasi belum tersedia.';
                console.log("Laporan dipilih, ID:", idLaporanTerpilih); // Cek di console (F12)
            } else {
                idLaporanTerpilih = null;
                narasiEl.textContent = 'Data laporan tidak ditemukan.';
            }
        }

        // [BARU] Fungsi khusus untuk menangani klik tombol download
        function unduhExcel() {
            console.log("Mencoba mengunduh ID:", idLaporanTerpilih);
            if (idLaporanTerpilih) {
                window.location.href = `/ptm/laporan/export/${idLaporanTerpilih}`;
            } else {
                alert("Silakan pilih laporan terlebih dahulu.");
            }
        }
        function hideDetail() {
            document.getElementById('detail-container').classList.add('hidden-el');
            document.getElementById('list-table-container').classList.remove('hidden-el');
        }

        // [BARU] Array nama bulan di sisi klien — sama persis dengan yang ada di controller
        // Digunakan untuk: (1) showDetail() mencari laporan, (2) hitungNarasiPreview()
        const NAMA_BULAN = [
            'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni',
            'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'
        ];
        
        // [BARU] Data laporan dari server — digunakan oleh showDetail() untuk mencari narasi
        // daftarLaporan dikirim dari renderLaporanPTM() sebagai variabel EJS
        const daftarLaporan = <%- JSON.stringify(daftarLaporan) %>;
        
        /**
         * [BARU] Fungsi: hitungNarasiPreview()
         * Menghasilkan narasi deskriptif di sisi klien untuk preview sebelum disimpan.
         * Logika identik dengan bentukNarasiLaporan() di controller — hanya fakta angka.
         *
         * @param {string} periodeTeks  - Teks periode dari dropdown, misal "Januari 2025"
         * @param {number} totalPasien  - Jumlah pasien unik
         * @param {number} totalSkrining- Jumlah total kunjungan
         * @returns {string}            - Kalimat narasi deskriptif
         */
        function hitungNarasiPreview(periodeTeks, totalPasien, totalSkrining) {
            // [BARU] Hitung rata-rata kunjungan per pasien, dibulatkan 2 desimal
            const rataRata = totalPasien > 0 ? (totalSkrining / totalPasien).toFixed(2) : '0.00';
            
            // [BARU] Format angka dengan pemisah ribuan Bahasa Indonesia
            const pasienFormatted   = parseInt(totalPasien).toLocaleString('id-ID');
            const skriningFormatted = parseInt(totalSkrining).toLocaleString('id-ID');

            // [BARU] Susun narasi — hanya fakta angka, tanpa rekomendasi klinis
            return `Pada bulan ${periodeTeks}, tercatat ${pasienFormatted} pasien ` +
                   `yang menjalani pemeriksaan dengan total ${skriningFormatted} kunjungan skrining. ` +
                   `Rata-rata kunjungan per pasien pada periode ini adalah ${rataRata} kali.`;
        }

        // Logika Generate Laporan Baru (Step 1, 2, 3)
        let chartInstance = null;
        
        function resetPreview() {
            document.getElementById('step-preview').classList.add('hidden-el');
            document.getElementById('btn-generate').innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg> Generate Preview Data`;
            document.getElementById('btn-generate').classList.remove('bg-[#10B981]', 'hover:bg-[#059669]');
            document.getElementById('badge-step-1').classList.remove('bg-[#10B981]');
            
            // Reset state step 3
            document.getElementById('btn-simpan').classList.remove('hidden-el');
            document.getElementById('btn-ajukan').classList.add('hidden-el');
            document.getElementById('msg-success').classList.add('hidden-el');
            document.getElementById('badge-step-2').classList.remove('bg-[#10B981]');
            document.getElementById('badge-step-3').classList.remove('bg-[#10B981]');

            // [BARU] Reset narasi preview ke placeholder saat periode diganti
            document.getElementById('narasi-preview').textContent = 'Narasi belum tersedia.';
        }

        function generatePreview() {
            const periode = document.getElementById('select-periode').value;
            if(!periode) {
                document.getElementById('error-periode').classList.remove('hidden-el');
                return;
            }
            document.getElementById('error-periode').classList.add('hidden-el');
            
            // Ubah UI Step 1 ke Selesai
            document.getElementById('btn-generate').innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg> Data Ter-generate`;
            document.getElementById('btn-generate').classList.add('bg-[#10B981]', 'hover:bg-[#059669]');
            document.getElementById('badge-step-1').innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`;
            document.getElementById('badge-step-1').classList.add('bg-[#10B981]');
            
            // Tampilkan Step 2 dan set teks
            document.getElementById('prev-periode').innerText = periode;
            document.getElementById('step-preview').classList.remove('hidden-el');

            // [BARU] Hitung dan tampilkan narasi otomatis di preview
            // Data dummy 1.615 pasien dan 1.745 skrining dipakai karena preview masih simulasi.
            // Saat integrasi database selesai, ganti angka ini dengan data dari response server.
            const totalPasienPreview   = 1615; // [BARU] placeholder — ganti dengan data real dari DB
            const totalSkriningPreview = 1745; // [BARU] placeholder — ganti dengan data real dari DB
            const narasiOtomatis = hitungNarasiPreview(periode, totalPasienPreview, totalSkriningPreview);
            document.getElementById('narasi-preview').textContent = narasiOtomatis; // [BARU]

            // Inisialisasi Chart jika belum
            if(!chartInstance) {
                Chart.defaults.font.family = "'Inter', sans-serif";
                const ctx = document.getElementById('previewChart').getContext('2d');
                chartInstance = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: ["Sg. Tarab", "Baringin", "Salimpaung", "Tigo Jangko", "Guguak"],
                        datasets: [
                            { label: 'Total Pasien', data: [420, 380, 310, 290, 215], backgroundColor: '#2563EB', borderRadius: 4, barPercentage: 0.6 },
                            { label: 'Hipertensi', data: [165, 148, 122, 110, 83], backgroundColor: '#EF4444', borderRadius: 4, barPercentage: 0.6 }
                        ]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 8 } } },
                        scales: {
                            x: { grid: { display: false } },
                            y: { grid: { color: '#F3F4F6', strokeDash: [3, 3] }, min: 0 }
                        }
                    }
                });
            }
        }

        function simpanLaporan() {
            document.getElementById('btn-simpan').classList.add('hidden-el');
            document.getElementById('btn-ajukan').classList.remove('hidden-el');
            document.getElementById('badge-step-2').innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`;
            document.getElementById('badge-step-2').classList.add('bg-[#10B981]');
        }

        function ajukanLaporan() {
            const btnExcel = document.getElementById('btn-unduh-excel');
            if (laporan) {
                btnExcel.onclick = function() {
                    window.location.href = `/ptm/laporan/export/${laporan.id_laporan}`;
                };
            }

            setTimeout(() => {
                btn.classList.add('hidden-el');
                document.getElementById('msg-success').classList.remove('hidden-el');
                document.getElementById('badge-step-3').innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`;
                document.getElementById('badge-step-3').classList.add('bg-[#10B981]');
                btn.disabled = false;
            }, 1000);
        }
    </script>
</body>
</html>