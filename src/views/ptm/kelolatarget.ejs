<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kelola Target Capaian – SI-Posbindu</title>
    <link rel="stylesheet" href="/css/output.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        .font-poppins { font-family: 'Poppins', sans-serif; }
        .font-inter   { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 font-inter antialiased text-slate-800">

    <div class="app-shell">
    <%- include('../partials/sidebar', { active: 'target' }) %>

    <div class="main-content-wrapper">
        <%- include('../partials/header', { pageTitle: 'Kelola Target Capaian' }) %>

        <main class="p-4 md:p-6 lg:p-8 space-y-6 w-full">

            <!-- Page Title -->
            <div class="mt-2">
                <h2 class="text-[#1F2937] font-poppins font-semibold text-xl">Kelola Target Capaian</h2>
                <p class="text-[#6B7280] text-sm mt-1">Atur target jumlah pasien skrining hipertensi per tahun</p>
            </div>

            <!-- Flash Messages -->
            <% if (successMessage) { %>
            <div id="flashSuccess" class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-xl flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-600 flex-shrink-0"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                <span class="text-sm font-medium"><%= successMessage %></span>
                <button onclick="this.parentElement.remove()" class="ml-auto text-green-600 hover:text-green-800">✕</button>
            </div>
            <% } %>
            <% if (errorMessage) { %>
            <div id="flashError" class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-xl flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-red-600 flex-shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
                <span class="text-sm font-medium"><%= errorMessage %></span>
                <button onclick="this.parentElement.remove()" class="ml-auto text-red-600 hover:text-red-800">✕</button>
            </div>
            <% } %>

            <div class="grid grid-cols-1 lg:grid-cols-5 gap-6 items-start">

                <!-- ─── FORM TAMBAH / EDIT TARGET ─── -->
                <div class="lg:col-span-2 bg-white border border-gray-100 rounded-2xl shadow-sm overflow-hidden">
                    <div class="px-6 py-5 border-b border-gray-100 flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-blue-100 flex items-center justify-center text-blue-600">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
                        </div>
                        <h3 class="font-poppins font-semibold text-gray-800">Set Target Tahunan</h3>
                    </div>

                    <form action="/ptm/target/simpan" method="POST" class="px-6 py-5 space-y-4">

                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1.5">
                                Tahun <span class="text-red-500">*</span>
                            </label>
                            <input type="number" name="tahun" id="inputTahun"
                                value="<%= tahunIni %>" min="2020" max="2099" required
                                class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/30"
                                placeholder="Contoh: 2025">
                            <p class="text-xs text-gray-400 mt-1">Jika tahun sudah ada, data lama akan diperbarui.</p>
                        </div>

                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1.5">
                                Target Total Pasien <span class="text-red-500">*</span>
                            </label>
                            <div class="relative">
                                <input type="number" name="target_total" id="inputTarget"
                                    min="1" required
                                    class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/30 pr-20"
                                    placeholder="Contoh: 2500">
                                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-gray-400 font-medium">pasien</span>
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1.5">Catatan <span class="text-gray-400">(opsional)</span></label>
                            <textarea name="catatan" rows="2"
                                class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/30 resize-none"
                                placeholder="Contoh: Target naik 10% dari tahun lalu"></textarea>
                        </div>

                        <!-- Preview kalkulasi -->
                        <div id="previewKalkulasi" class="hidden bg-blue-50 border border-blue-100 rounded-xl p-4 space-y-2">
                            <p class="text-xs font-semibold text-blue-700 uppercase tracking-wider">Preview Distribusi</p>
                            <div class="grid grid-cols-2 gap-2 text-xs text-blue-800">
                                <div>Per bulan: <strong id="prevBulan">–</strong></div>
                                <div>Per minggu: <strong id="prevMinggu">–</strong></div>
                                <div>Per hari kerja: <strong id="prevHari">–</strong></div>
                            </div>
                        </div>

                        <button type="submit"
                            class="w-full bg-[#2563EB] hover:bg-[#1D4ED8] text-white py-2.5 rounded-xl text-sm font-medium transition-colors flex items-center justify-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                            Simpan Target
                        </button>
                    </form>
                </div>

                <!-- ─── TABEL RIWAYAT TARGET ─── -->
                <div class="lg:col-span-3 bg-white border border-gray-100 rounded-2xl shadow-sm overflow-hidden">
                    <div class="px-6 py-5 border-b border-gray-100 flex items-center justify-between">
                        <h3 class="font-poppins font-semibold text-gray-800">Riwayat Target Per Tahun</h3>
                        <span class="text-xs text-gray-400"><%= targets.length %> tahun tercatat</span>
                    </div>

                    <% if (targets.length === 0) { %>
                    <div class="px-6 py-12 text-center text-gray-400">
                        <svg class="mx-auto mb-3 text-gray-300" xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                        <p class="text-sm">Belum ada target yang disimpan.</p>
                        <p class="text-xs mt-1">Gunakan form di sebelah kiri untuk menambahkan target pertama.</p>
                    </div>
                    <% } else { %>
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead>
                                <tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider">
                                    <th class="px-5 py-3 text-left font-medium">Tahun</th>
                                    <th class="px-5 py-3 text-right font-medium">Target</th>
                                    <th class="px-5 py-3 text-left font-medium">Catatan</th>
                                    <th class="px-5 py-3 text-left font-medium">Diperbarui</th>
                                    <th class="px-5 py-3 text-center font-medium">Aksi</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100">
                                <% targets.forEach(t => { %>
                                <tr class="hover:bg-gray-50/50 transition-colors">
                                    <td class="px-5 py-4">
                                        <div class="flex items-center gap-2">
                                            <% if (t.tahun === tahunIni) { %>
                                            <span class="px-2 py-0.5 bg-blue-100 text-blue-700 text-[10px] font-bold rounded-full">AKTIF</span>
                                            <% } %>
                                            <span class="font-poppins font-semibold text-gray-800 text-base"><%= t.tahun %></span>
                                        </div>
                                    </td>
                                    <td class="px-5 py-4 text-right">
                                        <span class="font-semibold text-gray-800"><%= parseInt(t.target_total).toLocaleString('id-ID') %></span>
                                        <span class="text-xs text-gray-400 ml-1">pasien</span>
                                    </td>
                                    <td class="px-5 py-4 text-gray-500 text-xs max-w-[160px] truncate">
                                        <%= t.catatan || '–' %>
                                    </td>
                                    <td class="px-5 py-4 text-gray-400 text-xs">
                                        <%= new Date(t.diubah_pada).toLocaleDateString('id-ID', { day:'numeric', month:'short', year:'numeric' }) %>
                                    </td>
                                    <td class="px-5 py-4 text-center">
                                        <div class="flex items-center justify-center gap-2">
                                            <!-- Tombol Edit: isi form di kiri -->
                                            <button onclick="isiForm(<%= t.tahun %>, <%= t.target_total %>, `<%= (t.catatan || '').replace(/`/g,'') %>`)"
                                                class="p-2 rounded-lg bg-blue-50 text-blue-600 hover:bg-blue-100 transition-colors" title="Edit target ini">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
                                            </button>
                                            <!-- Tombol Hapus -->
                                            <button onclick="konfirmasiHapus(<%= t.id_target %>, <%= t.tahun %>)"
                                                class="p-2 rounded-lg bg-red-50 text-red-500 hover:bg-red-100 transition-colors" title="Hapus target ini">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% } %>
                </div>
            </div>

            <!-- ─── INFO BOX ─── -->
            <div class="bg-amber-50 border border-amber-200 rounded-2xl px-6 py-4 flex items-start gap-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 mt-0.5"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                <div>
                    <p class="text-sm font-semibold text-amber-800">Catatan Penting</p>
                    <p class="text-xs text-amber-700 mt-1 leading-relaxed">
                        Target yang disimpan di sini akan langsung digunakan oleh <strong>Dashboard PTM</strong> untuk menghitung persentase capaian tahun berjalan.
                        Jika tidak ada target untuk tahun tertentu, sistem akan menggunakan nilai default <strong>2.000 pasien</strong>.
                    </p>
                </div>
            </div>

        </main>
    </div>


    <!-- Modal Konfirmasi Hapus -->
    <div id="modalHapus" class="hidden fixed inset-0 bg-black/40 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-sm p-6 text-center">
            <div class="w-12 h-12 rounded-full bg-red-100 flex items-center justify-center mx-auto mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
            </div>
            <h3 class="font-poppins font-semibold text-gray-800 text-lg mb-2">Hapus Target?</h3>
            <p class="text-sm text-gray-500 mb-6" id="pesanHapus"></p>
            <form id="formHapus" method="POST">
                <div class="flex gap-3">
                    <button type="button" onclick="document.getElementById('modalHapus').classList.add('hidden')"
                        class="flex-1 border border-gray-200 text-gray-600 py-2.5 rounded-xl text-sm hover:bg-gray-50">
                        Batal
                    </button>
                    <button type="submit"
                        class="flex-1 bg-red-500 hover:bg-red-600 text-white py-2.5 rounded-xl text-sm font-medium">
                        Ya, Hapus
                    </button>
                </div>
            </form>
        </div>
    </div>


    <script>
        // ── Isi form dari baris tabel (tombol Edit) ──────────
        function isiForm(tahun, target, catatan) {
            document.getElementById('inputTahun').value  = tahun;
            document.getElementById('inputTarget').value = target;
            document.querySelector('textarea[name="catatan"]').value = catatan;
            hitungPreview();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // ── Preview distribusi target ────────────────────────
        const inputTarget = document.getElementById('inputTarget');
        inputTarget.addEventListener('input', hitungPreview);

        function hitungPreview() {
            const total = parseInt(inputTarget.value);
            const box   = document.getElementById('previewKalkulasi');
            if (!total || total <= 0) { box.classList.add('hidden'); return; }

            const perBulan  = Math.ceil(total / 12);
            const perMinggu = Math.ceil(total / 52);
            const perHari   = Math.ceil(total / (52 * 5)); // 5 hari kerja/minggu

            document.getElementById('prevBulan').textContent  = perBulan.toLocaleString('id-ID') + ' pasien';
            document.getElementById('prevMinggu').textContent = perMinggu.toLocaleString('id-ID') + ' pasien';
            document.getElementById('prevHari').textContent   = perHari.toLocaleString('id-ID') + ' pasien';
            box.classList.remove('hidden');
        }

        // Hapus Target
        function konfirmasiHapus(idTarget, tahun) {
            document.getElementById('pesanHapus').textContent =
                `Target tahun ${tahun} akan dihapus permanen. Data capaian pasien tidak terpengaruh.`;
            document.getElementById('formHapus').action = `/ptm/target/hapus/${idTarget}`;
            document.getElementById('modalHapus').classList.remove('hidden');
        }
    </script>

<%- include("../partials/profil") %>
</div>
</body>
</html>
