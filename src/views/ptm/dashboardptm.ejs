<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard PTM</title>
    <link rel="stylesheet" href="/css/output.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        .font-poppins { font-family: 'Poppins', sans-serif; }
        .font-inter { font-family: 'Inter', sans-serif; }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-slate-50 font-inter antialiased text-slate-800">
    
    <div class="app-shell">
    <%- include('../partials/sidebar', { active: 'dashboard', role: 'ptm' }) %>

    <div class="main-content-wrapper">
       <%- include('../partials/header', { pageTitle: 'Dashboard Program PTM', role: 'ptm' }) %>

        <main class="p-4 md:p-6 lg:p-8 space-y-6 w-full">
            <div class="flex items-start justify-between mt-2">
                <div>
                    <h2 class="text-[#1F2937] font-poppins font-semibold text-xl">Dashboard Program PTM</h2>
                    <p class="text-[#6B7280] text-sm mt-1">Periode Tahun <%= tahunIni %> · Puskesmas IV Koto</p>
                </div>
                <a href="/ptm/laporan" class="bg-[#2563EB] hover:bg-[#1D4ED8] text-white px-5 py-2.5 rounded-xl text-sm transition-all font-medium shadow-sm flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                    Generate Laporan
                </a>
            </div>
            
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
                
                <div class="bg-white border border-gray-100 rounded-2xl p-6 shadow-sm flex flex-col items-center h-full">
                    <div class="w-full flex justify-start mb-4">
                        <h3 class="text-[#1F2937] font-poppins font-semibold text-lg">Progres Target Tahunan</h3>
                    </div>
                    <div class="relative w-48 h-48">
                        <canvas id="targetDonutChart"></canvas>
                        <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
                            <span class="text-3xl font-poppins font-bold text-[#1F2937]"><%= persenTarget %>%</span>
                        </div>
                    </div>
                    <div class="flex flex-col gap-2 mt-6 w-full">
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-[#2563EB]"></span>
                            <span class="text-sm text-[#4B5563] font-medium">Tercapai: <%= totalTercapai.toLocaleString('id-ID') %> pasien</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-[#E5E7EB]"></span>
                            <span class="text-sm text-[#4B5563] font-medium">Sisa: <%= sisaTarget.toLocaleString('id-ID') %> pasien</span>
                        </div>
                    </div>
                </div>

                <div class="lg:col-span-2 bg-white border border-gray-100 rounded-2xl p-6 shadow-sm h-full">
                    <div class="flex items-center justify-between mb-6">
                        <h3 class="text-[#1F2937] font-poppins font-semibold text-lg">Capaian Per Nagari</h3>
                        <span class="text-xs text-gray-500 font-medium px-3 py-1 bg-gray-50 rounded-full border border-gray-100">Tahun Ini</span>
                    </div>
                    <div class="w-full h-[300px]">
                        <canvas id="nagariChart"></canvas>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 flex flex-col justify-between">
                    <div class="flex justify-between items-start mb-4">
                        <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        </div>
                    </div>
                    <div>
                        <p class="text-3xl font-poppins font-bold text-gray-800"><%= totalTercapai.toLocaleString('id-ID') %></p>
                        <p class="text-gray-500 text-xs font-medium mt-1">Total Pasien Skrining <span class="text-gray-400 font-normal ml-1">Target: <%= TARGET_TAHUNAN.toLocaleString('id-ID') %></span></p>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 flex flex-col justify-between">
                    <div class="flex justify-between items-start mb-4">
                        <div class="w-10 h-10 rounded-xl bg-green-100 text-green-600 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                        </div>
                        <span class="px-2 py-1 bg-green-50 text-green-600 text-[10px] font-semibold rounded-md border border-green-200">On Track</span>
                    </div>
                    <div>
                        <p class="text-3xl font-poppins font-bold text-gray-800"><%= persenTarget %>%</p>
                        <p class="text-gray-500 text-xs font-medium mt-1">Capaian Target</p>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 flex flex-col justify-between">
                    <div class="flex justify-between items-start mb-4">
                        <div class="w-10 h-10 rounded-xl bg-red-100 text-red-600 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                        </div>
                    </div>
                    <div>
                        <p class="text-3xl font-poppins font-bold text-gray-800"><%= totalHipertensi.toLocaleString('id-ID') %></p>
                        <p class="text-gray-500 text-xs font-medium mt-1">Kasus Hipertensi <span class="text-gray-400 font-normal ml-1"><%= persenHipertensi %>% dari total</span></p>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 flex flex-col justify-between">
                    <div class="flex justify-between items-start mb-4">
                        <div class="w-10 h-10 rounded-xl bg-green-100 text-green-600 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
                        </div>
                    </div>
                    <div>
                        <p class="text-3xl font-poppins font-bold text-gray-800"><%= persenTerkendali %>%</p>
                        <p class="text-gray-500 text-xs font-medium mt-1">Tekanan Terkendali</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden flex flex-col">
                <div class="px-6 py-5 border-b border-gray-100">
                    <h3 class="text-[#1F2937] font-poppins font-semibold">Rincian per Nagari</h3>
                </div>
                <div class="overflow-x-auto flex-1">
                    <table class="w-full h-full">
                        <thead>
                            <tr class="bg-[#F8FAFC] border-b border-gray-100">
                                <th class="text-left px-5 py-3 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Nagari</th>
                                <th class="text-center px-5 py-3 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Capaian</th>
                                <th class="text-center px-5 py-3 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Target</th>
                                <th class="text-center px-5 py-3 text-xs text-[#6B7280] uppercase tracking-wider font-medium">%</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-50">
                            <% 
                                const boxColors = ["#2563EB", "#10B981", "#F59E0B", "#8B5CF6", "#EF4444", "#14B8A6"]; 
                            %>
                            <% dataNagari.forEach((nagari, i) => { %>
                                <% 
                                    let warnaBg = nagari.persentase >= 80 ? 'bg-[#D1FAE5]' : (nagari.persentase >= 50 ? 'bg-[#FEF3C7]' : 'bg-[#FEE2E2]');
                                    let warnaText = nagari.persentase >= 80 ? 'text-[#059669]' : (nagari.persentase >= 50 ? 'text-[#D97706]' : 'text-[#EF4444]');
                                %>
                                <tr class="hover:bg-gray-50">
                                    <td class="px-5 py-4 text-sm font-medium text-[#1F2937]">
                                        <div class="flex items-center gap-2">
                                            <div class="w-3 h-3 rounded-sm" style="background-color: <%= boxColors[i % boxColors.length] %>"></div>
                                            <%= nagari.nama_nagari %>
                                        </div>
                                    </td>
                                    <td class="px-5 py-4 text-sm text-center font-medium"><%= nagari.capaian %> pasien</td>
                                    <td class="px-5 py-4 text-sm text-center text-[#6B7280]"><%= nagari.target %> pasien</td>
                                    <td class="px-5 py-4 text-center">
                                        <span class="text-xs px-2 py-0.5 rounded-full <%= warnaBg %> <%= warnaText %> font-medium"><%= nagari.persentase %>%</span>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            Chart.defaults.font.family = "'Inter', sans-serif";
            Chart.defaults.color = '#6B7280';

            // Ambil data yang diinjeksi EJS
            const capaianTercapai = parseInt('<%= totalTercapai %>');
            const sisaTarget      = parseInt('<%= sisaTarget %>');
            const rawDataNagari   = <%- JSON.stringify(dataNagari) %>;

            // Mapping data chart Nagari
            const nagariLabels = rawDataNagari.map(n => n.nama_nagari);
            const nagariCapaian = rawDataNagari.map(n => n.capaian);
            const nagariTarget = rawDataNagari.map(n => n.target);

            // 1. Donut Chart Target Tahunan
            const donutCtx = document.getElementById('targetDonutChart').getContext('2d');
            new Chart(donutCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Tercapai', 'Sisa Target'],
                    datasets: [{
                        data: [capaianTercapai, sisaTarget],
                        backgroundColor: ['#2563EB', '#E5E7EB'], 
                        borderWidth: 0, hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false, cutout: '75%',
                    plugins: { 
                        legend: { display: false },
                        tooltip: { backgroundColor: 'white', titleColor: '#1F2937', bodyColor: '#4B5563', borderColor: '#E5E7EB', borderWidth: 1, padding: 10, bodyFont: { family: "'Inter', sans-serif" } }
                    }
                }
            });

            // 2. Bar Chart Per Nagari
            const nagariCtx = document.getElementById('nagariChart').getContext('2d');
            new Chart(nagariCtx, {
                type: 'bar',
                data: {
                    labels: nagariLabels,
                    datasets: [
                        { label: 'Capaian', data: nagariCapaian, backgroundColor: '#2563EB', borderRadius: 6, barPercentage: 0.6 },
                        { label: 'Target', data: nagariTarget, backgroundColor: '#E5E7EB', borderRadius: 6, barPercentage: 0.6 }
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { display: false } },
                        y: { grid: { color: '#F3F4F6', strokeDash: [3, 3] }, min: 0 }
                    }
                }
            });
        });
    </script>

<%- include('../partials/profil') %>

</div>
</body>
</html>  