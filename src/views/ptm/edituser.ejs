<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit User – SI-Posbindu</title>
    <link rel="stylesheet" href="/css/output.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        .font-poppins { font-family: 'Poppins', sans-serif; }
        .font-inter   { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 font-inter antialiased text-slate-800">

    <div class="app-shell">
    <%- include('../partials/sidebar', { active: 'user' }) %>

    <div class="main-content-wrapper">
        <%- include('../partials/header', { pageTitle: 'Edit Akun User' }) %>

        <main class="p-8 w-full">

            <!-- Breadcrumb -->
            <div class="flex items-center gap-2 text-sm text-gray-500 mb-6">
                <a href="/ptm/user" class="hover:text-blue-600 transition-colors">Kelola User</a>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                <span class="text-gray-800 font-medium">Edit User</span>
            </div>

            <div class="bg-white border border-gray-100 rounded-2xl shadow-sm overflow-hidden">
                <!-- Header Card -->
                <div class="px-8 py-6 border-b border-gray-100 bg-gradient-to-r from-blue-50 to-white flex items-center justify-between">
                    <div class="flex items-center gap-4">
                        <div class="w-14 h-14 rounded-2xl bg-[#2563EB]/10 flex items-center justify-center text-[#2563EB] font-bold text-2xl font-poppins">
                            <%= editUser.nama_user.charAt(0).toUpperCase() %>
                        </div>
                        <div>
                            <h2 class="font-poppins font-semibold text-gray-800 text-lg"><%= editUser.nama_user %></h2>
                            <p class="text-sm text-gray-500 font-mono"><%= editUser.username %></p>
                        </div>
                    </div>

                </div>

                <!-- Form -->
                <form action="/ptm/user/update" method="POST" class="px-8 py-6">
                    <input type="hidden" name="id_user" value="<%= editUser.id_user %>">

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        <!-- Nama Lengkap -->
                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1.5">Nama Lengkap <span class="text-red-500">*</span></label>
                            <input type="text" name="nama_user" required value="<%= editUser.nama_user %>"
                                class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/30 bg-white">
                        </div>

                        <!-- Username -->
                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1.5">Username <span class="text-red-500">*</span></label>
                            <input type="text" name="username" required value="<%= editUser.username %>"
                                class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/30 bg-white font-mono">
                            <p class="text-xs text-gray-400 mt-1">Tidak boleh sama dengan username user lain.</p>
                        </div>

                        <!-- Role -->
                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1.5">Role <span class="text-red-500">*</span></label>
                            <select name="role" required id="roleEdit" onchange="handleRoleChange()"
                                class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/30 bg-white">
                                <option value="kader"            <%= editUser.role === 'kader'            ? 'selected' : '' %>>Kader</option>
                                <option value="bidan"            <%= editUser.role === 'bidan'            ? 'selected' : '' %>>Bidan</option>
                                <option value="pj_ptm"           <%= editUser.role === 'pj_ptm'           ? 'selected' : '' %>>PJ PTM</option>
                                <option value="kepala_puskesmas" <%= editUser.role === 'kepala_puskesmas' ? 'selected' : '' %>>Kepala Puskesmas</option>
                            </select>
                        </div>

                        <!-- Jorong -->
                        <div class="lg:col-span-2" id="jorongEdit">
                            <label class="block text-xs font-medium text-gray-600 mb-1.5">Jorong <span class="text-gray-400">(untuk Kader & Bidan)</span></label>
                            <select name="id_jorong"
                                class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/30 bg-white">
                                <option value="">– Tidak Ada –</option>
                                <% jorong.forEach(j => { %>
                                <option value="<%= j.id_jorong %>" <%= editUser.id_jorong == j.id_jorong ? 'selected' : '' %>>
                                    <%= j.nama_jorong %> (<%= j.nama_nagari %>)
                                </option>
                                <% }) %>
                            </select>
                        </div>
                    </div>

                    <div class="flex gap-3 pt-6 mt-4 border-t border-gray-100">
                        <a href="/ptm/user"
                            class="px-6 text-center border border-gray-200 text-gray-600 py-2.5 rounded-xl text-sm hover:bg-gray-50 transition-colors">
                            Batal
                        </a>
                        <button type="submit"
                            class="flex-1 bg-[#2563EB] hover:bg-[#1D4ED8] text-white py-2.5 rounded-xl text-sm font-medium transition-colors">
                            Simpan Perubahan
                        </button>
                    </div>
                </form>
            </div>

        </main>

        <!-- MODAL: Reset Password -->
        <div id="modalReset" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:9999; align-items:center; justify-content:center; padding:1rem;">
            <div style="background:#fff; border-radius:1rem; box-shadow:0 20px 60px rgba(0,0,0,0.2); width:100%; max-width:400px; overflow:hidden;">
                <div style="display:flex; align-items:center; justify-content:space-between; padding:1rem 1.5rem; border-bottom:1px solid #f1f5f9;">
                    <h3 style="font-family:Poppins,sans-serif; font-weight:600; font-size:1rem; color:#1e293b; margin:0;">Reset Password</h3>
                    <button onclick="tutupModalReset()" style="background:none; border:none; cursor:pointer; color:#94a3b8; padding:4px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                    </button>
                </div>
                <form id="formReset" method="POST" style="padding:1.5rem;">
                    <p style="font-size:0.875rem; color:#64748b; margin:0 0 1rem;">Reset password untuk: <strong id="namaReset" style="color:#1e293b;"></strong></p>
                    <div style="margin-bottom:1.25rem;">
                        <label style="display:block; font-size:0.75rem; font-weight:500; color:#475569; margin-bottom:6px;">Password Baru</label>
                        <div style="position:relative;">
                            <input type="password" name="password_baru" id="pwdReset" required placeholder="Minimal 6 karakter"
                                style="width:100%; border:1px solid #e2e8f0; border-radius:8px; padding:10px 40px 10px 12px; font-size:0.875rem; outline:none; box-sizing:border-box; background:#fff; color:#1e293b;">
                            <button type="button" onclick="togglePwd('pwdReset')" style="position:absolute; right:10px; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; color:#94a3b8; padding:0; display:flex;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                            </button>
                        </div>
                    </div>
                    <div style="display:flex; gap:12px;">
                        <button type="button" onclick="tutupModalReset()"
                            style="flex:1; border:1px solid #e2e8f0; background:#fff; color:#64748b; padding:10px; border-radius:10px; font-size:0.875rem; cursor:pointer;">Batal</button>
                        <button type="submit"
                            style="flex:1; background:#EAB308; border:none; color:#fff; padding:10px; border-radius:10px; font-size:0.875rem; font-weight:500; cursor:pointer;">Reset Password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        function handleRoleChange() {
            const role  = document.getElementById('roleEdit').value;
            const divEl = document.getElementById('jorongEdit');
            divEl.style.display = (role === 'kader' || role === 'bidan') ? 'block' : 'none';
        }
        handleRoleChange();

        function bukaModalReset(idUser, namaUser) {
            document.getElementById('namaReset').textContent = namaUser;
            document.getElementById('formReset').action = `/ptm/user/reset/${idUser}`;
            document.getElementById('pwdReset').value = '';
            const m = document.getElementById('modalReset');
            m.style.display = 'flex';
        }

        function tutupModalReset() {
            document.getElementById('modalReset').style.display = 'none';
        }

        function togglePwd(inputId) {
            const input = document.getElementById(inputId);
            input.type = input.type === 'password' ? 'text' : 'password';
        }

        // Tutup modal kalau klik overlay
        document.getElementById('modalReset').addEventListener('click', function(e) {
            if (e.target === this) tutupModalReset();
        });
    </script>

</div>
</body>
</html>
