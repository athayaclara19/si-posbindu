<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Kepala Puskesmas</title>
    <link rel="stylesheet" href="/css/output.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        .font-poppins { font-family: 'Poppins', sans-serif; }
        .font-inter { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 font-inter antialiased text-slate-800 flex h-screen overflow-hidden">
    
    <%- include('../partials/sidebar', { active: 'dashboard', role: 'kepala' }) %>

    <div class="flex-1 flex flex-col h-screen overflow-y-auto relative">
        <%- include('../partials/header', { pageTitle: 'Dashboard', role: 'kepala' }) %>

        <main class="p-8 space-y-6 w-full">
            <div>
                <h2 class="text-[#1F2937] font-poppins font-semibold text-xl">Dashboard Kepala Puskesmas</h2>
                <p class="text-[#6B7280] text-sm mt-1">Puskesmas Sungai Tarab</p>
            </div>

            <!-- STAT CARDS (data dinamis dari DB) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 flex flex-col justify-between">
                    <div class="flex justify-between items-start mb-4">
                        <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        </div>
                        <% if (stats.menunggu > 0) { %>
                        <span class="px-2 py-1 bg-amber-50 text-amber-600 border border-amber-200 text-[10px] font-semibold rounded-md">Perlu Tindakan</span>
                        <% } %>
                    </div>
                    <div><p class="text-3xl font-poppins font-bold text-gray-800"><%= stats.menunggu %></p><p class="text-gray-500 text-xs font-medium mt-1">Laporan Menunggu</p></div>
                </div>
                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 flex flex-col justify-between">
                    <div class="flex justify-between items-start mb-4">
                        <div class="w-10 h-10 rounded-xl bg-green-100 text-green-600 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                        </div>
                    </div>
                    <div><p class="text-3xl font-poppins font-bold text-gray-800"><%= stats.disahkan %></p><p class="text-gray-500 text-xs font-medium mt-1">Laporan Disahkan</p></div>
                </div>
                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 flex flex-col justify-between">
                    <div class="flex justify-between items-start mb-4">
                        <div class="w-10 h-10 rounded-xl bg-red-100 text-red-600 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" x2="12" y1="9" y2="13"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg>
                        </div>
                    </div>
                    <div><p class="text-3xl font-poppins font-bold text-gray-800"><%= stats.ditolak %></p><p class="text-gray-500 text-xs font-medium mt-1">Laporan Ditolak</p></div>
                </div>
                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 flex flex-col justify-between">
                    <div class="flex justify-between items-start mb-4">
                        <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                        </div>
                    </div>
                    <div><p class="text-3xl font-poppins font-bold text-gray-800"><%= stats.total %></p><p class="text-gray-500 text-xs font-medium mt-1">Total Laporan</p></div>
                </div>
            </div>

            <!-- EXECUTIVE SUMMARY -->
            <div class="bg-[#F8FAFC] rounded-2xl p-6 border border-gray-200 shadow-sm">
                <h3 class="text-[#0F172A] font-poppins font-semibold flex items-center gap-2 mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-700"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                    Executive Summary & Rekomendasi Tindakan
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="bg-white rounded-xl p-4 border border-gray-100 shadow-sm flex gap-3">
                        <div class="<%= parseFloat(persenTerkendali) >= 60 ? 'text-green-500' : 'text-amber-500' %> mt-0.5 flex-shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-gray-800">Kualitas Pengendalian PTM</p>
                            <p class="text-xs text-gray-600 mt-1 leading-relaxed">
                                Tingkat tekanan darah pasien terkendali mencapai
                                <strong class="<%= parseFloat(persenTerkendali) >= 60 ? 'text-green-600 bg-green-50' : 'text-amber-600 bg-amber-50' %> px-1 py-0.5 rounded"><%= persenTerkendali %>%</strong>
                                dari total <%= totalPasienSkrining.toLocaleString('id-ID') %> pasien terverifikasi.
                                <% if (parseFloat(persenTerkendali) >= 60) { %>Program intervensi berjalan efektif. Lanjutkan SOP yang berlaku.<% } else { %>Perlu peningkatan intervensi klinis dan edukasi pasien hipertensi.<% } %>
                            </p>
                        </div>
                    </div>
                    <div class="bg-white rounded-xl p-4 border border-gray-100 shadow-sm flex gap-3">
                        <div class="<%= stats.menunggu > 0 ? 'text-amber-500' : 'text-green-500' %> mt-0.5 flex-shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" x2="12" y1="9" y2="13"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-gray-800">Evaluasi Laporan Berkala</p>
                            <p class="text-xs text-gray-600 mt-1 leading-relaxed">
                                <% if (stats.menunggu > 0) { %>
                                    Terdapat <strong class="text-amber-600"><%= stats.menunggu %> laporan menunggu</strong> keputusan Anda.
                                    <strong class="text-[#2563EB]">Tindakan:</strong> Segera tinjau dan berikan keputusan persetujuan atau penolakan.
                                <% } else { %>
                                    Semua laporan telah diproses dengan baik. Tidak ada laporan yang menunggu persetujuan saat ini.
                                <% } %>
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- NOTIFIKASI LAPORAN MENUNGGU -->
            <% if (laporanMenunggu.length > 0) { %>
            <div class="bg-[#FEF3C7] border border-[#F59E0B]/30 rounded-2xl p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                <div class="flex items-start gap-4">
                    <div class="w-10 h-10 bg-[#F59E0B] rounded-xl flex items-center justify-center flex-shrink-0 shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    </div>
                    <div>
                        <p class="text-[#92400E] font-semibold text-sm sm:text-base">Terdapat <%= laporanMenunggu.length %> laporan menunggu persetujuan Anda</p>
                        <p class="text-[#92400E]/80 text-xs sm:text-sm mt-0.5">
                            Laporan <%= laporanMenunggu[0].nama_bulan %> <%= laporanMenunggu[0].periode_tahun %>
                            dari <%= laporanMenunggu[0].nama_pj %>
                            · diterima <%= laporanMenunggu[0].dikirim_pada ? new Date(laporanMenunggu[0].dikirim_pada).toLocaleDateString('id-ID') : '-' %>
                        </p>
                    </div>
                </div>
                <a href="/kepala/persetujuan" class="bg-[#F59E0B] hover:bg-[#D97706] text-white px-5 py-2.5 rounded-xl text-sm transition-all font-medium whitespace-nowrap shadow-sm w-full sm:w-auto text-center">
                    Review Sekarang
                </a>
            </div>
            <% } %>

            <!-- LAPORAN MASUK + RIWAYAT -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- Laporan Masuk -->
                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
                    <div class="px-6 py-5 border-b border-gray-100 flex items-center justify-between">
                        <h3 class="text-[#1F2937] font-poppins font-semibold">Laporan Masuk</h3>
                        <a href="/kepala/persetujuan" class="text-xs text-[#2563EB] hover:underline font-medium">Lihat Semua →</a>
                    </div>
                    <div class="p-5 space-y-3">
                        <% if (laporanMenunggu.length === 0) { %>
                        <div class="text-center py-8 text-gray-400 text-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-2 text-gray-300"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                            Tidak ada laporan menunggu
                        </div>
                        <% } %>
                        <% laporanMenunggu.forEach(function(l) { %>
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-4 border border-gray-100 rounded-xl hover:bg-gray-50 transition-colors">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-[#FEF3C7] rounded-xl flex items-center justify-center flex-shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#D97706]"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                                </div>
                                <div>
                                    <p class="text-[#1F2937] font-semibold text-sm">Laporan <%= l.nama_bulan %> <%= l.periode_tahun %></p>
                                    <p class="text-[#6B7280] text-xs mt-0.5">Oleh <%= l.nama_pj %> · <%= l.dikirim_pada ? new Date(l.dikirim_pada).toLocaleDateString('id-ID') : '-' %></p>
                                </div>
                            </div>
                            <a href="/kepala/persetujuan?id=<%= l.id_laporan %>" class="text-sm font-semibold text-[#2563EB] hover:underline flex items-center gap-1 transition-colors whitespace-nowrap">
                                Review <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                            </a>
                        </div>
                        <% }) %>
                    </div>
                </div>

                <!-- Riwayat Laporan -->
                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
                    <div class="px-6 py-5 border-b border-gray-100">
                        <h3 class="text-[#1F2937] font-poppins font-semibold">Riwayat Laporan</h3>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead>
                                <tr class="bg-[#F8FAFC] border-b border-gray-100">
                                    <th class="text-left px-6 py-4 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Periode</th>
                                    <th class="text-left px-6 py-4 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Tanggal</th>
                                    <th class="text-left px-6 py-4 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Status</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-50">
                                <% if (riwayatLaporan.length === 0) { %>
                                <tr><td colspan="3" class="text-center py-8 text-gray-400 text-sm">Belum ada riwayat laporan</td></tr>
                                <% } %>
                                <% riwayatLaporan.forEach(function(r) { %>
                                <tr class="hover:bg-gray-50 transition-colors">
                                    <td class="px-6 py-3.5 text-sm text-[#1F2937] font-medium"><%= r.nama_bulan %> <%= r.periode_tahun %></td>
                                    <td class="px-6 py-3.5 text-sm text-[#6B7280]"><%= r.dikirim_pada ? new Date(r.dikirim_pada).toLocaleDateString('id-ID') : '-' %></td>
                                    <td class="px-6 py-3.5">
                                        <% if (r.status === 'disahkan') { %>
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#D1FAE5] text-[#059669] text-[11px] font-bold border border-[#A7F3D0]"><span class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span>Disahkan</span>
                                        <% } else { %>
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#FEE2E2] text-[#DC2626] text-[11px] font-bold border border-[#FECACA]"><span class="w-1.5 h-1.5 rounded-full bg-[#EF4444]"></span>Ditolak</span>
                                        <% } %>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>
</body>
</html>
