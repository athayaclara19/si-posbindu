<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Monitoring Hipertensi - Bidan</title>
    <link rel="stylesheet" href="/css/output.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .hidden-el { display: none !important; }
    </style>
</head>
<body class="bg-slate-50 font-inter text-slate-800 flex h-screen overflow-hidden">
    
    <%- include('../partials/sidebar', { active: 'monitoring', role: 'bidan' }) %>

    <div class="flex-1 flex flex-col h-screen overflow-y-auto relative">
        <%- include('../partials/header', { pageTitle: 'Laporan Pengendalian Penyakit HT', role: 'bidan' }) %>

        <main class="p-8 space-y-6 w-full">
            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex flex-col md:flex-row justify-between gap-4">
                <div class="space-y-1">
                    <p class="text-xs text-gray-500 uppercase font-bold tracking-wider">Puskesmas</p>
                    <p class="text-sm font-semibold">PUSKESMAS SUNGAI TARAB</p>
                    <p class="text-xs text-gray-500 uppercase font-bold tracking-wider pt-2">Tahun / Periode</p>
                    <p class="text-sm font-semibold">2026 / Semester 1</p>
                </div>
                <div class="space-y-1 md:text-right">
                    <p class="text-xs text-gray-500 uppercase font-bold tracking-wider">Jumlah Terkendali</p>
                    <p class="text-lg font-bold text-green-600">120 Pasien</p>
                    <p class="text-xs text-gray-500 uppercase font-bold tracking-wider pt-2">Persentase Capaian</p>
                    <p class="text-lg font-bold text-blue-600">71.8%</p>
                </div>
            </div>

            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
                <div class="px-6 py-5 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
                    <h3 class="text-[#1F2937] font-poppins font-semibold">Riwayat Kontrol Individu</h3>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-white border-b border-gray-100 text-[11px] uppercase tracking-wider font-bold text-gray-500">
                                <th class="px-6 py-4">Nama / NIK</th>
                                <th class="px-6 py-4">Info Pasien</th>
                                <th class="px-6 py-4">Kunjungan Terakhir</th>
                                <th class="px-6 py-4 text-center">Tensi Terakhir</th>
                                <th class="px-6 py-4">Status</th>
                                <th class="px-6 py-4">Histori</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-50">
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="px-6 py-4">
                                    <p class="font-semibold text-sm text-[#1F2937]">ASMIARTI</p>
                                    <p class="text-xs text-gray-500 font-mono mt-0.5">1306056807520001</p>
                                </td>
                                <td class="px-6 py-4 text-xs">
                                    <p class="font-medium text-[#1F2937]">73 Th / Perempuan</p>
                                    <p class="text-gray-500 mt-0.5">Jl. Koto, Guguak Tinggi</p>
                                </td>
                                <td class="px-6 py-4">
                                    <p class="text-sm font-medium text-[#1F2937]">12 Mei 2026</p>
                                    <p class="text-xs text-gray-500 mt-0.5">Kunjungan Ke-3</p>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <p class="font-bold text-sm text-[#1F2937]">125 / 75</p>
                                    <p class="text-[10px] text-gray-500 mt-0.5">mmHg</p>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="px-2.5 py-1 rounded-full bg-green-100 text-green-700 text-xs font-semibold border border-green-200">Terkendali</span>
                                </td>
                                <td class="px-6 py-4">
                                    <button onclick="bukaGrafikModal('ASMIARTI')" class="flex items-center gap-1.5 px-3 py-1.5 bg-[#DBEAFE] text-[#2563EB] rounded-lg text-xs font-semibold hover:bg-[#BFDBFE] transition-colors">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
                                        Lihat Grafik
                                    </button>
                                </td>
                            </tr>
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="px-6 py-4">
                                    <p class="font-semibold text-sm text-[#1F2937]">ZULKIFLI</p>
                                    <p class="text-xs text-gray-500 font-mono mt-0.5">1306051203650002</p>
                                </td>
                                <td class="px-6 py-4 text-xs">
                                    <p class="font-medium text-[#1F2937]">61 Th / Laki-laki</p>
                                    <p class="text-gray-500 mt-0.5">Jorong Pasar</p>
                                </td>
                                <td class="px-6 py-4">
                                    <p class="text-sm font-medium text-[#1F2937]">10 Mei 2026</p>
                                    <p class="text-xs text-gray-500 mt-0.5">Kunjungan Ke-4</p>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <p class="font-bold text-sm text-[#EF4444]">160 / 95</p>
                                    <p class="text-[10px] text-gray-500 mt-0.5">mmHg</p>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="px-2.5 py-1 rounded-full bg-red-100 text-red-700 text-xs font-semibold border border-red-200">Tidak Terkendali</span>
                                </td>
                                <td class="px-6 py-4">
                                    <button onclick="bukaGrafikModal('ZULKIFLI')" class="flex items-center gap-1.5 px-3 py-1.5 bg-[#DBEAFE] text-[#2563EB] rounded-lg text-xs font-semibold hover:bg-[#BFDBFE] transition-colors">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
                                        Lihat Grafik
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div id="modal-grafik" class="hidden-el fixed inset-0 z-50 flex items-center justify-center p-4">
                <div class="absolute inset-0 bg-gray-900/40 backdrop-blur-sm" onclick="tutupGrafikModal()"></div>
                <div class="bg-white rounded-2xl w-full max-w-2xl p-6 shadow-2xl z-10 relative">
                    <div class="flex items-center justify-between mb-2">
                        <div>
                            <h3 class="text-[#1F2937] font-poppins font-semibold text-lg flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#2563EB]"><path d="M20.2 7.8l-7.7 7.7-4-4-5.7 5.7"/><path d="M15 7h6v6"/></svg>
                                Histori Tensi: <span id="nama-pasien-modal" class="text-[#2563EB]">ASMIARTI</span>
                            </h3>
                            <p class="text-[#6B7280] text-xs mt-1">Pemantauan 6 Kunjungan Terakhir</p>
                        </div>
                        <button onclick="tutupGrafikModal()" class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center text-gray-500 hover:bg-gray-200 hover:text-gray-700 transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        </button>
                    </div>

                    <div class="w-full h-[300px] mt-6 border-b border-gray-100 pb-4">
                        <canvas id="historiTensiChart"></canvas>
                    </div>

                    <div id="box-ringkasan" class="mt-4 bg-[#EFF6FF] border border-[#BFDBFE] rounded-xl p-4 flex gap-3">
                        <div id="icon-ringkasan" class="text-[#2563EB] mt-0.5">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
                        </div>
                        <div>
                            <p class="text-[#1E40AF] text-sm font-semibold">Ringkasan Data Pengukuran</p>
                            <p id="kesimpulan-pasien" class="text-[#1E40AF] text-xs mt-1 leading-relaxed">
                                Pilih pasien untuk melihat ringkasan data pengukurannya.
                            </p>
                        </div>
                    </div>

                </div>
            </div>

        </main>
    </div>

    <script>
        let chartInst = null;

        // ============================================================
        // [REVISI] FUNGSI BARU: hitungNarasiDeskriptif()
        // Menggantikan teksKesimpulan hardcoded yang berisi rekomendasi klinis.
        // Fungsi ini HANYA melakukan perhitungan matematis dan menghasilkan
        // kalimat deskriptif berbasis angka — sesuai arahan dosen bimbingan.
        //
        // Parameter:
        //   - arrSistole  : array nilai sistolik (angka), dari lama ke baru
        //   - arrDiastole : array nilai diastolik (angka), dari lama ke baru
        //
        // Return: string narasi deskriptif (tanpa rekomendasi klinis)
        // ============================================================
        function hitungNarasiDeskriptif(arrSistole, arrDiastole) {

            // -- Validasi: jika data kosong
            if (!arrSistole || arrSistole.length === 0) {
                return 'Data pengukuran belum tersedia.';
            }

            const jmlData       = arrSistole.length;

            // -- Nilai terbaru (index terakhir)
            const sistolikTerbaru  = arrSistole[jmlData - 1];
            const diastolikTerbaru = arrDiastole[jmlData - 1];

            // -- Hitung rata-rata sistolik (pembulatan 1 desimal)
            const totalSistole = arrSistole.reduce((sum, v) => sum + v, 0);
            const rataSistole  = (totalSistole / jmlData).toFixed(1);

            // -- Hitung rata-rata diastolik
            const totalDiastole = arrDiastole.reduce((sum, v) => sum + v, 0);
            const rataDiastole  = (totalDiastole / jmlData).toFixed(1);

            // -- Tentukan tren sistolik: bandingkan nilai terbaru vs sebelumnya
            let narasiTren = '';
            if (jmlData >= 2) {
                const sistolikSebelumnya = arrSistole[jmlData - 2];
                const selisih = sistolikTerbaru - sistolikSebelumnya;

                if (selisih > 5) {
                    // [REVISI] Tidak ada kata "tidak terkendali" atau anjuran klinis
                    narasiTren = `Sistolik mengalami kenaikan ${selisih} mmHg dari pemeriksaan sebelumnya (${sistolikSebelumnya} → ${sistolikTerbaru} mmHg).`;
                } else if (selisih < -5) {
                    // [REVISI] Tidak ada kata "terkendali" atau penilaian kondisi
                    narasiTren = `Sistolik mengalami penurunan ${Math.abs(selisih)} mmHg dari pemeriksaan sebelumnya (${sistolikSebelumnya} → ${sistolikTerbaru} mmHg).`;
                } else {
                    narasiTren = `Sistolik relatif stabil dari pemeriksaan sebelumnya (${sistolikSebelumnya} → ${sistolikTerbaru} mmHg).`;
                }
            }

            // -- Tentukan kategori berdasarkan standar Kemenkes 2024
            // (Klasifikasi ini dipertahankan karena berbasis dokumen resmi)
            let kategori = '';
            if (sistolikTerbaru >= 180)      kategori = 'Krisis Hipertensi (≥180 mmHg)';
            else if (sistolikTerbaru >= 160) kategori = 'Hipertensi Tingkat 2 (160–179 mmHg)';
            else if (sistolikTerbaru >= 140) kategori = 'Hipertensi Tingkat 1 (140–159 mmHg)';
            else if (sistolikTerbaru >= 120) kategori = 'Pra-Hipertensi (120–139 mmHg)';
            else                             kategori = 'Normal (<120 mmHg)';

            // -- Susun narasi akhir: hanya fakta angka, tanpa rekomendasi
            // Format mengikuti contoh dari dosen:
            // "Rata-rata sistolik: X mmHg. Tren: naik/turun Y mmHg dari bulan sebelumnya."
            const narasi =
                `Sistolik terbaru: ${sistolikTerbaru} mmHg / Diastolik terbaru: ${diastolikTerbaru} mmHg — ` +
                `masuk kategori ${kategori}. ` +
                `Berdasarkan ${jmlData} kali pemeriksaan: rata-rata sistolik ${rataSistole} mmHg, ` +
                `rata-rata diastolik ${rataDiastole} mmHg. ` +
                narasiTren;

            return narasi;
        }

        // ============================================================
        // [REVISI] FUNGSI bukaGrafikModal() — DIMODIFIKASI
        // Perubahan dari versi lama:
        //   1. Blok if-else per nama pasien DIHAPUS (data hardcoded klinis)
        //   2. teksKesimpulan yang berisi rekomendasi klinis DIHAPUS
        //   3. Diganti dengan pemanggilan hitungNarasiDeskriptif()
        //   4. Manipulasi warna kotak berdasarkan kondisi klinis DIHAPUS
        //      — warna kotak kini tetap biru netral (informatif, bukan judgement)
        // Struktur fungsi, nama variabel, dan render Chart TIDAK diubah.
        // ============================================================
        function bukaGrafikModal(namaPasien) {
            document.getElementById('modal-grafik').classList.remove('hidden-el');
            document.getElementById('nama-pasien-modal').innerText = namaPasien;

            // [REVISI] Data simulasi dipertahankan sementara (untuk dummy/demo).
            // Saat integrasi database selesai, ganti blok ini dengan fetch ke
            // endpoint API: GET /bidan/monitoring/:id_pasien
            let dataSistole  = [];
            let dataDiastole = [];

            if (namaPasien === 'ASMIARTI') {
                dataSistole  = [173, 150, 140, 130, 128, 125];
                dataDiastole = [95, 90, 85, 80, 78, 75];
            } else {
                dataSistole  = [130, 135, 145, 155, 158, 160];
                dataDiastole = [80, 85, 88, 90, 92, 95];
            }

            // [REVISI] teksKesimpulan klinis DIHAPUS sepenuhnya.
            // Diganti dengan hasil hitungan matematis dari hitungNarasiDeskriptif().
            const narasiDeskriptif = hitungNarasiDeskriptif(dataSistole, dataDiastole);

            // [REVISI] Isi elemen teks dengan narasi deskriptif (bukan innerHTML
            // dengan HTML bold — gunakan textContent agar lebih aman dari XSS)
            document.getElementById('kesimpulan-pasien').textContent = narasiDeskriptif;

            // [REVISI] Manipulasi warna kotak berdasarkan kondisi klinis DIHAPUS.
            // Kotak tetap biru netral (#EFF6FF) karena hanya menyajikan data,
            // bukan memberikan penilaian kondisi pasien.

            // Render Chart — TIDAK DIUBAH dari versi asli
            Chart.defaults.font.family = "'Inter', sans-serif";
            const ctx = document.getElementById('historiTensiChart').getContext('2d');
            
            if (chartInst) chartInst.destroy();

            chartInst = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ["Jan", "Feb", "Mar", "Apr", "Mei", "Sekarang"],
                    datasets: [
                        {
                            label: 'Sistole',
                            data: dataSistole,
                            borderColor: '#EF4444',
                            backgroundColor: '#EF4444',
                            tension: 0.3,
                            borderWidth: 2,
                            pointRadius: 4
                        },
                        {
                            label: 'Diastole',
                            data: dataDiastole,
                            borderColor: '#3B82F6',
                            backgroundColor: '#3B82F6',
                            tension: 0.3,
                            borderWidth: 2,
                            pointRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'top', labels: { usePointStyle: true, boxWidth: 8 } } },
                    scales: {
                        y: { min: 60, max: 200, grid: { color: '#F3F4F6', strokeDash: [3, 3] } },
                        x: { grid: { display: false } }
                    }
                }
            });
        }

        function tutupGrafikModal() {
            document.getElementById('modal-grafik').classList.add('hidden-el');
        }
    </script>
</body>
</html>