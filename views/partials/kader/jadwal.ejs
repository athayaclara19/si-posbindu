<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jadwal Kegiatan</title>
    <link rel="stylesheet" href="/css/output.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        .font-poppins { font-family: 'Poppins', sans-serif; }
        .font-inter { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 font-inter antialiased text-slate-800 flex h-screen overflow-hidden">
    
    <%- include('../partials/sidebar', { active: 'jadwal' }) %>

    <div class="flex-1 flex flex-col h-screen overflow-y-auto">
        <%- include('../partials/header', { pageTitle: 'Jadwal Kegiatan' }) %>

        <main class="p-8">
            <div class="space-y-6">
                <div>
                    <h2 class="text-[#1F2937] font-poppins font-semibold text-xl">
                        Jadwal Kegiatan Posbindu
                    </h2>
                    <p class="text-[#6B7280] text-sm mt-1">
                        Jadwal ditetapkan oleh Puskesmas. Kader tidak dapat mengubah jadwal.
                    </p>
                </div>

                <div class="grid grid-cols-3 gap-4">
                    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm px-5 py-4">
                        <p class="text-2xl text-[#1F2937] font-poppins font-bold">5</p>
                        <p class="text-[#6B7280] text-xs mt-0.5">Total Jadwal</p>
                    </div>
                    <div class="bg-[#EFF6FF] rounded-2xl border border-blue-100 shadow-sm px-5 py-4">
                        <p class="text-2xl text-[#1D4ED8] font-poppins font-bold">1</p>
                        <p class="text-[#6B7280] text-xs mt-0.5">Hari Ini</p>
                    </div>
                    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm px-5 py-4">
                        <p class="text-2xl text-[#6B7280] font-poppins font-bold">3</p>
                        <p class="text-[#6B7280] text-xs mt-0.5">Mendatang</p>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#6B7280]">
                        <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/>
                    </svg>
                    <select class="px-3 py-2 border border-gray-200 rounded-xl text-sm text-[#1F2937] bg-white outline-none focus:border-[#2563EB] focus:ring-1 focus:ring-[#2563EB]">
                        <option>Mei 2025</option>
                        <option>Juni 2025</option>
                        <option>Juli 2025</option>
                    </select>
                    <span class="text-[#6B7280] text-xs">5 jadwal ditemukan</span>
                </div>

                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-gray-100 bg-[#F9FAFB]">
                                <th class="text-left px-5 py-3 text-[#6B7280] text-xs uppercase tracking-wider font-medium">Tanggal</th>
                                <th class="text-left px-5 py-3 text-[#6B7280] text-xs uppercase tracking-wider font-medium">Lokasi / Jorong</th>
                                <th class="text-left px-5 py-3 text-[#6B7280] text-xs uppercase tracking-wider font-medium">Waktu</th>
                                <th class="text-left px-5 py-3 text-[#6B7280] text-xs uppercase tracking-wider font-medium">Petugas</th>
                                <th class="text-left px-5 py-3 text-[#6B7280] text-xs uppercase tracking-wider font-medium">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="border-b border-gray-50 hover:bg-[#F8FAFC] transition-colors">
                                <td class="px-5 py-3.5">
                                    <p class="text-[#1F2937] text-sm font-medium">08 Mei 2025</p>
                                    <p class="text-[#6B7280] text-xs">Kamis</p>
                                </td>
                                <td class="px-5 py-3.5">
                                    <div class="flex items-center gap-1.5">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#6B7280] flex-shrink-0"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                                        <span class="text-[#1F2937]">Jorong Koto Gadang</span>
                                    </div>
                                </td>
                                <td class="px-5 py-3.5">
                                    <div class="flex items-center gap-1.5">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#6B7280] flex-shrink-0"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                        <span class="text-[#6B7280]">08.00 – 12.00</span>
                                    </div>
                                </td>
                                <td class="px-5 py-3.5 text-[#1F2937] font-medium">Sari Dewi</td>
                                <td class="px-5 py-3.5">
                                    <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-[#D1FAE5] text-[#059669]">Selesai</span>
                                </td>
                            </tr>

                            <tr class="border-b border-gray-50 hover:bg-[#F8FAFC] transition-colors bg-[#EFF6FF]">
                                <td class="px-5 py-3.5">
                                    <p class="text-[#1F2937] text-sm font-medium">15 Mei 2025</p>
                                    <p class="text-[#6B7280] text-xs">Kamis</p>
                                </td>
                                <td class="px-5 py-3.5">
                                    <div class="flex items-center gap-1.5">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#6B7280] flex-shrink-0"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                                        <span class="text-[#1F2937]">Jorong Koto Tinggi</span>
                                    </div>
                                </td>
                                <td class="px-5 py-3.5">
                                    <div class="flex items-center gap-1.5">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#6B7280] flex-shrink-0"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                        <span class="text-[#6B7280]">08.00 – 12.00</span>
                                    </div>
                                </td>
                                <td class="px-5 py-3.5 text-[#1F2937] font-medium">Sari Dewi</td>
                                <td class="px-5 py-3.5">
                                    <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-[#DBEAFE] text-[#1D4ED8]">Hari Ini</span>
                                </td>
                            </tr>

                            <tr class="border-b border-gray-50 hover:bg-[#F8FAFC] transition-colors">
                                <td class="px-5 py-3.5">
                                    <p class="text-[#1F2937] text-sm font-medium">22 Mei 2025</p>
                                    <p class="text-[#6B7280] text-xs">Kamis</p>
                                </td>
                                <td class="px-5 py-3.5">
                                    <div class="flex items-center gap-1.5">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#6B7280] flex-shrink-0"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                                        <span class="text-[#1F2937]">Jorong Batu Balang</span>
                                    </div>
                                </td>
                                <td class="px-5 py-3.5">
                                    <div class="flex items-center gap-1.5">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#6B7280] flex-shrink-0"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                        <span class="text-[#6B7280]">09.00 – 13.00</span>
                                    </div>
                                </td>
                                <td class="px-5 py-3.5 text-[#1F2937] font-medium">Sari Dewi</td>
                                <td class="px-5 py-3.5">
                                    <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-[#F3F4F6] text-[#6B7280]">Mendatang</span>
                                </td>
                            </tr>

                            <tr class="border-b border-gray-50 hover:bg-[#F8FAFC] transition-colors">
                                <td class="px-5 py-3.5">
                                    <p class="text-[#1F2937] text-sm font-medium">29 Mei 2025</p>
                                    <p class="text-[#6B7280] text-xs">Kamis</p>
                                </td>
                                <td class="px-5 py-3.5">
                                    <div class="flex items-center gap-1.5">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#6B7280] flex-shrink-0"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                                        <span class="text-[#1F2937]">Jorong Ranah</span>
                                    </div>
                                </td>
                                <td class="px-5 py-3.5">
                                    <div class="flex items-center gap-1.5">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#6B7280] flex-shrink-0"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                        <span class="text-[#6B7280]">08.00 – 11.00</span>
                                    </div>
                                </td>
                                <td class="px-5 py-3.5 text-[#1F2937] font-medium">Sari Dewi</td>
                                <td class="px-5 py-3.5">
                                    <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-[#F3F4F6] text-[#6B7280]">Mendatang</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="flex items-start gap-2 bg-[#EFF6FF] border border-[#BFDBFE] rounded-xl p-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#2563EB] mt-0.5 flex-shrink-0">
                        <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/>
                    </svg>
                    <p class="text-[#1E40AF] text-sm">
                        Jadwal kegiatan Posbindu ditetapkan oleh koordinator Puskesmas setiap awal bulan.
                        Hubungi PJ PTM jika ada perubahan jadwal.
                    </p>
                </div>

            </div>
        </main>
    </div>
</body>
</html>