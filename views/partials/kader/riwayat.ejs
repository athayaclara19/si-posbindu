<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Riwayat Skrining - Kader</title>
    <link rel="stylesheet" href="/css/output.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        .font-poppins { font-family: 'Poppins', sans-serif; }
        .font-inter { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 font-inter antialiased text-slate-800 flex h-screen overflow-hidden">
    
    <%- include('../partials/sidebar', { active: 'riwayat' }) %>

    <div class="flex-1 flex flex-col h-screen overflow-y-auto relative">
        <%- include('../partials/header', { pageTitle: 'Riwayat Skrining' }) %>

        <main class="p-8 space-y-5">
            <div>
                <h2 class="text-[#1F2937] font-poppins font-semibold text-xl">Riwayat Skrining</h2>
                <p class="text-[#6B7280] text-sm mt-1">Semua data skrining yang pernah Anda input</p>
            </div>

            <div class="flex flex-col sm:flex-row gap-3">
                <div class="relative flex-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 -translate-y-1/2 text-[#6B7280]"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                    <input type="text" id="searchInput" placeholder="Cari nama atau NIK pasien..."
                           value="<%= typeof search !== 'undefined' ? search : '' %>"
                           class="w-full pl-9 pr-4 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white transition-all">
                </div>
                <div class="flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#6B7280]"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                    <select id="statusFilter" class="px-3 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-white transition-all">
                        <option value="Semua"             <%= (typeof statusQ === 'undefined' || statusQ === '' || statusQ === 'Semua') ? 'selected' : '' %>>Semua</option>
                        <option value="Menunggu Validasi" <%= (typeof statusQ !== 'undefined' && statusQ === 'Menunggu Validasi') ? 'selected' : '' %>>Menunggu Validasi</option>
                        <option value="Valid"             <%= (typeof statusQ !== 'undefined' && statusQ === 'Valid') ? 'selected' : '' %>>Valid (Diterima)</option>
                        <option value="Perlu Revisi"      <%= (typeof statusQ !== 'undefined' && statusQ === 'Perlu Revisi') ? 'selected' : '' %>>Perlu Revisi</option>
                    </select>
                </div>
            </div>

            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full" id="riwayatTable">
                        <thead>
                            <tr class="border-b border-gray-100 bg-[#F8FAFC]">
                                <th class="text-left px-5 py-3 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Pasien</th>
                                <th class="text-left px-5 py-3 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Tanggal</th>
                                <th class="text-left px-5 py-3 text-xs text-[#6B7280] uppercase tracking-wider font-medium">TD</th>
                                <th class="text-left px-5 py-3 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Kategori</th>
                                <th class="text-left px-5 py-3 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Status</th>
                                <th class="text-left px-5 py-3 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Aksi</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-50">
                            
                            <% if (typeof riwayat !== 'undefined' && riwayat.length > 0) { %>
                                <%
                                   
                                    riwayat.forEach(r => {

                                        // PERBAIKAN: filterStatus diisi sesuai nilai DB yang sebenarnya
                                        // Nilai di DB: 'menunggu', 'terverifikasi', 'revisi'
                                        let filterStatus = 'Semua';
                                        if (r.status_validasi === 'menunggu')      filterStatus = 'Menunggu Validasi';
                                        if (r.status_validasi === 'terverifikasi') filterStatus = 'Valid';
                                        if (r.status_validasi === 'revisi')        filterStatus = 'Perlu Revisi';
                                %>
                                <tr class="hover:bg-gray-50 transition-colors data-row cursor-default" data-status="<%= filterStatus %>">
                                    
                                    <!-- Kolom 1: Nama & NIK -->
                                    <td class="px-5 py-3.5">
                                        <p class="text-[#1F2937] text-sm font-medium search-target"><%= r.nama_pasien %></p>
                                        <p class="text-[#6B7280] text-xs font-mono search-target"><%= r.nik %></p>
                                    </td>

                                    <!-- Kolom 2: Tanggal -->
                                    <td class="px-5 py-3.5 text-sm text-[#6B7280]">
                                        <%= new Date(r.tanggal_kegiatan).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                    </td>

                                    <!-- Kolom 3: Tekanan Darah -->
                                    <td class="px-5 py-3.5">
                                        <span class="text-[#1F2937] text-sm font-medium"><%= r.sistole %>/<%= r.diastole %></span>
                                        <span class="text-[#6B7280] text-xs ml-1">mmHg</span>
                                    </td>

                                    <!-- Kolom 4: Kategori Tekanan -->
                                    <td class="px-5 py-3.5">
                                        <% if (r.status_tekanan === 'Tidak Terkendali') { %>
                                            <span class="text-xs text-[#DC2626] font-medium">Tidak Terkendali</span>
                                        <% } else { %>
                                            <span class="text-xs text-[#D97706] font-medium"><%= r.status_tekanan || 'Terkendali' %></span>
                                        <% } %>
                                    </td>

                                    <!-- Kolom 5: Badge Status Validasi -->
                                    <td class="px-5 py-3.5">
                                        <% if (r.status_validasi === 'menunggu') { %>
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#FEF3C7] text-[#D97706] text-xs font-medium">
                                                <span class="w-1.5 h-1.5 rounded-full bg-[#F59E0B]"></span>Menunggu
                                            </span>
                                        <% } else if (r.status_validasi === 'terverifikasi') { %>
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#D1FAE5] text-[#059669] text-xs font-medium">
                                                <span class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span>Valid
                                            </span>
                                        <% } else { %>
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#FEE2E2] text-[#DC2626] text-xs font-medium">
                                                <span class="w-1.5 h-1.5 rounded-full bg-[#EF4444]"></span>Revisi
                                            </span>
                                        <% } %>
                                    </td>

                                    <!-- Kolom 6: Tombol Aksi
                                         - status 'revisi'  = tombol PERBAIKI (kuning)
                                         - status lainnya   = tombol LIHAT (biru) -->
                                    <td class="px-5 py-3.5">
                                        <div class="flex items-center gap-1">
                                            <% if (r.status_validasi === 'revisi') { %>
                                                <!-- Tombol Perbaiki -->
                                                <a href="/skrining/edit/<%= r.id_skrining %>"
                                                   class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#FEF3C7] text-[#D97706] hover:bg-[#FDE68A] text-xs font-medium transition-all"
                                                   title="Perbaiki Data Skrining">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                                                    Perbaiki
                                                </a>
                                                                                        <% } else { %>
                                                <!-- Tombol Lihat -->
                                                <button
                                                    class="btn-lihat p-1.5 rounded-lg text-[#6B7280] hover:bg-[#DBEAFE] hover:text-[#2563EB] transition-all"
                                                    title="Lihat Detail"
                                                    data-nama="<%- r.nama_pasien %>"
                                                    data-nik="<%= r.nik %>"
                                                    data-tanggal="<%= new Date(r.tanggal_kegiatan).toLocaleDateString('id-ID', {day:'numeric',month:'long',year:'numeric'}) %>"
                                                    data-sistole="<%= r.sistole %>"
                                                    data-diastole="<%= r.diastole %>"
                                                    data-bb="<%= r.berat_badan || '' %>"
                                                    data-tb="<%= r.tinggi_badan || '' %>"
                                                    data-gula="<%= r.gula_darah || '' %>"
                                                    data-kolesterol="<%= r.kolesterol || '' %>"
                                                    data-merokok="<%= r.merokok ? 'Ya' : 'Tidak' %>"
                                                    data-aktivitas="<%= r.aktivitas_fisik || '' %>"
                                                    data-edukasi="<%- r.edukasi || '' %>"
                                                    data-dapat-obat="<%= r.dapat_obat || 'tidak' %>"
                                                    data-rujukan="<%= r.status_rujukan || 'tidak' %>"
                                                    data-kategori="<%= r.status_tekanan || 'Terkendali' %>"
                                                    data-status="<%= filterStatus %>"
                                                    data-catatan="<%- r.catatan_bidan || '' %>"
                                                    data-tgl-validasi="<%= r.tanggal_validasi ? new Date(r.tanggal_validasi).toLocaleDateString('id-ID', {day:'numeric',month:'long',year:'numeric'}) : '' %>">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                                                </button>
                                            <% } %>
                                        </div>
                                    </td>

                                </tr>  
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="px-5 py-10 text-center text-[#6B7280]">Belum ada data skrining yang diinput.</td>
                                </tr>
                            <% } %>
                            </tbody>
                    </table>
                </div>
                
                <div class="px-5 py-3 border-t border-gray-100 flex items-center justify-between flex-wrap gap-3">
                    <p class="text-[#6B7280] text-xs">
                        Menampilkan <%= riwayat.length %> dari <%= typeof totalData !== 'undefined' ? totalData : riwayat.length %> data
                    </p>
                    <%# Pagination %>
                    <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                    <div class="flex gap-1.5">
                        <% if (page > 1) { %>
                            <a href="/riwayat?search=<%= encodeURIComponent(search) %>&status=<%= encodeURIComponent(statusQ) %>&page=<%= page - 1 %>"
                               class="px-3 py-1.5 rounded-lg border border-gray-200 text-xs text-gray-600 hover:bg-gray-50">← Prev</a>
                        <% } %>
                        <% for (let i = Math.max(1, page-2); i <= Math.min(totalPages, page+2); i++) { %>
                            <a href="/riwayat?search=<%= encodeURIComponent(search) %>&status=<%= encodeURIComponent(statusQ) %>&page=<%= i %>"
                               class="px-3 py-1.5 rounded-lg border text-xs
                                      <%= i === page ? 'bg-blue-600 text-white border-blue-600' : 'border-gray-200 text-gray-600 hover:bg-gray-50' %>">
                                <%= i %>
                            </a>
                        <% } %>
                        <% if (page < totalPages) { %>
                            <a href="/riwayat?search=<%= encodeURIComponent(search) %>&status=<%= encodeURIComponent(statusQ) %>&page=<%= page + 1 %>"
                               class="px-3 py-1.5 rounded-lg border border-gray-200 text-xs text-gray-600 hover:bg-gray-50">Next →</a>
                        <% } %>
                    </div>
                    <% } %>
                </div>
            </div>
        </main>

        <div id="detailModal" class="fixed inset-0 z-50 hidden items-center justify-center">
            <div class="absolute inset-0 bg-gray-900/40 backdrop-blur-sm transition-opacity" onclick="closeDetailModal()"></div>
            
            <div class="bg-white rounded-2xl shadow-xl w-full max-w-2xl z-10 overflow-hidden transform transition-all m-4 max-h-[90vh] flex flex-col">
                
                <!-- Header Modal -->
                <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50 shrink-0">
                    <div class="flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#2563EB]"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                        <h3 class="font-poppins font-semibold text-gray-800 text-lg">Detail Skrining</h3>
                    </div>
                    <button onclick="closeDetailModal()" class="text-gray-400 hover:text-gray-600 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    </button>
                </div>

                <!-- Body Modal (scrollable) -->
                <div class="p-6 space-y-5 overflow-y-auto">

                    <!-- Identitas Pasien -->
                    <div class="flex items-center gap-4">
                        <div id="modalInisial" class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-bold text-lg shrink-0">BS</div>
                        <div>
                            <p id="modalNama" class="font-poppins font-semibold text-gray-800 text-lg">-</p>
                            <p id="modalNik" class="text-sm text-gray-500 font-mono">-</p>
                        </div>
                        <span id="modalStatusBadge" class="ml-auto shrink-0 px-3 py-1 rounded-full text-xs font-semibold">-</span>
                    </div>

                    <!-- Seksi: Informasi Pemeriksaan -->
                    <div>
                        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Informasi Pemeriksaan</p>
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                            <div class="bg-slate-50 rounded-xl p-3 border border-slate-100">
                                <p class="text-gray-400 text-xs mb-1">Tanggal Skrining</p>
                                <p id="modalTanggal" class="font-semibold text-gray-800 text-sm">-</p>
                            </div>
                            <div class="bg-slate-50 rounded-xl p-3 border border-slate-100">
                                <p class="text-gray-400 text-xs mb-1">Kategori TD</p>
                                <span id="modalKategori" class="inline-block px-2 py-0.5 rounded-md text-xs font-semibold">-</span>
                            </div>
                            <div class="bg-slate-50 rounded-xl p-3 border border-slate-100">
                                <p class="text-gray-400 text-xs mb-1">Tekanan Darah</p>
                                <p class="font-bold text-gray-800 text-sm"><span id="modalTensi">-</span> <span class="text-gray-400 font-normal text-xs">mmHg</span></p>
                            </div>
                        </div>
                    </div>

                    <!-- Seksi: Data Fisik -->
                    <div>
                        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Data Fisik</p>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                            <div class="bg-slate-50 rounded-xl p-3 border border-slate-100">
                                <p class="text-gray-400 text-xs mb-1">Berat Badan</p>
                                <p id="modalBB" class="font-semibold text-gray-800 text-sm">-</p>
                            </div>
                            <div class="bg-slate-50 rounded-xl p-3 border border-slate-100">
                                <p class="text-gray-400 text-xs mb-1">Tinggi Badan</p>
                                <p id="modalTB" class="font-semibold text-gray-800 text-sm">-</p>
                            </div>
                            <div class="bg-slate-50 rounded-xl p-3 border border-slate-100">
                                <p class="text-gray-400 text-xs mb-1">Gula Darah</p>
                                <p id="modalGula" class="font-semibold text-gray-800 text-sm">-</p>
                            </div>
                            <div class="bg-slate-50 rounded-xl p-3 border border-slate-100">
                                <p class="text-gray-400 text-xs mb-1">Kolesterol</p>
                                <p id="modalKolesterol" class="font-semibold text-gray-800 text-sm">-</p>
                            </div>
                        </div>
                    </div>

                    <!-- Seksi: Gaya Hidup -->
                    <div>
                        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Gaya Hidup</p>
                        <div class="grid grid-cols-2 gap-3">
                            <div class="bg-slate-50 rounded-xl p-3 border border-slate-100">
                                <p class="text-gray-400 text-xs mb-1">Merokok</p>
                                <p id="modalMerokok" class="font-semibold text-gray-800 text-sm">-</p>
                            </div>
                            <div class="bg-slate-50 rounded-xl p-3 border border-slate-100">
                                <p class="text-gray-400 text-xs mb-1">Aktivitas Fisik</p>
                                <p id="modalAktivitas" class="font-semibold text-gray-800 text-sm">-</p>
                            </div>
                        </div>
                    </div>

                    <!-- Seksi: Tindak Lanjut -->
                    <div>
                        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Tindak Lanjut</p>
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                            <div class="bg-slate-50 rounded-xl p-3 border border-slate-100">
                                <p class="text-gray-400 text-xs mb-1">Edukasi</p>
                                <span id="modalEdukasiStatus" class="inline-block px-2 py-0.5 rounded-md text-xs font-semibold">-</span>
                            </div>
                            <div class="bg-slate-50 rounded-xl p-3 border border-slate-100">
                                <p class="text-gray-400 text-xs mb-1">Dapat Obat</p>
                                <p id="modalObat" class="font-semibold text-gray-800 text-sm">-</p>
                            </div>
                            <div class="bg-slate-50 rounded-xl p-3 border border-slate-100">
                                <p class="text-gray-400 text-xs mb-1">Dirujuk ke RS</p>
                                <span id="modalRujukan" class="inline-block px-2 py-0.5 rounded-md text-xs font-semibold">-</span>
                            </div>
                        </div>
                        <!-- Catatan Edukasi (muncul kalau ada) -->
                        <div id="modalEdukasiBox" class="hidden mt-3 bg-blue-50 rounded-xl p-3 border border-blue-100">
                            <p class="text-blue-400 text-xs mb-1 font-medium">Catatan Edukasi</p>
                            <p id="modalEdukasiCatatan" class="text-blue-800 text-sm">-</p>
                        </div>
                    </div>

                    <!-- Seksi: Validasi (muncul kalau sudah divalidasi) -->
                    <div id="seksiValidasi" class="hidden">
                        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Hasil Validasi</p>
                        <div class="grid grid-cols-2 gap-3">
                            <div class="bg-slate-50 rounded-xl p-3 border border-slate-100">
                                <p class="text-gray-400 text-xs mb-1">Tanggal Validasi</p>
                                <p id="modalTglValidasi" class="font-semibold text-gray-800 text-sm">-</p>
                            </div>
                            <div class="bg-slate-50 rounded-xl p-3 border border-slate-100 col-span-1">
                                <p class="text-gray-400 text-xs mb-1">Catatan Bidan</p>
                                <p id="modalCatatanBidan" class="text-gray-700 text-sm">-</p>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Footer Modal -->
                <div class="px-6 py-4 border-t border-gray-100 flex justify-end bg-gray-50 rounded-b-2xl shrink-0">
                    <button onclick="closeDetailModal()" class="px-5 py-2.5 bg-[#2563EB] hover:bg-[#1D4ED8] text-white text-sm font-medium rounded-xl transition-all shadow-sm">
                        Tutup
                    </button>
                </div>
            </div>
        </div>

    </div>

    <script>
        // === SERVER-SIDE SEARCH & FILTER ===
        const searchInput  = document.getElementById('searchInput');
        const statusFilter = document.getElementById('statusFilter');

        function goToServer() {
            const q      = searchInput.value.trim();
            const status = statusFilter.value;
            window.location.href =
                '/riwayat?search=' + encodeURIComponent(q) +
                '&status='  + encodeURIComponent(status) +
                '&page=1';
        }

        // Debounce search — kirim ke server 500ms setelah berhenti mengetik
        let debounceTimer;
        searchInput.addEventListener('input', function () {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(goToServer, 500);
        });

        // Filter status langsung redirect
        statusFilter.addEventListener('change', goToServer);

        // Event listener untuk tombol lihat — baca dari data-* attribute
        document.addEventListener('click', function(e) {
            const btn = e.target.closest('.btn-lihat');
            if (!btn) return;
            const d = {
                nama:       btn.dataset.nama,
                nik:        btn.dataset.nik,
                tanggal:    btn.dataset.tanggal,
                sistole:    btn.dataset.sistole,
                diastole:   btn.dataset.diastole,
                bb:         btn.dataset.bb,
                tb:         btn.dataset.tb,
                gula:       btn.dataset.gula,
                kolesterol: btn.dataset.kolesterol,
                merokok:    btn.dataset.merokok,
                aktivitas:  btn.dataset.aktivitas,
                edukasi:    btn.dataset.edukasi,
                dapat_obat: btn.dataset.dapatObat,
                rujukan:    btn.dataset.rujukan,
                kategori:   btn.dataset.kategori,
                status:     btn.dataset.status,
                catatan:    btn.dataset.catatan,
                tgl_validasi: btn.dataset.tglValidasi
            };
            openDetailModal(d);
        });

        function openDetailModal(d) {
            // Identitas
            document.getElementById('modalNama').innerText = d.nama;
            document.getElementById('modalNik').innerText  = d.nik;
            const words = d.nama.trim().split(' ');
            document.getElementById('modalInisial').innerText =
                (words.length >= 2 ? words[0][0] + words[1][0] : d.nama.substring(0,2)).toUpperCase();

            // Status badge
            const badge = document.getElementById('modalStatusBadge');
            if (d.status === 'Valid') {
                badge.className = 'ml-auto shrink-0 px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-700';
                badge.innerText = 'Valid';
            } else if (d.status === 'Perlu Revisi') {
                badge.className = 'ml-auto shrink-0 px-3 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-600';
                badge.innerText = 'Perlu Revisi';
            } else {
                badge.className = 'ml-auto shrink-0 px-3 py-1 rounded-full text-xs font-semibold bg-yellow-100 text-yellow-700';
                badge.innerText = 'Menunggu Validasi';
            }

            // Pemeriksaan
            document.getElementById('modalTanggal').innerText = d.tanggal;
            document.getElementById('modalTensi').innerText   = d.sistole + ' / ' + d.diastole;

            const kat = document.getElementById('modalKategori');
            kat.innerText = d.kategori || 'Terkendali';
            kat.className = d.kategori === 'Tidak Terkendali'
                ? 'inline-block px-2 py-0.5 rounded-md text-xs font-semibold bg-red-100 text-red-600'
                : 'inline-block px-2 py-0.5 rounded-md text-xs font-semibold bg-yellow-100 text-yellow-700';

            // Data Fisik
            document.getElementById('modalBB').innerText       = d.bb && d.bb !== 'null' ? d.bb + ' kg' : '-';
            document.getElementById('modalTB').innerText       = d.tb && d.tb !== 'null' ? d.tb + ' cm' : '-';
            document.getElementById('modalGula').innerText     = d.gula && d.gula !== 'null' ? d.gula + ' mg/dL' : '-';
            document.getElementById('modalKolesterol').innerText = d.kolesterol && d.kolesterol !== 'null' ? d.kolesterol + ' mg/dL' : '-';

            // Gaya Hidup
            document.getElementById('modalMerokok').innerText   = d.merokok || '-';
            document.getElementById('modalAktivitas').innerText = d.aktivitas || '-';

            // Edukasi
            const eduStatus = document.getElementById('modalEdukasiStatus');
            const eduBox    = document.getElementById('modalEdukasiBox');
            if (d.edukasi && d.edukasi.trim() !== '') {
                eduStatus.innerText   = 'Ada';
                eduStatus.className   = 'inline-block px-2 py-0.5 rounded-md text-xs font-semibold bg-green-100 text-green-700';
                eduBox.classList.remove('hidden');
                document.getElementById('modalEdukasiCatatan').innerText = d.edukasi;
            } else {
                eduStatus.innerText   = 'Tidak';
                eduStatus.className   = 'inline-block px-2 py-0.5 rounded-md text-xs font-semibold bg-gray-100 text-gray-500';
                eduBox.classList.add('hidden');
            }

            // Dapat Obat
            const obatMap = {
                'tidak':           'Tidak',
                'beli_sendiri':    'Beli Sendiri',
                'dari_puskesmas':  'Dari Puskesmas',
                'dari_rumah_sakit':'Dari Rumah Sakit'
            };
            document.getElementById('modalObat').innerText = obatMap[d.dapat_obat] || 'Tidak';

            // Rujukan
            const rujEl = document.getElementById('modalRujukan');
            if (d.rujukan === 'iya') {
                rujEl.innerText   = 'Iya — Dirujuk ke RS';
                rujEl.className   = 'inline-block px-2 py-0.5 rounded-md text-xs font-semibold bg-orange-100 text-orange-600';
            } else {
                rujEl.innerText   = 'Tidak';
                rujEl.className   = 'inline-block px-2 py-0.5 rounded-md text-xs font-semibold bg-gray-100 text-gray-500';
            }

            // Seksi Validasi (hanya muncul kalau sudah divalidasi)
            const seksiVal = document.getElementById('seksiValidasi');
            if (d.status === 'Valid' || d.status === 'Perlu Revisi') {
                seksiVal.classList.remove('hidden');
                document.getElementById('modalTglValidasi').innerText   = d.tgl_validasi || '-';
                document.getElementById('modalCatatanBidan').innerText  = d.catatan && d.catatan.trim() !== '' ? d.catatan : 'Tidak ada catatan';
            } else {
                seksiVal.classList.add('hidden');
            }

            const modal = document.getElementById('detailModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeDetailModal() {
            const modal = document.getElementById('detailModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    </script>

<%- include('../partials/profil') %>

</body>
</html>
