<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard PTM</title>
    <link rel="stylesheet" href="/css/output.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        .font-poppins { font-family: 'Poppins', sans-serif; }
        .font-inter { font-family: 'Inter', sans-serif; }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-slate-50 font-inter antialiased text-slate-800 flex h-screen overflow-hidden">
    
    <%- include('../partials/sidebar', { active: 'dashboard', role: 'ptm' }) %>

    <div class="flex-1 flex flex-col h-screen overflow-y-auto relative">
       <%- include('../partials/header', { pageTitle: 'Dashboard Program PTM', role: 'ptm' }) %>

        <main class="p-8 space-y-6 w-full">
            
            <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl p-6 border border-blue-100 shadow-sm">
                <h3 class="text-[#1E3A8A] font-poppins font-semibold flex items-center gap-2 mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                    Insight & Rekomendasi Perencanaan
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="bg-white/90 backdrop-blur-sm rounded-xl p-4 flex gap-3 shadow-sm border border-blue-50">
                        <div class="text-blue-500 mt-0.5 flex-shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-gray-800">Evaluasi Target Skrining Tahunan</p>
                            <p class="text-xs text-gray-600 mt-1 leading-relaxed">
                                Target 2.000 pasien telah tercapai 81% (1.615 pasien). Sisa target 385 pasien. Laju bulanan saat ini <span class="font-bold text-green-600 bg-green-100 px-1.5 py-0.5 rounded">SANGAT AMAN</span> untuk mencapai target akhir tahun sebelum tenggat waktu.
                            </p>
                        </div>
                    </div>
                    <div class="bg-white/90 backdrop-blur-sm rounded-xl p-4 flex gap-3 shadow-sm border border-blue-50">
                        <div class="text-amber-500 mt-0.5 flex-shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/></svg>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-gray-800">Prioritas Wilayah Bulan Depan</p>
                            <p class="text-xs text-gray-600 mt-1 leading-relaxed">
                                Nagari <strong class="text-gray-800">Sg. Tarab</strong> menyumbang kasus Hipertensi tertinggi (165 kasus). <strong class="text-[#2563EB]">Rekomendasi Tindakan:</strong> Jadwalkan penyuluhan masif dan alokasikan tambahan kit Posbindu ke wilayah ini untuk bulan Februari.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex items-start justify-between mt-2">
                <div>
                    <h2 class="text-[#1F2937] font-poppins font-semibold text-xl">Dashboard Program PTM</h2>
                    <p class="text-[#6B7280] text-sm mt-1">Periode Januari 2025 · Puskesmas Sungai Tarab</p>
                </div>
                <a href="/ptm/laporan" class="bg-[#2563EB] hover:bg-[#1D4ED8] text-white px-5 py-2.5 rounded-xl text-sm transition-all font-medium shadow-sm flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                    Generate Laporan
                </a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 flex flex-col justify-between">
                    <div class="flex justify-between items-start mb-4">
                        <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        </div>
                    </div>
                    <div>
                        <p class="text-3xl font-poppins font-bold text-gray-800">1.615</p>
                        <p class="text-gray-500 text-xs font-medium mt-1">Total Pasien Skrining <span class="text-gray-400 font-normal ml-1">Target: 2.000</span></p>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 flex flex-col justify-between">
                    <div class="flex justify-between items-start mb-4">
                        <div class="w-10 h-10 rounded-xl bg-green-100 text-green-600 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                        </div>
                        <span class="px-2 py-1 bg-green-50 text-green-600 text-[10px] font-semibold rounded-md border border-green-200">On Track</span>
                    </div>
                    <div>
                        <p class="text-3xl font-poppins font-bold text-gray-800">81%</p>
                        <p class="text-gray-500 text-xs font-medium mt-1">Capaian Target</p>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 flex flex-col justify-between">
                    <div class="flex justify-between items-start mb-4">
                        <div class="w-10 h-10 rounded-xl bg-red-100 text-red-600 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                        </div>
                    </div>
                    <div>
                        <p class="text-3xl font-poppins font-bold text-gray-800">618</p>
                        <p class="text-gray-500 text-xs font-medium mt-1">Kasus Hipertensi <span class="text-gray-400 font-normal ml-1">39.1% dari total</span></p>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 flex flex-col justify-between">
                    <div class="flex justify-between items-start mb-4">
                        <div class="w-10 h-10 rounded-xl bg-green-100 text-green-600 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
                        </div>
                        <span class="px-2 py-1 bg-green-50 text-green-600 text-[10px] font-semibold rounded-md">+2.3%</span>
                    </div>
                    <div>
                        <p class="text-3xl font-poppins font-bold text-gray-800">71.8%</p>
                        <p class="text-gray-500 text-xs font-medium mt-1">Tekanan Terkendali</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-[#1F2937] font-poppins font-semibold">Capaian Target 2.000 Pasien</h3>
                    <span class="text-[#2563EB] text-sm font-semibold">1.615/2.000</span>
                </div>
                <div class="h-4 bg-gray-100 rounded-full overflow-hidden mb-3">
                    <div class="h-full rounded-full bg-gradient-to-r from-[#2563EB] to-[#10B981] transition-all" style="width: 81%;"></div>
                </div>
                <div class="flex justify-between text-xs text-[#6B7280]">
                    <span>0</span>
                    <span class="font-semibold text-[#10B981]">81% tercapai</span>
                    <span>2.000</span>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm">
                    <h3 class="text-[#1F2937] font-poppins font-semibold mb-6">Capaian per Nagari</h3>
                    <div class="w-full h-[250px]">
                        <canvas id="nagariChart"></canvas>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden flex flex-col">
                    <div class="px-6 py-5 border-b border-gray-100">
                        <h3 class="text-[#1F2937] font-poppins font-semibold">Rincian per Nagari</h3>
                    </div>
                    <div class="overflow-x-auto flex-1">
                        <table class="w-full h-full">
                            <thead>
                                <tr class="bg-[#F8FAFC] border-b border-gray-100">
                                    <th class="text-left px-5 py-3 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Nagari</th>
                                    <th class="text-center px-5 py-3 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Capaian</th>
                                    <th class="text-center px-5 py-3 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Target</th>
                                    <th class="text-center px-5 py-3 text-xs text-[#6B7280] uppercase tracking-wider font-medium">%</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-50">
                                <tr class="hover:bg-gray-50">
                                    <td class="px-5 py-4 text-sm font-medium text-[#1F2937]"><div class="flex items-center gap-2"><div class="w-3 h-3 rounded-sm bg-[#2563EB]"></div>Sg. Tarab</div></td>
                                    <td class="px-5 py-4 text-sm text-center font-medium">420</td>
                                    <td class="px-5 py-4 text-sm text-center text-[#6B7280]">500</td>
                                    <td class="px-5 py-4 text-center"><span class="text-xs px-2 py-0.5 rounded-full bg-[#D1FAE5] text-[#059669] font-medium">84%</span></td>
                                </tr>
                                <tr class="hover:bg-gray-50">
                                    <td class="px-5 py-4 text-sm font-medium text-[#1F2937]"><div class="flex items-center gap-2"><div class="w-3 h-3 rounded-sm bg-[#10B981]"></div>Baringin</div></td>
                                    <td class="px-5 py-4 text-sm text-center font-medium">380</td>
                                    <td class="px-5 py-4 text-sm text-center text-[#6B7280]">450</td>
                                    <td class="px-5 py-4 text-center"><span class="text-xs px-2 py-0.5 rounded-full bg-[#D1FAE5] text-[#059669] font-medium">84%</span></td>
                                </tr>
                                <tr class="hover:bg-gray-50">
                                    <td class="px-5 py-4 text-sm font-medium text-[#1F2937]"><div class="flex items-center gap-2"><div class="w-3 h-3 rounded-sm bg-[#F59E0B]"></div>Salimpaung</div></td>
                                    <td class="px-5 py-4 text-sm text-center font-medium">310</td>
                                    <td class="px-5 py-4 text-sm text-center text-[#6B7280]">400</td>
                                    <td class="px-5 py-4 text-center"><span class="text-xs px-2 py-0.5 rounded-full bg-[#FEF3C7] text-[#D97706] font-medium">78%</span></td>
                                </tr>
                                <tr class="hover:bg-gray-50">
                                    <td class="px-5 py-4 text-sm font-medium text-[#1F2937]"><div class="flex items-center gap-2"><div class="w-3 h-3 rounded-sm bg-[#8B5CF6]"></div>Tigo Jangko</div></td>
                                    <td class="px-5 py-4 text-sm text-center font-medium">290</td>
                                    <td class="px-5 py-4 text-sm text-center text-[#6B7280]">350</td>
                                    <td class="px-5 py-4 text-center"><span class="text-xs px-2 py-0.5 rounded-full bg-[#D1FAE5] text-[#059669] font-medium">83%</span></td>
                                </tr>
                                <tr class="hover:bg-gray-50">
                                    <td class="px-5 py-4 text-sm font-medium text-[#1F2937]"><div class="flex items-center gap-2"><div class="w-3 h-3 rounded-sm bg-[#EF4444]"></div>Guguak</div></td>
                                    <td class="px-5 py-4 text-sm text-center font-medium">215</td>
                                    <td class="px-5 py-4 text-sm text-center text-[#6B7280]">300</td>
                                    <td class="px-5 py-4 text-center"><span class="text-xs px-2 py-0.5 rounded-full bg-[#FEF3C7] text-[#D97706] font-medium">72%</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            Chart.defaults.font.family = "'Inter', sans-serif";
            Chart.defaults.color = '#6B7280';

            const ctx = document.getElementById('nagariChart').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ["Sg. Tarab", "Baringin", "Salimpaung", "Tigo Jangko", "Guguak"],
                    datasets: [
                        {
                            label: 'Capaian',
                            data: [420, 380, 310, 290, 215],
                            backgroundColor: ["#2563EB", "#10B981", "#F59E0B", "#8B5CF6", "#EF4444"],
                            borderRadius: { topLeft: 6, topRight: 6 },
                            barPercentage: 0.6,
                            categoryPercentage: 0.7
                        },
                        {
                            label: 'Target',
                            data: [500, 450, 400, 350, 300],
                            backgroundColor: '#E5E7EB',
                            borderRadius: { topLeft: 6, topRight: 6 },
                            barPercentage: 0.6,
                            categoryPercentage: 0.7
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'white',
                            titleColor: '#1F2937',
                            bodyColor: '#4B5563',
                            borderColor: '#E5E7EB',
                            borderWidth: 1,
                            padding: 10,
                            usePointStyle: true,
                            titleFont: { family: "'Poppins', sans-serif" }
                        }
                    },
                    scales: {
                        x: { grid: { display: false, drawBorder: false } },
                        y: { grid: { color: '#F3F4F6', drawBorder: false, strokeDash: [3, 3] }, min: 0 }
                    }
                }
            });
        });
    </script>
</body>
</html>