                                <th class="text-center px-6 py-4 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Total Pasien</th>
                                <th class="text-center px-6 py-4 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Hipertensi</th>
                                <th class="text-center px-6 py-4 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Terkendali</th>
                                <th class="text-left px-6 py-4 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Status</th>
                                <th class="text-left px-6 py-4 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Aksi</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-50">
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4 text-sm text-[#1F2937] font-medium">Desember 2024</td>
                                <td class="px-6 py-4 text-sm text-center text-[#1F2937]">188</td>
                                <td class="px-6 py-4 text-sm text-center text-[#EF4444] font-medium">70</td>
                                <td class="px-6 py-4 text-sm text-center text-[#10B981] font-medium">71.4%</td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#D1FAE5] text-[#059669] text-xs font-semibold border border-[#A7F3D0]">
                                        <span class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span>Disahkan
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <button class="flex items-center gap-1.5 text-xs text-[#2563EB] hover:text-[#1D4ED8] font-medium transition-colors">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                                        PDF
                                    </button>
                                </td>
                            </tr>
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4 text-sm text-[#1F2937] font-medium">November 2024</td>
                                <td class="px-6 py-4 text-sm text-center text-[#1F2937]">195</td>
                                <td class="px-6 py-4 text-sm text-center text-[#EF4444] font-medium">78</td>
                                <td class="px-6 py-4 text-sm text-center text-[#10B981] font-medium">69.2%</td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#D1FAE5] text-[#059669] text-xs font-semibold border border-[#A7F3D0]">
                                        <span class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span>Disahkan
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <button class="flex items-center gap-1.5 text-xs text-[#2563EB] hover:text-[#1D4ED8] font-medium transition-colors">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                                        PDF
                                    </button>
                                </td>
                            </tr>
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4 text-sm text-[#1F2937] font-medium">Oktober 2024</td>
                                <td class="px-6 py-4 text-sm text-center text-[#1F2937]">172</td>
                                <td class="px-6 py-4 text-sm text-center text-[#EF4444] font-medium">65</td>
                                <td class="px-6 py-4 text-sm text-center text-[#10B981] font-medium">73.8%</td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#D1FAE5] text-[#059669] text-xs font-semibold border border-[#A7F3D0]">
                                        <span class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span>Disahkan
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <button class="flex items-center gap-1.5 text-xs text-[#2563EB] hover:text-[#1D4ED8] font-medium transition-colors">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                                        PDF
                                    </button>
                                </td>
                            </tr>
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4 text-sm text-[#1F2937] font-medium">September 2024</td>
                                <td class="px-6 py-4 text-sm text-center text-[#1F2937]">185</td>
                                <td class="px-6 py-4 text-sm text-center text-[#EF4444] font-medium">72</td>
                                <td class="px-6 py-4 text-sm text-center text-[#10B981] font-medium">70.1%</td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#D1FAE5] text-[#059669] text-xs font-semibold border border-[#A7F3D0]">
                                        <span class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span>Disahkan
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <button class="flex items-center gap-1.5 text-xs text-[#2563EB] hover:text-[#1D4ED8] font-medium transition-colors">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                                        PDF
                                    </button>
                                </td>
                            </tr>
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4 text-sm text-[#1F2937] font-medium">Agustus 2024</td>
                                <td class="px-6 py-4 text-sm text-center text-[#1F2937]">178</td>
                                <td class="px-6 py-4 text-sm text-center text-[#EF4444] font-medium">68</td>
                                <td class="px-6 py-4 text-sm text-center text-[#10B981] font-medium">68.9%</td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#D1FAE5] text-[#059669] text-xs font-semibold border border-[#A7F3D0]">
                                        <span class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span>Disahkan
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <button class="flex items-center gap-1.5 text-xs text-[#2563EB] hover:text-[#1D4ED8] font-medium transition-colors">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                                        PDF
                                    </button>
                                </td>
                            </tr>
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4 text-sm text-[#1F2937] font-medium">Juli 2024</td>
                                <td class="px-6 py-4 text-sm text-center text-[#1F2937]">163</td>
                                <td class="px-6 py-4 text-sm text-center text-[#EF4444] font-medium">60</td>
                                <td class="px-6 py-4 text-sm text-center text-[#10B981] font-medium">72.5%</td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#D1FAE5] text-[#059669] text-xs font-semibold border border-[#A7F3D0]">
                                        <span class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span>Disahkan
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <button class="flex items-center gap-1.5 text-xs text-[#2563EB] hover:text-[#1D4ED8] font-medium transition-colors">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                                        PDF
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
</body>
</html>