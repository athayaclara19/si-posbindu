<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rekap Periode - PJ PTM</title>
    <link rel="stylesheet" href="/css/output.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        .font-poppins { font-family: 'Poppins', sans-serif; }
        .font-inter { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 font-inter antialiased text-slate-800 flex h-screen overflow-hidden">
    
    <%- include('../partials/sidebar', { active: 'rekap', role: 'ptm' }) %>

    <div class="flex-1 flex flex-col h-screen overflow-y-auto relative">
        <%- include('../partials/header', { pageTitle: 'Rekap Periode', role: 'ptm' }) %>

        <main class="p-8 space-y-6 w-full">
            <div>
                <h2 class="text-[#1F2937] font-poppins font-semibold text-xl">
                    Rekap Periode
                </h2>
                <p class="text-[#6B7280] text-sm mt-1">Pilih periode untuk melihat atau membuat laporan</p>
            </div>

            <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm">
                <h3 class="text-[#1F2937] font-poppins font-semibold mb-4">
                    Generate Laporan Baru
                </h3>
                <form action="/ptm/laporan/generate" method="POST" class="flex flex-col sm:flex-row gap-4 items-end">
                    <div class="flex-1 w-full">
                        <label class="text-sm text-[#1F2937] font-medium mb-1.5 block">Bulan</label>
                        <div class="relative">
                            <select name="periode_bulan" id="selectBulanGenerate"
                                class="w-full pl-4 pr-10 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-gray-50">
                                <option value="1">Januari</option>
                                <option value="2">Februari</option>
                                <option value="3">Maret</option>
                                <option value="4">April</option>
                                <option value="5">Mei</option>
                                <option value="6">Juni</option>
                                <option value="7">Juli</option>
                                <option value="8">Agustus</option>
                                <option value="9">September</option>
                                <option value="10">Oktober</option>
                                <option value="11">November</option>
                                <option value="12">Desember</option>
                            </select>
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none"><path d="m6 9 6 6 6-6"/></svg>
                        </div>
                    </div>
                    <div class="flex-1 w-full">
                        <label class="text-sm text-[#1F2937] font-medium mb-1.5 block">Tahun</label>
                        <div class="relative">
                            <select name="periode_tahun" class="w-full pl-4 pr-10 py-2.5 rounded-xl border border-gray-200 text-sm outline-none focus:border-[#2563EB] bg-gray-50 hover:bg-white transition-colors appearance-none cursor-pointer">
                                <% 
                                    // Membuat opsi tahun otomatis dari tahun ini mundur ke 2023
                                    const tahunSekarang = new Date().getFullYear();
                                    const bulanSekarang = new Date().getMonth() + 1; // 1-12
                                    // Mulai dari tahun sekarang (tidak ada tahun depan)
                                    for(let t = tahunSekarang; t >= 2023; t--) {
                                %>
                                    <option value="<%= t %>" <%= t === tahunSekarang ? 'selected' : '' %>><%= t %></option>
                                <% } %>
                            </select>
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none"><path d="m6 9 6 6 6-6"/></svg>
                        </div>
                    </div>
                    <button type="submit" class="w-full sm:w-auto flex items-center justify-center gap-2 bg-[#2563EB] hover:bg-[#1D4ED8] text-white px-6 py-2.5 rounded-xl text-sm transition-all font-medium whitespace-nowrap shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
                        Generate Laporan
                    </button>
                </form>
            </div>

            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
                <div class="px-6 py-5 border-b border-gray-100">
                    <h3 class="text-[#1F2937] font-poppins font-semibold">
                        Riwayat Laporan
                    </h3>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead>
                            <tr class="bg-[#F8FAFC] border-b border-gray-100">
                                <th class="text-left px-6 py-4 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Periode</th>
                                <th class="text-center px-6 py-4 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Total Pasien</th>
                                <th class="text-center px-6 py-4 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Hipertensi</th>
                                <th class="text-center px-6 py-4 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Terkendali</th>
                                <th class="text-left px-6 py-4 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Status</th>
                                <th class="text-left px-6 py-4 text-xs text-[#6B7280] uppercase tracking-wider font-medium">Aksi</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-50">
                            <% if (typeof rekapData !== 'undefined' && rekapData.length > 0) { %>
                                <% const namaBulan = ["", "Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"]; %>
                                <% rekapData.forEach(row => { %>
                                    <tr class="hover:bg-gray-50 transition-colors">
                                        <td class="px-6 py-4 text-sm text-[#1F2937] font-medium">
                                            <%= namaBulan[row.periode_bulan] %> <%= row.periode_tahun %>
                                        </td>
                                        <td class="px-6 py-4 text-sm text-center text-[#1F2937]">
                                            <%= row.total_pasien_diperiksa %> Pasien
                                        </td>
                                        <td class="px-6 py-4 text-sm text-center text-[#EF4444] font-medium">
                                            <%= row.total_kunjungan %> Total Kunjungan
                                        </td>
                                        <td class="px-6 py-4 text-sm text-center text-[#10B981] font-medium">
                                            -
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#E0F2FE] text-[#0369A1] text-xs font-semibold border border-[#BAE6FD]">
                                                <span class="w-1.5 h-1.5 rounded-full bg-[#0EA5E9]"></span>Terekap
                                            </span>
                                        </td>
                                        <td class="px-6 py-4">
                                            <button class="flex items-center gap-1.5 text-xs text-[#2563EB] hover:text-[#1D4ED8] font-medium transition-colors cursor-not-allowed opacity-50" title="Fitur PDF akan segera hadir">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                                                PDF
                                            </button>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="px-6 py-8 text-center text-gray-500 text-sm">Belum ada data rekapitulasi skrining yang terverifikasi.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <script>
    document.querySelector('form[action="/ptm/laporan/generate"]').addEventListener('submit', function(e) {
    const bulan = parseInt(document.getElementById('selectBulanGenerate').value);
    const tahun = parseInt(document.querySelector('select[name="periode_tahun"]').value);
    const now = new Date();
    const bulanSkrg = now.getMonth() + 1;
    const tahunSkrg = now.getFullYear();

    // Cegah generate untuk periode masa depan
    if (tahun > tahunSkrg || (tahun === tahunSkrg && bulan > bulanSkrg)) {
        e.preventDefault();
        Swal.fire({
        icon: 'warning',
        title: 'Periode Tidak Valid',
        text: 'Tidak bisa generate laporan untuk bulan yang belum terjadi.',
        confirmButtonColor: '#2563EB'
        });
        return;
    }
    });
    </script>

<%- include('../partials/profil') %>

</body>
</html>